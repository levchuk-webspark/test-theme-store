    "landing_common_questions_F3nyPT": {
      "type": "landing__common-questions",
      "blocks": {
        "question_dJncjm": {
          "type": "question",
          "settings": {
            "title": "Is it safe?",
            "answer": "Yes! Every batch of our NMN is third-party tested for purity, potency, and heavy metals to ensure you’re getting exactly what’s on the label, and nothing else. NMN (β-Nicotinamide Mononucleotide) is a naturally occurring molecule found in all living cells and has been widely studied for its role in cellular energy and healthy ageing. If you have a medical condition or take prescription medication, we always recommend consulting a healthcare professional before starting any new supplement."
          }
        },
        "question_FRdQ4w": {
          "type": "question",
          "settings": {
            "title": "Capsules or powder?",
            "answer": "Our NMN powder, taken sublingually under your tongue, goes directly into your bloodstream and starts to work immediately. Our NMN capsules are just as effective, but they have to reach your stomach first before they start working. Both contain the same high-quality NMN, the choice simply depends on your routine. Capsules are best for convenience and consistent daily dosing, powder offers more flexibility, allowing you to adjust your dosage. Either way, you’re supporting your NAD⁺ levels with pure, bioavailable NMN."
          }
        },
        "question_hRG3YG": {
          "type": "question",
          "settings": {
            "title": "Will I feel it?",
            "answer": "Whilst some people notice an instant boost in energy, others notice steadier energy, clearer focus, and improved mood within the first few weeks. And for others, the effects are more subtle, working quietly at the cellular level to support mitochondrial function, DNA repair, and resilience over time. Think of it as a long-term investment in your biological energy, not an instant stimulant."
          }
        },
        "question_eFXE4R": {
          "type": "question",
          "settings": {
            "title": "When should I take it?",
            "answer": "We recommend taking NMN first thing in the morning on an empty stomach. This timing helps align with your body’s natural circadian rhythm and NAD⁺ production, which peaks earlier in the day, supporting consistent daytime energy and focus. We find that NMN delivers best results when consumed on an empty stomach, so we recommend to wait for at least 20–30 minutes before consuming any food or coffee/tea."
          }
        },
        "question_4px8g8": {
          "type": "question",
          "settings": {
            "title": "Can I stack it?",
            "answer": "Yes, but start simple. Take NMN on its own for 2–4 weeks to let your body adjust and to notice how it feels. Once you’ve established a baseline, you can stack it with other NAD⁺-supporting or longevity nutrients such as Resveratrol, Glutathione, or Spermidine for a more comprehensive protocol."
          }
        }
      },
