    "72a78264-5af2-4196-a9ae-4aeef2be902a": {
      "type": "custom-grid",
      "custom_css": [],
      "settings": {
        "link_1": "",
        "text_1": "<span>WHAT</span> <span>ON</span> <span>EARTH</span>  <span>IS NAD?</span>",
        "background_color_1": "",
        "text_color_1": "#3f4444",
        "link_2": "",
        "text_2": "Boost your NAD+ levels",
        "icon_2": "shopify://shop_images/Arrow-black-up.png",
        "background_color_2": "#78be20",
        "text_color_2": "#404544",
        "link_3": "",
        "text_3": "It drops by 50% by age of 50",
        "background_color_3": "#3f4444",
        "text_color_3": "#ffffff",
        "image_4": "shopify://shop_images/Group_313581.png",
        "link_4": "",
        "image_5": "shopify://shop_images/Mask_group_2_0c9b3f50-037a-41a2-abc2-c5e4ecf28a88.png",
        "link_5": "",
        "link_6": "",
        "text_6": "In a world of anti-ageing, we’re pro-ageing.",
        "icon_6": "shopify://shop_images/Our-mission-small-smile-black.png",
        "background_color_6": "",
        "text_color_6": "",
        "link_7": "",
        "text_7": "We provide you with supplements that are oozing with natural\ningredients that enhance your energy levels on a cellular level.",
        "icon_7": "shopify://shop_images/Vector_9eae237e-ed0a-495b-a3a0-9f870f5b98eb.svg",
        "background_color_7": "#44693d",
        "text_color_7": "#f7f5f1",
        "link_8": "https://youthandearth.com/pages/reviews",
        "text_8": "Hear from our customers.",
        "icon_8": "shopify://shop_images/Heart-black-small.png",
        "background_color_8": "",
        "text_color_8": "#3f4444",
        "image_9": "shopify://shop_images/Mask_group_3_9141198b-9358-49cb-a8d5-56a4911858bd.png",
        "link_9": "https://youthandearth.com/pages/reviews",
        "text_9": "<span class=\"ambit-black-text\">Excellent Service, Excellent Products<br>\n<span class=\"romie-regular-italic-text\">Heather Soper\n</span> <span class=\"ambit-black-text\">.</span></span>",
        "text_9_add": "",
        "background_color_9": "#284734",
        "text_color_9": "#78be20",
        "text": "NAD+ is the natural fuel every cell uses to function like a well-oiled machine. It’s a critical co-enzyme found in every cell in your body that’s involved in hundreds of metabolic processes like cellular energy and mitochondrial health.\n<br><br>\nBut, our NAD+ levels drop as much as 50% by the time we are 50, and at 60 they have fallen off a cliff-making it harder to produce the energy we need to maintain great health.",
        "button_label": "Shop products",
        "link": "shopify://collections/shop-all",
        "width": "standard"
      }
    },
