    "our_mission_longevity_p7aTeH": {
      "type": "our-mission__longevity",
      "settings": {
        "title": "<span class=\"ambit-black-text\">Youth &amp; Earth:</span> <br><span class=\"romie-regular-italic-text\">Organically Fueling Your Longevity</span>",
        "title_font_size": 60,
        "description": "The year is 2017, and our founder, Ed, embarks on a quest for everlasting\nyouthfulness. Battling waning energy levels and the march of time, Ed\nrefuses to settle for anything less than boundless vitality. Frustrated by a\nsea of conflicting advice and ineffective remedies, he takes matters into\nhis own hands. In his quest for answers, he unearths two revolutionary\ntruths: the dwindling levels of NAD+ in his body and the remarkable\nbenefits of NMN.<!-- split -->\n<br><br>\nFast forward to today, we want to revolutionize your approach to\nageing. Our NMN capsules, alongside a curated selection of essential\nsupplements, are not just products – they are catalysts for unlocking your\nfull potential. No matter how many years you've been on this Earth, we are\nhere to fuel your journey towards peak performance, looking youthful and\noverall unwavering vitality. We celebrate the potential opportunities for\ngrowth and transformation. Embracing the beauty of ageing, we arm you\nwith the knowledge and support needed to navigate your personal journey\nthrough life. Our ethos is simple: ageing is not entirely out of your control.\n<br><br>\n<span style=\"font-weight:bold;\">Together, let's rewrite the script of longevity and unveil a future \nwhereeach passing year brings newfound vigour and vibrancy!<span></span></span>",
        "description_font_size": 25,
        "image_1": "shopify://shop_images/Edward_photo.png",
        "image_alignment_1": "right",
        "image-width_1": 295,
        "image_2": "shopify://shop_images/Vector_a8ac0896-ffe0-44e7-9de5-1e5b52018ddd.svg",
        "image_alignment_2": "right",
        "image-width_2": 295,
        "padding_top": 30,
        "padding_bottom": 30,
        "background_color": "#284734",
