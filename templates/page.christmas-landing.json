    "landing_why_it_works_DgABif": {
      "type": "landing__why-it-works",
      "blocks": {
        "info_LLgM3X": {
          "type": "info",
          "settings": {
            "img": "shopify://shop_images/why-it-works_3.jpg",
            "title": "NMN Capsules - Cellular energy and repair activator",
            "text": "NMN boosts NAD+ levels, the molecule that cells need for energy production, DNA repair, and healthy ageing. Higher NAD+ means mitochondria (cells’ energy engines) work more efficiently, setting the stage for better repair, resilience, and vitality."
          }
        },
        "info_PRqX98": {
          "type": "info",
          "settings": {
            "img": "shopify://shop_images/why-it-works_4.jpg",
            "title": "Liposomal Spermidine - Autophagy trigger",
            "text": "Spermidine activates autophagy, your body’s natural cellular “clean-up” and renewal process. Spermidine helps remove damaged components so healthier, more efficient cells can thrive.That means cleaner, more youthful cells that respond even better to NMN’s energy boost."
          }
        },
        "info_yEadjx": {
          "type": "info",
          "settings": {
            "img": "shopify://shop_images/why-it-works_5.jpg",
            "title": "Liposomal Curcumin - Inflammation calmer",
            "text": "Curcumin is one of nature’s most potent anti-inflammatory compounds. It helps calm chronic inflammation - a major driver of ageing - and protects cells from oxidative stress. By reducing inflammation, curcumin creates an optimal environment for NMN and spermidine to do their work."
          }
        }
      },
