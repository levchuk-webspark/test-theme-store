   <!-- Rebuy Smart Cart: open-on-demand + direct /cart handling -->
<script>
(function () {
  var MAX_RETRIES = 60;
  var INTERVAL_MS = 250;
  var retries = 0;
  var openRequested = false;
  var ROOT_URL = {{ routes.root_url | json }};
  var LAST_NONCART_KEY = 'ya_last_non_cart_url';
  var REBUY_SCRIPT_SRC = {{ 'https://cdn.rebuyengine.com/onsite/js/rebuy.js?shop=' | append: shop.permanent_domain | json }};
  var rebuyLoaderInjected = false;

  function isSmartCartReady() {
    return !!(window.Rebuy && window.Rebuy.SmartCart && typeof window.Rebuy.SmartCart.show === 'function');
  }

  function ensureRebuyScriptLoaded() {
    if (isSmartCartReady() || rebuyLoaderInjected) {
      return;
    }

    var existingLoader = document.querySelector('script[data-rebuy-loader="true"]');
    if (existingLoader) {
      rebuyLoaderInjected = true;
      return;
    }

    var lazyScript = document.querySelector('script[type="lazyload_js"][data-src*="rebuyengine.com/onsite/js/rebuy.js"]');
    var src = REBUY_SCRIPT_SRC;

    if (lazyScript) {
      src = lazyScript.getAttribute('data-src') || lazyScript.getAttribute('src') || src;
      lazyScript.setAttribute('data-rebuy-loader-consumed', 'true');
      lazyScript.removeAttribute('data-src');
    }

    var scriptEl = document.createElement('script');
    scriptEl.src = src;
    scriptEl.defer = true;
    scriptEl.async = true;
    scriptEl.dataset.rebuyLoader = 'true';
    scriptEl.onload = function () {
      rebuyLoaderInjected = true;
    };
    scriptEl.onerror = function () {
      rebuyLoaderInjected = false;
    };
    document.head.appendChild(scriptEl);
  }

  var spinner = document.createElement('div');
  spinner.className = 'loader';
  function safeRemoveSpinner() {
    try {
      if (spinner && spinner.parentNode) {
        spinner.parentNode.removeChild(spinner);
      }
    } catch (_) {}
  }
  function openSmartCartNow() {
    try {
      window.Rebuy.SmartCart.show();
    } catch (_) {
      // swallow
    } finally {
      openRequested = false;
      // document.body.classList.remove('rebuy-smartcart-loading');
      // safeRemoveSpinner();
    }
  }

  function openSmartCartWhenReady() {
    if (openRequested) return;
    openRequested = true;

    if (isSmartCartReady()) {
      openSmartCartNow();
      return;
    }

    // Ensure script is loading before we start polling
    ensureRebuyScriptLoaded();

    var onReady = function () {
      document.removeEventListener('rebuy:smartcart.ready', onReady);
      openSmartCartNow();
    };
    document.addEventListener('rebuy:smartcart.ready', onReady, { once: true });

    (function poll() {
      if (isSmartCartReady()) {
        openSmartCartNow();
        return;
      }
      if (retries++ >= MAX_RETRIES) return;
      setTimeout(poll, INTERVAL_MS);
    })();
  }

  function rememberNonCart() {
    try {
      if (!/\/cart(\/|$)/.test(location.pathname)) {
        sessionStorage.setItem(LAST_NONCART_KEY, location.href);
      }
    } catch (_) {}
  }

  function buildViewcartUrl(urlOverride) {
    try {
      var targetUrl = urlOverride ? new URL(urlOverride, location.origin) : new URL(location.href);
      targetUrl.searchParams.set('viewcart', 'true');
      return targetUrl.toString();
    } catch (_) {
      var base = urlOverride || (location.pathname + (location.search || ''));
      if (typeof base !== 'string') base = location.pathname || '/';
      if (base.indexOf('viewcart=') !== -1) return base;
      var separator = base.indexOf('?') === -1 ? '?' : '&';
      return base + separator + 'viewcart=true';
    }
  }

  function markViewcartIntent(urlOverride) {
    var viewcartUrl = buildViewcartUrl(urlOverride);
    try {
      history.replaceState({}, '', viewcartUrl);
    } catch (_) {}
    return viewcartUrl;
  }

  function invokeSmartCart(options) {
    options = options || {};
    if (options.redirectTo) {
      var destinationUrl = buildViewcartUrl(options.redirectTo);
      if (options.history === 'replace') {
        location.replace(destinationUrl);
      } else {
        location.assign(destinationUrl);
      }
      return;
    }
    if (options.redirect === 'home') {
      var destination = buildViewcartUrl(ROOT_URL);
      if (options.history === 'replace') {
        location.replace(destination);
      } else {
        location.assign(destination);
      }
      return;
    }

    markViewcartIntent(options.urlOverride);
    // document.body.classList.add('rebuy-smartcart-loading');
    // document.body.appendChild(spinner);
    
    // Sync cart state before opening (fire-and-forget)
    try {
      fetch('/cart.js?sync=' + Date.now(), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
        .catch(function(){ /* swallow */ });
    } catch (_) {}
    
    openSmartCartWhenReady();
  }

  document.addEventListener('rebuy:smartcart.init', function () {
    openSmartCartWhenReady();
  }, { once: true });

  document.addEventListener('click', function (e) {
    var trigger = e.target.closest('a[href*="/cart"], [data-cart-toggle], [data-action="open-cart"], .header__cart, .site-header__cart, .js-cart-toggle, [data-open-smartcart]');
    if (!trigger) return;

    var isAnchor = trigger.tagName === 'A';
    var forceSmartCart = trigger.hasAttribute('data-open-smartcart');
    var redirectAttr = (trigger.getAttribute('data-smartcart-redirect') || '').toLowerCase();
    var redirectHome = redirectAttr === 'home';
    var targetUrl = null;

    if (isAnchor) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;

      var shouldIntercept = forceSmartCart;

      if (!shouldIntercept) {
        try {
          targetUrl = new URL(trigger.href, location.origin);
          var normalizedPath = targetUrl.pathname.replace(/\/+$/, '');
          if (normalizedPath === '/cart') {
            shouldIntercept = true;
          }
          if (!shouldIntercept && targetUrl.searchParams) {
            var viewcartParam = targetUrl.searchParams.get('viewcart');
            if (viewcartParam && viewcartParam.toLowerCase() === 'true') {
              shouldIntercept = true;
            }
          }
        } catch (_) {
          console.log('Rebuy Smart Cart: failed to parse cart URL, falling back to default behavior');
        }
      }

      if (shouldIntercept) {
        e.preventDefault();
        if (redirectHome) {
          invokeSmartCart({ redirect: 'home' });
        } else if (targetUrl) {
          invokeSmartCart({ urlOverride: targetUrl.href });
        } else {
          invokeSmartCart();
        }
        return;
      }
    } else {
      e.preventDefault();
      if (redirectHome) {
        invokeSmartCart({ redirect: 'home' });
      } else {
        invokeSmartCart();
      }
    }
  }, { passive: false, capture: true });

  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form) return;

    var action = form.getAttribute('action') || '';
    var redirectAttr = (form.getAttribute('data-smartcart-redirect') || '').toLowerCase();
    var redirectHome = redirectAttr === 'home';
    var forceSmartCart = form.hasAttribute('data-open-smartcart');
    var submitter = e.submitter || null;
    if (submitter) {
      if (submitter.hasAttribute('data-open-smartcart')) {
        forceSmartCart = true;
      }
      var submitterRedirect = submitter.getAttribute('data-smartcart-redirect');
      if (submitterRedirect) {
        redirectAttr = submitterRedirect.toLowerCase();
        redirectHome = redirectAttr === 'home';
      }
      if (submitter.hasAttribute('formaction')) {
        action = submitter.getAttribute('formaction');
      }
    }

    // Intercept product form submissions that would redirect to /cart
    var isProductForm = form.hasAttribute('data-product-form');
    try {
      var returnTo = form.querySelector('input[name="return_to"]');
      if (isProductForm && returnTo && /\/cart\b/.test(returnTo.value || '')) {
        e.preventDefault();
        var fd = new FormData(form);
        if (submitter && submitter.name) fd.append(submitter.name, submitter.value || '');

        var canUseRebuy = false;
        try { canUseRebuy = !!(window.Rebuy && window.Rebuy.Cart && typeof window.Rebuy.Cart.addLineItem === 'function'); } catch(_) { canUseRebuy = false; }

        if (canUseRebuy) {
          (function(){
            var data = {};
            fd.forEach(function(v,k){
              if (k.endsWith('[]')) {
                var kk = k.slice(0,-2); data[kk] = data[kk] || []; data[kk].push(v);
              } else {
                data[k] = v;
              }
            });
            var item = { id: Number(data.id), quantity: Number(data.quantity || 1) };
            if (data.selling_plan) item.selling_plan = Number(data.selling_plan);
            var props = {};
            Object.keys(data).forEach(function(key){
              var m = key.match(/^properties\[(.*)\]$/);
              if (m) props[m[1]] = data[key];
            });
            if (Object.keys(props).length) item.properties = props;

            return window.Rebuy.Cart.addLineItem(item).then(function () {
              invokeSmartCart();
            })
            .catch(function (err) {
              console.error('Rebuy add failed', err);
              invokeSmartCart();
            });

          })();
          return;
        } else {
          fetch('/cart/add.js', {
            method: 'POST',
            body: fd,
            headers: { 'Accept': 'application/json' }
          })
          .then(function(res){ return res.ok ? res.json() : res.json().then(function(j){ throw j; }); })
          .then(function(){ invokeSmartCart(); })
          .catch(function(){ invokeSmartCart(); });
          return;
        }
      }
    } catch (_) {}

    var shouldIntercept = forceSmartCart;

    if (!shouldIntercept && action) {
      try {
        var actionUrl = new URL(action, location.origin);
        var normalizedAction = actionUrl.pathname.replace(/\/+$/, '');
        if (normalizedAction === '/cart') {
          shouldIntercept = true;
        }
      } catch (_) {}
    }

    if (shouldIntercept) {
      e.preventDefault();
      if (redirectHome) {
        invokeSmartCart({ redirect: 'home' });
      } else {
        invokeSmartCart();
      }
    }
  }, true);

  function handleDirectCartLanding() {
    try {
      var path = window.location.pathname;
      if (path.endsWith('/cart') || path === '/cart') {
        var back = null;
        try { back = sessionStorage.getItem(LAST_NONCART_KEY); } catch (_e) {}
        if (!back) {
          var ref = document.referrer;
          try {
            var refUrl = new URL(ref);
            if (refUrl.origin === location.origin && !/\/cart(\/|$)/.test(refUrl.pathname)) back = refUrl.href;
          } catch (_ignore) {}
        } 
        if (!back) back = ROOT_URL;
        invokeSmartCart({ redirectTo: back, history: 'replace' });
        return;
      }
    } catch (_) {}
  }

  function handleViewcartQuery() {
    try {
      var url = new URL(location.href);
      if (url.searchParams.get('viewcart') === 'true') {
        // document.body.classList.add('rebuy-smartcart-loading');
        // document.body.appendChild(spinner);
        
        openSmartCartWhenReady();
      }
    } catch (_) {}
  }

  rememberNonCart();
  try { window.invokeSmartCart = invokeSmartCart; } catch (_) {}
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    handleDirectCartLanding();
    handleViewcartQuery();
  } else {
    window.addEventListener('DOMContentLoaded', function () {
      rememberNonCart();
      handleDirectCartLanding();
      handleViewcartQuery();
    });
  }
})();
</script>
<style>
  /* Keep the body layout intact while Smart Cart initializes */
  body.rebuy-smartcart-loading {
    cursor: progress;
  }
  /* Optional subtle overlay without shifting layout */
  body.rebuy-smartcart-loading::after {
    
    content: '';
    position: fixed;
    inset: 0;
    background: rgba(255,255,255,.2); 
    pointer-events: none;
    z-index: 2000;
  }
  body.rebuy-smartcart-loading .loader {
    display: block;
    position: fixed;
    top: 50%;
    left: 50%;
    margin: -50px 0 0 -50px;
    z-index: 2001;
  }
</style>


