{% schema %}
  {
    "name": "Daily use benefits",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Benefits of daily use"
      }     
    ],
    "presets": [
      {
        "name": "Product: daily use benefits"
      }
    ]
  }
{% endschema %}

<script>

  window.addEventListener('load', function() {
    
      const dailyUseBenefitsListItems = document.getElementsByClassName("daily-use-benefits__list__item");
      const dailyUseBenefitsImageContainerArrow = document.getElementsByClassName("daily-use-benefits__image-container__arrow")[0];
    
      if(!!dailyUseBenefitsListItems.length) {

          for (const item of dailyUseBenefitsListItems) {
            
            const observer = new window.IntersectionObserver(([entry]) => {
              
                if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
                  item?.classList?.add("visible-benefit");                  
                  return;
                }
              
                item?.classList?.remove("visible-benefit");
              
              }, {
                root: null,
                rootMargin: '0px 0px -30% 0px'
              });
                    
              observer.observe(item);
          }
         
     };

      if(dailyUseBenefitsImageContainerArrow) {
            const observer = new window.IntersectionObserver(([entry]) => {
              
                if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
                  dailyUseBenefitsImageContainerArrow?.classList?.add("visible-benefit");                  
                  return;
                }
              
                dailyUseBenefitsImageContainerArrow?.classList?.remove("visible-benefit");
              
              }, {
                root: null,
                rootMargin: '0px 0px -30% 0px'
              });
                    
              observer.observe(dailyUseBenefitsImageContainerArrow);
      }

  });

</script>