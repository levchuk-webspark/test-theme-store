{% style %}

.daily-use-benefits {
  padding: 20px 10px;
}

.daily-use-benefits__title {
  font-size: 30px;
  margin-bottom: 20px;
}

.daily-use-benefits__container {
  display: grid;
  grid-template-columns: minmax(0,45%) minmax(0,55%);
  gap: 24px;
}

.daily-use-benefits__list {
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.daily-use-benefits__list__item {
  display: flex;
  align-items: center;
  gap: 30px;
  border: 1px solid #000;
  border-radius: 8px;
  padding: 30px;
}

.daily-use-benefits__list__item__text-block {
  display: flex;
  flex-direction: column;
  gap: 15px;  
  font-size: 20px;
  color: #5A5552;
}

.daily-use-benefits__list__item__text-block__item:first-child {
  font-size: 25px;
  color: #000;
}
 
.daily-use-benefits__image-container {
  width: auto;
  height:0;
  min-height: 100%;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
}
  
.daily-use-benefits__image-container__image {
  height: 100%;
  min-height: 100%;
  max-height: 100%;
  object-fit: cover;
  display: block;
}

.daily-use-benefits__image-container__overlay {
  position: absolute;
  top: 2%;
  left: 2%;
  width: 96%;
  height: 96%;
  border-radius: 8px;
  border: 1px solid #000;
}

.daily-use-benefits__image-container__arrow {
  position: absolute;
  top: 5%;
  left: 20px;
  display: none;
}

.daily-use-benefits__list__item__image {
  height: 65px;
  width: 65px;
  min-height: 65px;
  min-width: 65px;
}

.daily-use-benefits__list__item__image,
.daily-use-benefits__image-container__arrow {
  color: transparent;
  transform: rotate(0deg);
  transition: color 0.5s linear, transform 0.5s linear;
}

.daily-use-benefits__list__item.visible-benefit .daily-use-benefits__list__item__image,
.daily-use-benefits__image-container__arrow.visible-benefit {
  color: #000;
  transform: rotate(90deg);
  transition: all 0.5s linear;
}

@media only screen and (max-width: 798px) {
  .daily-use-benefits__container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .daily-use-benefits__list {
    gap: 18px;
  }

  .daily-use-benefits__list__item {
    gap: 18px;
    padding: 18px 20px;
  }

  .daily-use-benefits__image-container__arrow,
  .daily-use-benefits__list__item__image {
    height: 40px;
    width: 40px;
    min-height: 40px;
    min-width: 40px;
    padding: 1px;
  }

  .daily-use-benefits__list__item__text-block {
    gap: 14px;  
    font-size: 10px;
  }
  
  .daily-use-benefits__list__item__text-block__item:first-child {
    font-size: 18px;
  }

  .daily-use-benefits__image-container__arrow {
    display: block;
  }

  .daily-use-benefits__image-container {
    width: 100%;
    height: auto;
  }

  .daily-use-benefits__image-container__image {
    height: auto;
    width: 100%;
  }
  
}
  
{% endstyle %}


