<script>
    window.addEventListener('DOMContentLoaded', function() {

    const whyUseProductSliderCardslist = document.querySelectorAll(".why-use-product__benefit_card");
    const whyUseProductSliderModalBackdrop = document.querySelector('.why-use-product__modal-backdrop');
    const whyUseProductSliderModalContent = document.querySelector(".why-use-product__modal__content");
    const whyUseProductSliderModalClose = document.querySelector(".why-use-product__modal__close");

    const whyUseProductRemoveSelectedClassFromCards = () => {
      for (const card of whyUseProductSliderCardslist) {
            card.classList.remove("is-selected-card");
        };
    };

    for (const card of whyUseProductSliderCardslist) { 
      card.addEventListener("click", () => {
          whyUseProductRemoveSelectedClassFromCards();
          card.classList.add("is-selected-card"); 
      
          if(whyUseProductSliderModalContent && whyUseProductSliderModalBackdrop) {

              whyUseProductSliderModalContent.classList.add("why-use-product__modal__content__is-open");
              whyUseProductSliderModalBackdrop.classList.add("why-use-product__modal-backdrop-is-open");

              const whyUseProductSliderCarousel = document.querySelector(".carousel-{{ section.id }}");
            
              const whyUseProductSliderCarouselFlickity = new Flickity( whyUseProductSliderCarousel, {
                    cellAlign: 'left',
                    contain: true,
                    groupCells: true,
                    wrapAround: true,
                    pageDots: true,
                    initialIndex: card.dataset.selectedCardIndex - 1
                });
    
              whyUseProductSliderCarouselFlickity.resize();

              const whyUseProductSliderCarouselPrevButton = document.querySelector('.why-use-product__modal__cards-list__item__button-prev-{{ section.id }}');
              const whyUseProductSliderCarouselNextButton = document.querySelector('.why-use-product__modal__cards-list__item__button-next-{{ section.id }}');

              if (whyUseProductSliderCarouselPrevButton) {
                whyUseProductSliderCarouselPrevButton.addEventListener( 'click', function() {
                  whyUseProductSliderCarouselFlickity.previous();
                });
              }
          
              if (whyUseProductSliderCarouselNextButton) {
                whyUseProductSliderCarouselNextButton.addEventListener( 'click', function() {
                  whyUseProductSliderCarouselFlickity.next( );
                });
              }
    

        
              whyUseProductSliderModalBackdrop.onclick = function(event) {
                  whyUseProductSliderModalContent.classList.remove("why-use-product__modal__content__is-open");
                  whyUseProductSliderModalBackdrop.classList.remove("why-use-product__modal-backdrop-is-open");
                  whyUseProductRemoveSelectedClassFromCards();
                  whyUseProductSliderCarouselFlickity.destroy();
              }

              whyUseProductSliderModalClose.onclick = function() {
                  whyUseProductSliderModalContent.classList.remove("why-use-product__modal__content__is-open");
                  whyUseProductSliderModalBackdrop.classList.remove("why-use-product__modal-backdrop-is-open");
                  whyUseProductRemoveSelectedClassFromCards();
                  whyUseProductSliderCarouselFlickity.destroy();
              }

 
              whyUseProductSliderModalContent.onclick = function(e) {
                  e.stopPropagation();
              }
          
          }


    });

  };

  });
  
</script>
