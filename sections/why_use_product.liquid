{% style %}
  #shopify-section-{{ section.id }} {
    {% if template.name == 'product' and product.metafields.custom.why_use_product.value.background %}
        background-color: {{ product.metafields.custom.why_use_product.value.background }};
    {% else %}
        background-color: {{ section.settings.background_color }};
    {% endif %}
  }
   #shopify-section-{{ section.id }} .why-use-product {
     padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .why-use-product__title {
    font-size: {{ section.settings.title-font-size }}px;
    margin-bottom: 50px;
  }

  #shopify-section-{{ section.id }} .why-use-product__title {
    {% if template.name == 'product' and product.metafields.custom.why_use_product.value.title_color %}
        color: {{ product.metafields.custom.why_use_product.value.title_color }};
    {% else %}
        color: {{ section.settings.title_color }};
    {% endif %}
  }

  .why-use-product__container {
    display: flex;
    gap: 30px;
  }

    .why-use-product__main_image_container {
      width: 50%;
    }
    

    .why-use-product__main_image > img {
      object-fit: cover;
      border-radius: 10px;
      height: 780px;
    }

  .why-use-product__benefit_container {
    width: 50%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 30px;
  }

   .why-use-product__benefit_card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 240px;
    border-radius: 10px;
    overflow: hidden;
    padding: 16px;

     cursor: pointer;
  } 

.cards-with-slider__card__title, .why-use-product__benefit_card__arrow .icon {
  {% if template.name == 'product' and product.metafields.custom.why_use_product.value.card_title_color %}
        color: {{ product.metafields.custom.why_use_product.value.card_title_color }};
    {% else %}
       color: {{ section.settings.card_title_color }};
    {% endif %}
}

  .cards-with-slider__card__title {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1;
  }

  .why-use-product__benefit_card__arrow .icon {
    width: 48px;
    height: 48px;
    transition: transform 0.6s;
  }

  .why-use-product__benefit_card:hover .why-use-product__benefit_card__arrow .icon {
      transform: rotate(90deg);
  }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .why-use-product {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .why-use-product__benefit {
      border-width: 1px;
    }

     #shopify-section-{{ section.id }} .why-use-product__title {
      font-size: {{ section.settings.title-font-size_mobile }}px;
      margin-bottom: 30px;
    }

     #shopify-section-{{ section.id }} .cards-with-slider__card__title {
      font-size: {{ section.settings.text_size_mobile }}px;
    }

    .why-use-product__benefit_card {
      padding: 14px;
    }

    .why-use-product__benefit_card__arrow .icon {
      width: 40px;
      height: 40px;
    }

    .why-use-product__main_image > img {
      height: 500px;
    }

    .why-use-product__benefit_card {
      height: 196px;
    }

    .why-use-product__container {
      flex-direction: column;
      gap: 16px;
    }

    .why-use-product__main_image_container {
      width: 100%;
    }

    .why-use-product__benefit_container {
      width: 100%;
      gap: 16px;
    }
    
  }

 

  
