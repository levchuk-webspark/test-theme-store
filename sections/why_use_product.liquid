                  background-position: center;
                  background-repeat: no-repeat;
                  border: none;
                  position: relative; 
                  overflow: hidden; 
              }
              .block-1.why-use-product__benefit_card::before {
                  content: '';
                  position: absolute;
                  top: 0;
                  left: 0;
                  width: 100%;
                  height: 100%;
                  background-color: rgba(0, 0, 0, 0.3);
                  transition: background-color 0.6s ease; 
