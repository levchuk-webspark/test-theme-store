{% assign data = section.settings %}
{% assign cards = section.blocks | where: 'type', 'card' %}

{% style %}
  .one-daily-ritual {
    padding: 124px 0 100px;
    background: #fff;
    border-top: 1px solid #D4D8D0;
  }

  .one-daily-ritual__wrapper {
    margin: 0 auto;
    max-width: 1280px;
    padding: 0 20px;
    width: 100%;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 56px;
  }

  .one-daily-ritual__title {
    font-family: 'Romie' !important;
    color: #284734;
    font-weight: 400;
    font-size: 56px;
    line-height: 1.3;
    letter-spacing: -2.2%;
    text-align: center;
    max-width: 660px;
  }

  .one-daily-ritual__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .one-daily-ritual__card {
    flex: 0 0 calc(33.333% - ((8px * 2) / 3));
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 24px;
  }

  .one-daily-ritual__card-image {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 1.5;
  }

  .one-daily-ritual__card-round {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .one-daily-ritual__card-round:before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 1px;
    background: #D4D8D0;
  }
  
  .one-daily-ritual__card:first-child div:before {
    background: linear-gradient(90deg, rgba(212, 216, 208, 0) 0%, #D4D8D0 100%);
  }

  .one-daily-ritual__card:nth-child(2) div:before {
    width: calc(100% + 16px);
  }

  .one-daily-ritual__card:last-child div:before {
    background: linear-gradient(90deg, #D4D8D0 0%, rgba(212, 216, 208, 0) 100%);
  }

  .one-daily-ritual__card-round div {
    flex: 0 0 44px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #EDF2E9;
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .one-daily-ritual__card-round div:after {
    content: '';
    width: 24px;
    height: 24px;
    border-radius: inherit;
    background: #78BE20;
  }

  .one-daily-ritual__card-bottom {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 16px;
  }

  .one-daily-ritual__card-title {
    font-weight: 400;
    font-size: 32px;
    line-height: 1.25;
    letter-spacing: -2.2%;
    color: #000;
    text-align: center;
  }

  .one-daily-ritual__card-description {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: -2.2%;
    color: #000;
    text-align: center;
  }

  @media (max-width: 1200px) {
    .one-daily-ritual__card-title {
      font-size: 24px;
    }
  }

  @media (max-width: 991px) {
    .one-daily-ritual__title {
      font-size: 48px;
    }

    .one-daily-ritual__card-title {
      font-size: 20px;
    }

    .one-daily-ritual__card-description {
      font-size: 16px;
    }

    .one-daily-ritual__card-description br {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .one-daily-ritual {
      padding: 80px 0;
    }

    .one-daily-ritual__wrapper {
      gap: 48px;
    }

    .one-daily-ritual__list {
      flex-direction: column;
      gap: 32px;
    }

    .one-daily-ritual__card {
      gap: 8px;
    }

    .one-daily-ritual__card-image {
      aspect-ratio: 21 / 9;
    }

    .one-daily-ritual__list .one-daily-ritual__card div:before {
      background: linear-gradient(90deg, rgba(212, 216, 208, 0) 0%, #D4D8D0 50%, rgba(212, 216, 208, 0) 100%);
    }
  }

  @media (max-width: 450px) {
    .one-daily-ritual__title {
      font-size: 36px;
    }
  }
{% endstyle %}

<section class="one-daily-ritual one-daily-ritual--{{ template.suffix }}">
  <div class="one-daily-ritual__wrapper">
    {% if data.title != blank %}
      <h2 class="one-daily-ritual__title">{{ data.title }}</h2>
    {% endif %}

    <ul class="one-daily-ritual__list">
      {% for block in cards %}
        {% assign card = block.settings %}

        <li class="one-daily-ritual__card">
          {% if card.image != blank %}
            {{ card.image | image_url: width: 816, height: 560 | image_tag: class: 'one-daily-ritual__card-image', loading: 'lazy' }}
          {% endif %}
          <div class="one-daily-ritual__card-round"><div></div></div>
          <div class="one-daily-ritual__card-bottom">
              {% if card.title != blank %}
                <h3 class="one-daily-ritual__card-title">{{ card.title }}</h3>
              {% endif %}
              {% if card.description != blank %}
                <p class="one-daily-ritual__card-description">{{ card.description }}</p>
              {% endif %}
          </div>
        </li>
      {% endfor %}   
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "One Daily Ritual",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title"
    },
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card title"
        },
        {
          "type": "html",
          "id": "description",
          "label": "Card description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing: One Daily Ritual"
    }
  ]
}
{% endschema %}
