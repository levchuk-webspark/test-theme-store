{% assign data = section.settings %}
{% assign cards = section.blocks | where: 'type', 'card' %}

{% style %}
  .pure-proven {
    padding: 124px 0;
    background: #EDF2E9;
  }

  .pure-proven__wrapper {
    margin: 0 auto;
    max-width: 1280px;
    padding: 0 20px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .pure-proven__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .pure-proven__title {
    flex: 0 1 410px;
    font-family: 'Romie' !important;
    color: #284734;
    font-weight: 400;
    font-size: 76px;
    line-height: 1.3;
    letter-spacing: -2.2%;
  }

  .pure-proven__column {
    flex: 0 1 630px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pure-proven__description {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -2.2%;
    color: #284734;
  }

  .pure-proven__button {
    background: #78BE20;
    padding: 12px 24px;
    border-radius: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: -2.2%;
    color: #fff;
    width: fit-content;
    transition: all 0.3s ease-in-out; 
  }

  .pure-proven__button:hover {
    transform: scale(1.04);
    color: #fff;
    background: #598F3D;
  }

  .pure-proven__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pure-proven__card {
    flex: 0 0 calc(25% - ((8px * 3) / 4));
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
  }

  .pure-proven__card-header {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 30px;
  }

  .pure-proven__card-title {
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -2.2%;
    color: #000;
  }

  .pure-proven__card-description {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.25;
    letter-spacing: -2.2%;
    color: #000;
  }

  .pure-proven__card-image {
    flex: 0 0 auto;
    width: 100%;
    object-fit: cover;
    aspect-ratio: 1.2;
  }

  @media (max-width: 1200px) {
    .pure-proven__title {
      font-size: 64px;
    }

    .pure-proven__card-header {
      padding: 24px;
    }
  }

  @media (max-width: 991px) {
    .pure-proven__list {
      flex-wrap: wrap;
    }

    .pure-proven__card {
      flex: 0 0 calc(50% - (8px / 2));
    }

    .pure-proven__card-image {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 768px) {
    .pure-proven {
      padding: 80px 0;
    }

    .pure-proven__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .pure-proven__title {
      font-size: 48px;
      flex: auto;
    }

    .pure-proven__column {
      flex: auto;
    }

    .pure-proven__list {
      flex-wrap: nowrap;
      flex-direction: column;
      gap: 16px;
    }

    .pure-proven__card {
      flex: 1 1 auto;
    }

    .pure-proven__card-image {
      aspect-ratio: 21 / 9;
    }
  }

  @media (max-width: 425px) {
    .pure-proven__title {
      font-size: 36px;
    }

    .pure-proven__card-image {
      aspect-ratio: 16 / 9;
    }
  }
{% endstyle %}

<section class="pure-proven pure-proven--{{ template.suffix }}">
  <div class="pure-proven__wrapper">
    <div class="pure-proven__head">
      {% if data.title != blank %}
        <h2 class="pure-proven__title">{{ data.title }}</h2>
      {% endif %}
      <div class="pure-proven__column">
          {% if data.description != blank %}
            <p class="pure-proven__description">{{ data.description }}</p>
          {% endif %}
          {% if data.cta_label != blank %}
            <a 
              {% if data.cta_url != blank %}
                href="{{ data.cta_url }}"
                target="_blank"
              {% endif %}
              class="pure-proven__button"
            >
              {{ data.cta_label }}
            </a>
          {% endif %}
      </div>
    </div>
    <ul class="pure-proven__list">
      {% for block in cards %}
        {% assign card = block.settings %}

        <li class="pure-proven__card">
          <div class="pure-proven__card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 32 32">
              <path fill="url(#a)" d="M28.233 12.852c-.472-.492-.96-1-1.143-1.446-.17-.409-.18-1.086-.19-1.742-.019-1.22-.039-2.603-1-3.564-.961-.961-2.344-.981-3.564-1-.656-.01-1.333-.02-1.742-.19-.445-.184-.954-.671-1.447-1.143C18.286 2.94 17.306 2 16 2c-1.305 0-2.284.939-3.148 1.768-.492.47-1 .958-1.446 1.142-.406.17-1.086.18-1.742.19-1.22.019-2.603.039-3.564 1-.961.961-.975 2.344-1 3.564-.01.656-.02 1.334-.19 1.742-.184.445-.671.954-1.143 1.446C2.94 13.715 2 14.695 2 16c0 1.305.939 2.284 1.768 3.148.47.492.958 1 1.142 1.446.17.409.18 1.086.19 1.742.019 1.22.039 2.603 1 3.564.961.961 2.344.981 3.564 1 .656.01 1.334.02 1.742.19.445.184.954.671 1.446 1.143C13.715 29.06 14.695 30 16 30c1.305 0 2.284-.939 3.148-1.767.492-.472 1-.96 1.446-1.143.409-.17 1.086-.18 1.742-.19 1.22-.019 2.603-.039 3.564-1 .961-.961.981-2.344 1-3.564.01-.656.02-1.333.19-1.742.184-.445.671-.954 1.143-1.447C29.06 18.286 30 17.306 30 16c0-1.305-.939-2.284-1.767-3.148Zm-6.526.855-7 7a1.001 1.001 0 0 1-1.415 0l-3-3a1 1 0 0 1 1.415-1.415L14 18.587l6.293-6.293a1 1 0 0 1 1.415 1.415Z"/>
              <defs>
                <linearGradient id="a" x1="16" x2="16" y1="2" y2="30" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#78BE20"/>
                  <stop offset="1" stop-color="#44693D"/>
                </linearGradient>
              </defs>
            </svg>
            {% if card.title != blank %}
              <h3 class="pure-proven__card-title">{{ card.title }}</h3>
            {% endif %}
            {% if card.description != blank %}
              <p class="pure-proven__card-description">{{ card.description }}</p>
            {% endif %}
          </div>
          {% if card.image != blank %}
            {{ card.image | image_url: width: 608, height: 524 | image_tag: class: 'pure-proven__card-image', loading: 'lazy' }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Pure Proven",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Section title"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section description"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Section CTA label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Section CTA link"
    },
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Card description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing: Pure Proven"
    }
  ]
}
{% endschema %}
