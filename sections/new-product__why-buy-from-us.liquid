{% assign data = section.settings %}
{% assign cards = section.blocks | where: 'type', 'card' %}

{% style %}

.why-buy-from-us {
  padding: 72px 0;
  position: relative;
}

.why-buy-from-us__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -1;
}

.why-buy-from-us__wrapper {
  margin: 0 auto;
  max-width: 1440px;
  padding: 0 20px;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.why-buy-from-us__block {
  display: flex;
  flex-direction: column;
  padding: 24px 32px 72px;
  border-radius: 16px;
  backdrop-filter: blur(24px);
  border: 1px solid #D4D8D033;
  background: #FCFCF71A;
  margin: 32px 0 16px;
}

.why-buy-from-us__title {
  width: 100%;
  font-family: Ambit;
  font-weight: 900;
  font-size: 38px;
  line-height: 1.2;
  letter-spacing: 3%;
  color: #F7F5F1;
  padding-bottom: 24px;
  border-bottom: 1px solid #D4D8D033;
  margin-bottom: 56px;
}

.why-buy-from-us__title span {
  color: #E0E56B;
  font-weight: 400;
  font-family: Romie;
  font-style: Italic;
}

.why-buy-from-us__list {
  display: flex;
  gap: 64px;
}

.why-buy-from-us__card {
  flex: 0 0 calc(33.333% - ((64px * 2) / 3));
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.why-buy-from-us__card-icon {
  flex: 0 0 auto;
  object-fit: contain;
  aspect-ratio: 1;
}

.why-buy-from-us__card-description {
  font-family: Ambit;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.5;
  color: #F7F5F1;
  letter-spacing: 2%;
}

.why-buy-from-us__bottom {
  flex: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  padding: 32px;
  border-radius: 16px;
  border: 1px solid #D4D8D0;
}

.why-buy-from-us__description {
  flex: 0 1 610px;
  font-size: 20px;
  font-weight: 400;
  line-height: 1.5;
  color: #F7F5F1;
  letter-spacing: 2%;
}

.why-buy-from-us__button {
  font-family: Ambit;
  background: #F7F5F1;
  padding: 16px 24px;
  border-radius: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-align: center;
  font-weight: 400;
  font-size: 15px;
  line-height: 1.25;
  color: #284734;
  width: fit-content;
  white-space: nowrap;
  flex: 0 0 auto;
  transition: all 0.3s ease-in-out; 
}

.why-buy-from-us__button svg {
  transition: all 0.3s ease-in-out; 
}

.why-buy-from-us__button:hover {
  color: #284734;
}

.why-buy-from-us__button:hover svg {
  transform: translateX(4px) scale(1.1);
}

@media (max-width: 1200px) {
  .why-buy-from-us__list {
    gap: 24px;
  }

  .why-buy-from-us__card {
    flex: 0 0 calc(33.333% - ((24px * 2) / 3));
  }
}

@media (max-width: 991px) {
  .why-buy-from-us {
    padding: 48px 0;
  }

  .why-buy-from-us__logo {
    max-width: 85%;
  }

  .why-buy-from-us__logo svg {
    width: 100%;
    height: auto;
  }

  .why-buy-from-us__block {
    padding: 16px 16px 32px;
  }

  .why-buy-from-us__title {
    font-size: 28px;
    margin-bottom: 32px;
  }

  .why-buy-from-us__list {
    flex-direction: column;
    gap: 64px;
  }

  .why-buy-from-us__card {
    flex: auto;
    flex-direction: row;
  }

  .why-buy-from-us__card-icon {
    width: 40px;
    height: 40px;
  }

  .why-buy-from-us__description {
    font-size: 18px;
  }
}

@media (max-width: 576px) {
  .why-buy-from-us__bottom {
    flex-direction: column;
    align-items: unset;
    gap: 24px;
    padding: 32px 16px;
  }

  .why-buy-from-us__description {
    flex: auto;
    text-align: center;
  }

  .why-buy-from-us__button {
    width: 100%;
  }
}

{% endstyle %}

