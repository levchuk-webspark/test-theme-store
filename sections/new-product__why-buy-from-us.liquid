    </div>
    <div class="why-buy-from-us__block">
      {% if data.title != blank %}
        <h2 class="why-buy-from-us__title">{{ data.title }}</h2>
      {% endif %}
      <ul class="why-buy-from-us__list">
        {% for block in cards %}
          {% assign card = block.settings %}
          <li class="why-buy-from-us__card">
            {% if card.icon != blank %}
              {{ card.icon | image_url: width: 64, height: 64 | image_tag: class: 'why-buy-from-us__card-icon', loading: 'lazy' }}
            {% endif %}
            {% if card.description != blank %}
              <p class="why-buy-from-us__card-description">{{ card.description }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="why-buy-from-us__bottom">
      {% if data.description != blank %}
        <p class="why-buy-from-us__description">{{ data.description }}</p>
      {% endif %}
      {% if data.cta_label != blank %}
        <a 
          {% if data.cta_url != blank %}
            href="{{ data.cta_url }}"
            target="_blank"
          {% endif %}
          class="why-buy-from-us__button"
        >
          {{ data.cta_label }}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16">
            <path fill="#284734" d="M16 8c0 4.417-3.583 8-8 8s-8-3.583-8-8 3.568-8 8-8 8 3.583 8 8ZM7.194 3.194l4.087 4H2.388v1.597h8.893l-4.087 4h2.087l4.892-4.805L9.28 3.18H7.194v.014Z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Product: Why buy",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Section title",
      "default": "Why buy <span>From Us</span>"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section description",
      "default": "All of our award-winning products are manufactured in approved Good Manufacturing Practice (GMP) facilities."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Section CTA label",
      "default": "Our mission"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Section CTA link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section background image"
    },
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Card icon"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Card description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Product: Why buy"
    }
  ]
}
{% endschema %}
