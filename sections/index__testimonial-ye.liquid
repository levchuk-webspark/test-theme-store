{% style %}
  #shopify-section-{{ section.id }} {
    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.background_color %}
        background-color: {{ product.metafields.custom.product_testimonials.value.background_color }};
    {% else %}
        background-color: {{ section.settings.background_color }};
    {% endif %}

    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .testimonials-ye {
   padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

  }

  .testimonials-ye {
    display: flex;
    flex-direction: column;
  }

  .testimonials-ye__title {
    font-size: 30px;
    font-weight: normal;
  }

  #shopify-section-{{ section.id }} .testimonials-ye__title {
    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.text_color %}
        color: {{ product.metafields.custom.product_testimonials.value.text_color }};
    {% else %}
        color: {{ section.settings.title_color }};
    {% endif %}
  }

  .carousel-{{ section.id }} {
    display: flex;
    align-items: stretch;
  }

  .testimonials-ye .carousel-cell {
    margin-right: 80px;
    min-height: 100%;
    display: flex;
  }

  .testimonials-ye__card {
    height: 300px;
    height: inherit;
    padding: 16px;
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    font-size: 20px;
    /* line-height: 28px; */
  }

  #shopify-section-{{ section.id }} .testimonials-ye__card {
    width: {{ section.settings.card_width }}px;

    align-items: {{ section.settings.card_alignment }};

    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.text_color %}
        color: {{ product.metafields.custom.product_testimonials.value.text_color }};
        border-color: {{ product.metafields.custom.product_testimonials.value.text_color }};
    {% else %}
        color: {{ section.settings.card_text }};
        border-color:  {{ section.settings.card_text }};
    {% endif %}

    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.background_color %}
        background-color: {{ product.metafields.custom.product_testimonials.value.background_color }};
    {% else %}
        background-color: {{ section.settings.card_background }};
    {% endif %}
    
    border: 1px solid;
  }

    #shopify-section-{{ section.id }} .testimonials-ye__card__descripion {
    text-align: {{ section.settings.card_alignment }};
  }

  .testimonials-ye__card__author {
    margin-top: 20px;
  }
  
  .testimonials-ye__card__author__title,
  .testimonials-ye__card__author__info {
    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.text_color %}
        color: {{ product.metafields.custom.product_testimonials.value.text_color }};
    {% else %}
        color: {{ section.settings.author_add_color }};
    {% endif %}
  }

  .testimonials-ye__card__image {
    width: 160px;
    height: 210px;
    position: absolute;
    top: 24px;
    right: -60px;
    z-index: 1;
  }

  .testimonials-ye__card__image__wrapper {
    width: 160px;
    position: absolute;
    top: 24px;
    right: -60px;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .testimonials-ye__card__image__wrapper > .testimonials-ye__card__image {
      top: unset;
      right: unset;
      position: unset;
    }

  .testimonials-ye__card__image img {
    object-fit: cover;
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }} .flickity-button {
    background-color: transparent;
    border: 1px solid;

    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.text_color %}
        color: {{ product.metafields.custom.product_testimonials.value.text_color }};
        border-color: {{ product.metafields.custom.product_testimonials.value.text_color }};
    {% else %}
        color: {{ section.settings.card_text }};
        border-color:  {{ section.settings.card_text }};
    {% endif %}
    
  }

  #shopify-section-{{ section.id }} .flickity-button-icon {
    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.text_color %}
        fill: {{ product.metafields.custom.product_testimonials.value.text_color }};
    {% else %}
        fill: {{ section.settings.card_text }};
    {% endif %}
  }
  
  .testimonials-ye .flickity-prev-next-button {
    top: -70px;
    transform: translateY(0);
    width: 19px;
    height: 19px;
    padding: 0;
  }

  .testimonials-ye .flickity-prev-next-button.previous {
    left: unset;
    right: 40px;
  }

    .testimonials-ye__nav-buttons {
      display: flex;
      justify-content: flex-end;
      gap: 6px;
    }

    .testimonials-ye .flickity-button {
      display: none;
    }

  .testimonials-ye__nav-buttons__prev,
  .testimonials-ye__nav-buttons__next {
    border: none;
    background: none;
    padding: 0;
  }

  .testimonials-ye__nav-buttons__prev:hover,
  .testimonials-ye__nav-buttons__next:hover {
    cursor: pointer;
  }

  .testimonials-ye__nav-buttons__prev .icon,
  .testimonials-ye__nav-buttons__next .icon {
    width: 26px;
    height:26px;

    {% if template.name == 'product' and product.metafields.custom.product_testimonials.value.text_color %}
        color: {{ product.metafields.custom.product_testimonials.value.text_color }};
    {% else %}
        color: {{ section.settings.card_text }};
    {% endif %}
  }

  .testimonials-ye__certificate-modal {
    display: none;
    position: fixed;
    z-index: 999999 !important;
    padding: 70px;
    left: 0;
    top: 0;
    bottom: 0;
    right: 0;
    width: 100vw;
    height: 100vh;
    max-height: 100%;
    background: rgba(6, 32, 33, 0.5);
    
    justify-content: center;
    align-items: center;

    /* margin-left: auto;
    margin-right: auto; */
  }

  .testimonials-ye__certificate-modal__content {

    height: 100%;
    width: 80%;
    /* overflow: hidden; */
    overflow-y: auto;
    border-radius: 8px;
    border: 1px solid black;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: rgba(255, 255, 255);
    box-shadow: -1px 4px 5px 0px rgba(0,0,0,0.75);
  }

  .testimonials-ye__certificate-modal__header {
    width: 100%;
    display: flex;
    justify-content: end;
    align-items: center;
    font-weight: 500;
    font-size: 24px;

    margin-bottom: 10px;
  }

  .testimonials-ye__certificate-modal__close {
    padding: 10px;
    border-radius: 8px;
    border: 1px solid black;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .testimonials-ye__certificate-modal__close:hover {
    border: 1px solid black;
    cursor: pointer;
  }
  .testimonials-ye__certificate-modal__close:hover {
    box-shadow: -1px 4px 5px 0px rgba(0,0,0,0.75);
  }

  .testimonials-ye__certificate-modal__close svg{
    width: 24px;
    height: 24px;
    color: black;
  }

  .testimonials-ye__certificate-modal__close:hover svg {
    color: black;
  }

  .testimonials-ye__certificate-modal__main {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .testimonials-ye__certificate__main {
    width: 100%;

    height: 90%;
    display: flex;
    /* align-items: center; */
    align-items: baseline;
    justify-content: center;
  }

  .testimonials-ye__certificate__main > iframe {
    height: 100%;
  }
  
   .testimonials-ye__certificate-modal ::-webkit-scrollbar {
      -webkit-appearance: none;
      width: 2px;
    }

  .testimonials-ye__certificate-modal ::-webkit-scrollbar-thumb {
      border-radius: 4px;
      background-color: #dde2e3;
      -webkit-box-shadow: 0 0 1px rgba(255,255,255,.5);
    }

  #shopify-section-{{ section.id }} .carousel-{{ section.id }}-documents .flickity-button {
    display: flex;
    
  }

  #shopify-section-{{ section.id }} .carousel-{{ section.id }}-documents > .flickity-button {
    color: black;
    border-color: black;
    z-index: 9;
  }

  .testimonials-ye .carousel-{{ section.id }}-documents > .flickity-prev-next-button {
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .carousel-{{ section.id }}-documents > .flickity-button > .flickity-button-icon {
    fill: black;
  }

  .testimonials-ye .carousel-{{ section.id }}-documents > .flickity-prev-next-button {
    top: -38px;
  }

  .testimonials-ye__certificate-modal__nav-buttons {
    position: absolute;
    left: 50%;
    top: 11px;
    -webkit-transform: translateX(-50%);
    transform: translateX(-50%);
  }

  button.testimonials-ye__certificate-modal__nav-buttons__prev, button.testimonials-ye__certificate-modal__nav-buttons__next {
    border: none;
    background: none;
    cursor: pointer;
    border-radius: 50%;
  }

   button.testimonials-ye__certificate-modal__nav-buttons__prev:hover, button.testimonials-ye__certificate-modal__nav-buttons__next:hover {
    box-shadow: -1px 4px 5px 0px rgba(0, 0, 0, 0.75);
  }

  button.testimonials-ye__certificate-modal__nav-buttons__prev > span.icon, button.testimonials-ye__certificate-modal__nav-buttons__next > span.icon {
    margin-top: 4px;
  }

  .testimonials-ye__certificate-modal__certificate_document {
    opacity: 0;
    display: none;
    transition: opacity 0.3s ease;
  }

   .testimonials-ye__certificate-modal__certificate_document.testimonials-ye__certificate-modal__certificate_document_visible {
    opacity: 1;
    display: block;
  }

  @media only screen and (max-width: 1440px) {
      #shopify-section-{{ section.id }} .testimonials-ye__card {
        width: 300px;
      }
  }

  @media only screen and (max-width: 1200px) {
    .testimonials-ye__certificate-modal__content {
      padding: 20px 10px;
      /* width: 95%; */
    }
  }

  @media only screen and (max-width: 798px) {
    /* #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: 10px;
      padding-right: 10px;
    } */

      #shopify-section-{{ section.id }} .testimonials-ye {
        padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: 10px;
      padding-right: 10px;

  }

    .testimonials-ye__title {
      max-width: 200px;
      margin-bottom: 30px;
    }

    .testimonials-ye__card {
      padding: 10px;
      font-size: 14px;
      /* line-height: 16px; */
    }

      #shopify-section-{{ section.id }} .testimonials-ye__card {
        width: 220px;
      }

      .carousel-cell {
        margin-right: 60px;
      }

      .testimonials-ye__card__image {
        width: 90px;
        height: 125px;
        top: 16px;
        right: -30px;
      }

    .testimonials-ye__card__image__wrapper {
        width: 90px;
        top: 16px;
        right: -30px;
    }

    .testimonials-ye__card__image__wrapper > .testimonials-ye__card__image {
      top: unset;
      right: unset;
      position: unset;
    }
    
    .testimonials-ye .flickity-button {
      display: none;
    }

    .testimonials-ye__nav-buttons {
      justify-content: center;
      margin-top: 30px;
    }

    .testimonials-ye__certificate-modal {
        padding: 24px;
        padding-top: 90px;
    }

    .testimonials-ye__certificate-modal__content {
      padding: 10px;
      width: 100%;
    }

    .testimonials-ye__certificate-modal__close {
        padding: 5px;
    }

    .testimonials-ye__certificate-modal__close svg{
      width: 18px;
      height: 18px;
    }

    button.testimonials-ye__certificate-modal__nav-buttons__prev:hover, button.testimonials-ye__certificate-modal__nav-buttons__next:hover {
      box-shadow: none;
    }

  }

    @media only screen and (max-width: 500px) {

    .testimonials-ye__certificate-modal__header {
      margin-bottom: 10px;
    }
  }

    @media only screen and (min-width: 799px) {
      .testimonials-ye__nav-buttons {
        order: 2;
        margin-bottom: 60px;
      }

      .carousel-{{ section.id }} {
        order: 3;
      }
    }

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
