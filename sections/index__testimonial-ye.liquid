{% comment %}JavaScript{% endcomment %}

<script>
  window.addEventListener('load', function() {

    const testimonialsCarousel = document.querySelector('.carousel-{{ section.id }}');

    if (testimonialsCarousel) {
        const testimonialsFlickity = new Flickity( testimonialsCarousel, {
            cellAlign: 'left',
            contain: true,
            groupCells: true,
            wrapAround: true,
            pageDots: false
        });

      
        const testimonialsPrevButton = document.querySelector('.testimonials-ye__nav-buttons__prev');
        const testimonialsNextButton = document.querySelector('.testimonials-ye__nav-buttons__next');
    
        if (testimonialsPrevButton) {
          testimonialsPrevButton.addEventListener( 'click', function() {
            testimonialsFlickity.previous();
          });
        }
    
        if (testimonialsNextButton) {
          testimonialsNextButton.addEventListener( 'click', function() {
            testimonialsFlickity.next( );
          });
        }
    
    }

       
  const certificateModalButtons = document.querySelectorAll(".testimonials-ye__card__report-button");
  const certificateModal = document.querySelector(".testimonials-ye__certificate-modal");
  const certificateModalContent = document.querySelector(".testimonials-ye__certificate-modal__content");
  const certificateModalClose = document.querySelector(".testimonials-ye__certificate-modal__close");

  if(!!certificateModalButtons.length && certificateModal) {

    document.getElementById('lab-report-button').addEventListener('click', function() {
      certificateModal.style.display = "flex";
    });
    
      certificateModal.onclick = function() {
        certificateModal.style.display = "none";
      }
    
      certificateModalClose.onclick = function() {
        certificateModal.style.display = "none";
      }
    
      certificateModalContent.onclick = function(e) {
          e.stopPropagation();
      }
  };

   const documentNextButtons = document.getElementById("testimonials-ye__certificate-modal__nav-buttons__next"); 
    const documentPrevButtons = document.getElementById("testimonials-ye__certificate-modal__nav-buttons__prev"); 
    
    documentNextButtons?.addEventListener('click', function() {
      
      const documents = document.querySelectorAll(".testimonials-ye__certificate-modal__certificate_document");
      documents.forEach(document => {
        document.classList.remove("testimonials-ye__certificate-modal__certificate_document_visible");
      })
      documents[1].classList.add("testimonials-ye__certificate-modal__certificate_document_visible");
      documentNextButtons.disabled=true;
      documentPrevButtons.disabled=false;
    });

    documentPrevButtons?.addEventListener('click', function() {
      
      const documents = document.querySelectorAll(".testimonials-ye__certificate-modal__certificate_document");
      documents.forEach(document => {
        document.classList.remove("testimonials-ye__certificate-modal__certificate_document_visible");
      })
      documents[0].classList.add("testimonials-ye__certificate-modal__certificate_document_visible");
      documentNextButtons.disabled=false;
      documentPrevButtons.disabled=true;
    });
