{% assign rows = section.blocks | where: 'type', 'row' %}
{% assign last_item = rows.size %}
{% assign limit_to_show = 10 %}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  .price-comparison__info-block {
    display: flex;
    justify-content: space-between;
  }

  .price-comparison__info-block__container {
    width: 60%;
  }

  .price-comparison__image-block {
    display: flex;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .price-comparison__title {
    {% if section.settings.text_color != blank %}
      color: {{ section.settings.text_color }};
    {% endif %}
    {% if section.settings.title_font_size != blank %}
      font-size: {{ section.settings.title_font_size }}px;
    {% endif %}
    line-height: 1.1;
    {% if section.settings.description != blank %}
       margin-bottom: 42px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .price-comparison__description {
    {% if section.settings.text_color != blank %}
      color: {{ section.settings.text_color }};
    {% endif %}
    {% if section.settings.description_font_size != blank %}
      font-size: {{ section.settings.description_font_size }}px;
    {% endif %}
    line-height: 1.3;
  }

  .price-comparison__buttons-container {
    margin-top: 42px;
  }

  .price-comparison__table {
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 20px;
    justify-content: space-between;
  }

  .price-comparison__table__header, .price-comparison__table__body {
    display: flex;
    gap: 20px;
  } 

  .price-comparison__table__columns {
    display: flex;
    gap: 20px;
  }

  .price-comparison__table__title {
    border-radius: 10px;
    padding: 20px 16px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .price-comparison__table__title {
    font-size: {{ section.settings.title_column_font_size }}px;
  }

  .price-comparison__table__title.first {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .price-comparison__table__title.first > span {
    margin-right: 10px;
  }

  #shopify-section-{{ section.id }} .price-comparison__table__title.first {
    background-color: {{ section.settings.background_color_title_first_column }};
    color: {{ section.settings.text_color_title_first_column }};
  }

  #shopify-section-{{ section.id }} .price-comparison__table__title.second {
    background-color: {{ section.settings.background_color_title_second_column }};
    color: {{ section.settings.text_color_title_second_column }};
  }

  #shopify-section-{{ section.id }} .price-comparison__table__title.third {
    background-color: {{ section.settings.background_color_title_third_column }};
    color: {{ section.settings.text_color_title_third_column }};
  }

  .price-comparison__table__column {
    display: flex;
  }

  .price-comparison__table__title.third {
    width: 100%;
  }

   .price-comparison__table__column.fixed {
     width: 100%;
   }

  .price-comparison__table__columns > .price-comparison__table__column {
    width: 225px;
  }

  #shopify-section-{{ section.id }} .price-comparison__table__column.first {
    background-color: {{ section.settings.background_color_first_column }};
    color: {{ section.settings.text_color_first_column }};
  }

  #shopify-section-{{ section.id }} .price-comparison__table__column.second {
    background-color: {{ section.settings.background_color_second_column }};
    color: {{ section.settings.text_color_second_column }};
  }

  #shopify-section-{{ section.id }} .price-comparison__table__column.third {
    background-color: {{ section.settings.background_color_third_column }};
    color: {{ section.settings.text_color_third_column }};
  }

  .price-comparison__table__column.second, .price-comparison__table__column.third {
    text-align: center;
  }

  .price-comparison__table__body .price-comparison__table__column {
    border-radius: 10px;
    padding: 20px;
    flex-direction: column;
  }

  .price-comparison__footnote {
    margin-top: 15px;
    font-size: 25px;
    width: 65%;
  }

.price-comparison__tooltip-container {
  position: relative;
  /* display: inline-block; */
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
}

.price-comparison__tooltip-content {
  position: fixed;
  /* visibility: hidden; */
  opacity: 0;
  background-color: #FFFFFF;
  color: #000000;
  box-shadow: 10px 0px 24px 0px #00000059;
  border-radius: 11px;
  padding: 20px 24px;
  position: absolute;
  z-index: 9;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  transition: opacity 0.3s;
  white-space: pre-line;
  min-width: 300px;
  width: fit-content;
  text-align: start;

  display: none;
}

  .price-comparison__tooltip-content__title, .price-comparison__tooltip-content__body {
    font-size: 20px;
    line-height: 1.1;
  }

  .price-comparison__tooltip-content__title {
    font-weight: bold;
    margin-bottom: 18px;
  }

.price-comparison__tooltip-content.visible {
  display: block;
  opacity: 1;
}

  .price-comparison__consclusion {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }

  .price-comparison__consclusion__block {
    border-radius: 10px;
    padding: 30px 20px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .price-comparison__consclusion__block.block_1 {
    font-size: {{ section.settings.block_1_font_size }}px;
    color: {{ section.settings.text_color_block_1 }};
    background-color: {{ section.settings.background_color_block_1 }};
    width: 100%;
    display: flex;
    align-items: center;
  }

  .price-comparison__consclusion__block__images.image_block_1 {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .price-comparison__consclusion__block.block_2 {
    font-size: {{ section.settings.block_2_font_size }}px;
    color: {{ section.settings.text_color_block_2 }};
    background-color: {{ section.settings.background_color_block_2 }};
    min-width: 470px;
    width: 470px;
    max-width: 470px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .price-comparison__consclusion__block__images.image_block_2 {
    min-width: 470px;
    width: 470px;
    max-width: 470px;
    display: flex;
  }

  .price-comparison__consclusion__block__images > .image-element__wrap.price-comparison__consclusion__block__image {
    margin-left: unset;
    margin-right: unset;
    border-radius: 10px;
  }

  .image-element__wrap.price-comparison__consclusion__block__image > img {
    border-radius: 10px;
    object-fit: cover;
  }

  .price-comparison__consclusion__toggle-button {
    background-color: transparent;
    color: black;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    font-size: 22px;
    margin-top: 10px;
    font-weight: 900;
    font-family: Ambit, Merriweather Sans, sans-serif !important;
    width: 100%;
  }

  .price-comparison__hidden {
    display: none;
  }

  .price__additional-text {
    font-size: 24px;
  }

  @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .price-comparison__title {
      {% if section.settings.title_font_size_mobile != blank %}
        font-size: {{ section.settings.title_font_size_mobile }}px;
      {% endif %}
      line-height: 0.9;
      {% if section.settings.description != blank %}
       margin-bottom: 25px;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .price-comparison__description {
      {% if section.settings.description_font_size_mobile != blank %}
        font-size: {{ section.settings.description_font_size_mobile }}px;
      {% endif %}
    }

    .price-comparison__buttons-container {
      margin-top: 25px;
    }

    .price-comparison__info-block__container {
      width: unset;
    }

    .price-comparison__image-block {
      display: none;
    }

    #shopify-section-{{ section.id }} .price-comparison__table__title {
      font-size: {{ section.settings.title_column_font_size_mobile }}px;
    }

    .price-comparison__table__columns > .price-comparison__table__column {
      width: 76px;
    }

    .price-comparison__table__column > .price-comparison__table__title {
      min-width: 76px;
    }
    
    .price-comparison__table__body .price-comparison__table__column {
      padding: 11px;
    }

    .price-comparison__table__title {
      padding: 10px 5px;
    }

    .price-comparison__table__header, .price-comparison__table__body {
      gap: 10px;
    }

    .price-comparison__table__columns {
      gap: 10px;
    }

    .price-comparison__consclusion__block__images.image_block_1 {
      gap: 10px;
    }

    .price-comparison__table {
      gap: 11px;
    }

    .price-comparison__footnote {
      width: 75%;
      font-size: 20px;
    }

    .price-comparison__consclusion {
      gap: 10px;
      margin-top: 10px;
    }

    .price-comparison__consclusion__block {
      padding: 13px 16px;
    }

    #shopify-section-{{ section.id }} .price-comparison__consclusion__block.block_1 {
      font-size: {{ section.settings.block_1_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .price-comparison__consclusion__block.block_2 {
      font-size: {{ section.settings.block_2_font_size_mobile }}px;
      min-width: 162px;
      width: 162px;
      max-width: 162px;
    }

    .price-comparison__consclusion__block__images.image_block_2 {
      min-width: 162px;
      width: 162px;
      max-width: 162px;
    }

    .price-comparison__consclusion__toggle-button {
      font-size: 15px;
    }

    .price__additional-text {
      font-size: 12.5px;
    }
  }

  @media only screen and (max-width: 500px) {
    .price-comparison__table__column.fixed {
      min-width: 252px;
    }

    .price-comparison__table__columns.scrollable {
      overflow-x: auto;
      overflow-y: hidden;
      flex: 0 0 162px;
    }

    .price-comparison__tooltip-content {
      max-width: 200px;
      width: 200px;
      min-width: 200px;
      padding: 10px;
    }

    .price-comparison__tooltip-content__title, .price-comparison__tooltip-content__body { 
      font-size: 15px;
    }
  }

  @media only screen and (max-width: 475px) {
    .price-comparison__table__columns.scrollable {
      overflow-x: auto;
      overflow-y: hidden;
      flex: 0 0 100px;
    }

    #shopify-section-{{ section.id }} .price-comparison__consclusion__block.block_2 {
      max-width: 100px;
      min-width: 100px;
      word-wrap: break-word;
    }

    .price-comparison__consclusion__block__images.image_block_2 {
      max-width: 100px;
      min-width: 100px;
    }
  }

  @media only screen and (max-width: 350px) {
    .price-comparison__table__column.fixed {
      max-width: 200px;
        width: 200px;
        min-width: 200px;
    }
     .price-comparison__consclusion__block.block_1 {
      max-width: 200px;
      width: 200px;
      min-width: 200px;
    }
    .price-comparison__consclusion__block__images.image_block_1 {
      max-width: 200px;
      width: 200px;
      min-width: 200px;
    }
  }

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}

<section
  class="
    section
    {{ section.settings.css_class }}
    price-comparison
  "
>
  <div class="price-comparison__info-block">
    <div class="price-comparison__info-block__container">
      {% if section.settings.title != blank %}
        <h2 class="price-comparison__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="price-comparison__description">{{ section.settings.description }}</div>
      {% endif %}

      <div class="price-comparison__buttons-container">
        {% for block in section.blocks %}
          {% if block.type == 'button-block' %}
            {% if block.settings.button_label != blank %}
              {% style -%}
              .block-{{ block.id }}.price-comparison__button .button--custom {
                border: 1px solid;
                overflow-wrap: normal;
                padding: 19px 42px;
                font-size: 14px !important;
              }

              .block-{{ block.id }}.price-comparison__button .button--custom,
              .block-{{ block.id }}.price-comparison__button a.button--primary.button,
              .block-{{ block.id }}.price-comparison__button a.button--secondary.button  {
                border-radius: {{ block.settings.button_custom_border_radius | append: 'px' }};
              }

              .block-{{ block.id }}.price-comparison__button a.button--custom.button,
              .block-{{ block.id }}.price-comparison__button a.button--custom.button:link,
              .block-{{ block.id }}.price-comparison__button a.button--custom.button:visited {
                background-color: {{ block.settings.button_custom_bg_color }};
                color: {{ block.settings.button_custom_text_color }};
                border-color: {{ block.settings.button_custom_border_color }};
              }

              .block-{{ block.id }}.price-comparison__button a.button--custom.button:hover,
              .block-{{ block.id }}.price-comparison__button a.button--custom.button.is-hovered {
                color: {{ block.settings.button_custom_text_color--highlight }};
                border-color: {{ block.settings.button_custom_border_color--highlight }};
                background-color: {{ block.settings.button_custom_bg_color--highlight }};
              }

              .block-{{ block.id }}.price-comparison__button a.button--link-style.button {
                font-size: 13px !important;
              }

              .block-{{ block.id }}.price-comparison__button a.button--link-style.button,
              .block-{{ block.id }}.price-comparison__button a.button--link-style.button:visited {
                  color: {{ block.settings.button_custom_text_color }};
                  border-bottom: 1px dashed;
                  border-bottom-color: {{ block.settings.button_custom_border_color }};
              }

              .block-{{ block.id }}.price-comparison__button a.button--link-style.button:hover {
                  color: {{ block.settings.button_custom_text_color--highlight }};
                  border-bottom-color: {{ block.settings.button_custom_border_color--highlight }};
              }
          {% endstyle -%}

              <div class="price-comparison__button block-{{ block.id }}">
                <a href="{{ block.settings.button_link }}" class="button {{ block.settings.button_style }}">
                  {{ block.settings.button_label }}
                </a>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="price-comparison__image-block">
      {% if section.settings.image != nil %} 
        {%
          render 'image-element',
          image: section.settings.image,
          alt: section.settings.image.alt,
          additional_wrapper_classes: 'price-comparison__image'
        %}
      {% endif %}
    </div>
  </div>
  <div class="price-comparison__table">
    <div class="price-comparison__table__header">
      <div class="price-comparison__table__column fixed">
        <div class="price-comparison__table__title first">
          {{ section.settings.title_first_column }}
        </div>
      </div>
      <div class="price-comparison__table__columns scrollable">
        <div class="price-comparison__table__column">
          <div class="price-comparison__table__title second">
            {{ section.settings.title_second_column }}
          </div>
        </div>
        <div class="price-comparison__table__column">
          <div class="price-comparison__table__title third">
            {% if section.settings.image_third_column != blank %}
              {%
                render 'image-element',
                image: section.settings.image_third_column,
                alt: section.settings.image_third_column.alt,
                additional_wrapper_classes: 'price-comparison__table__title__image'
              %}
            {% else %}
              {{ section.settings.title_third_column }}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <div class="price-comparison__table__body">
       
      <div class="price-comparison__table__column fixed first">
        {% for block in rows %}
         
            {% style %}
                .block-{{ block.id }}.price-comparison__table__cell {
                  font-size: {{ block.settings.cell_font_size }}px;
                  line-height: 1.1;
                  padding: 10px 0;
                }
              
                .block-{{ block.id }}.price-comparison__table__cell.first {
                  border-bottom: 1px solid {{ section.settings.text_color_first_column }};
                }

                .block-{{ block.id }}.price-comparison__table__cell.first:last-child {
                  border-bottom: unset;
                }

                @media only screen and (max-width: 798px) {
                  .block-{{ block.id }}.price-comparison__table__cell {
                    font-size: {{ block.settings.cell_font_size_mobile }}px;
                  }
                }
              {% endstyle %}
            {% if  block.settings.first_cell != blank %}
              <div class="
                price-comparison__table__cell block-{{ block.id }} first row-{{ forloop.index }}
                {% if forloop.index > limit_to_show and forloop.index != last_item %}
                      price-comparison__extra-content 
                  {% endif %}
              ">{{ block.settings.first_cell }}</div>
            {% endif %}
          
        {% endfor %}
      </div>
      <div class="price-comparison__table__columns scrollable">
        <div class="price-comparison__table__column second">
          {% for block in rows %}
           
              {% style %}
                .block-{{ block.id }}.price-comparison__table__cell.second {
                  border-bottom: 1px solid {{ section.settings.text_color_second_column }};
                  {% if block.settings.second_cell_info != blank %}
                    cursor: pointer;
                    transition: transform 0.3s ease;
                  {% endif %}
                }
                .block-{{ block.id }}.price-comparison__table__cell.second:hover {
                  {% if block.settings.second_cell_info != blank %}
                    transform: scale(1.05);
                  {% endif %}
                }
                .block-{{ block.id }}.price-comparison__table__cell.second:last-child {
                  border-bottom: unset;
                }
              {% endstyle %}
              {% if  block.settings.second_cell != blank %}
                <div class="
                  price-comparison__table__cell block-{{ block.id }} second row-{{ forloop.index }}
                  {% if forloop.index > limit_to_show and forloop.index != last_item %}
                      price-comparison__extra-content 
                    {% endif %}
                  ">
                  {% if block.settings.second_cell_info != blank %}
                  <div class="price-comparison__tooltip-container">
                    <div class="price-comparison__tooltip-trigger" data-tooltip-id="tooltip-{{ block.id }}">
                      {{ block.settings.second_cell }}
                    </div>
                    <div id="tooltip-{{ block.id }}" class="price-comparison__tooltip-content">
                      <div class="price-comparison__tooltip-content__title">{{ block.settings.second_cell_info_title }}</div>
                      <div class="price-comparison__tooltip-content__body">{{ block.settings.second_cell_info }}</div>
                    </div>
                  </div>
                  {% else %}
                    {{ block.settings.second_cell }}
                  {% endif %}
                </div>
              {% else %}
                <div class="
                  price-comparison__table__cell block-{{ block.id }} second row-{{ forloop.index }}
                  {% if forloop.index > limit_to_show and forloop.index != last_item %}
                      price-comparison__extra-content 
                    {% endif %}
                  ">
                  {% if block.settings.second_cell_info != blank %}
                  <div class="price-comparison__tooltip-container">
                    <div class="price-comparison__tooltip-trigger" data-tooltip-id="tooltip-{{ block.id }}">
                      {% if block.settings.second_cell_image != nil %}
                      {%
                        render 'image-element',
                        image: block.settings.second_cell_image,
                        alt: block.settings.second_cell_image.alt,
                        additional_wrapper_classes: 'price-comparison__table__cell__image'
                      %}
                      {% endif %}
                    </div>
                    <div id="tooltip-{{ block.id }}" class="price-comparison__tooltip-content">
                      <div class="price-comparison__tooltip-content__title">{{ block.settings.second_cell_info_title }}</div>
                      <div class="price-comparison__tooltip-content__body">{{ block.settings.second_cell_info }}</div>
                    </div>
                  </div>
                  {% else %}
                    {% if block.settings.second_cell_image != nil %}
                      {%
                        render 'image-element',
                        image: block.settings.second_cell_image,
                        alt: block.settings.second_cell_image.alt,
                        additional_wrapper_classes: 'price-comparison__table__cell__image'
                      %}
                      {% endif %}
                  {% endif %}
                  
                </div>
              {% endif %}
           
          {% endfor %}
        </div>
        <div class="price-comparison__table__column third">
          {% for block in rows %}
              {% style %}
                .block-{{ block.id }}.price-comparison__table__cell.third {
                  border-bottom: 1px solid {{ section.settings.text_color_third_column }};
                }
                .block-{{ block.id }}.price-comparison__table__cell.third:last-child {
                  border-bottom: unset;
                }
              {% endstyle %}
              {% if  block.settings.third_cell != blank %}
                <div 
                class="
                    price-comparison__table__cell block-{{ block.id }} third row-{{ forloop.index }}
                    {% if forloop.index > limit_to_show and forloop.index != last_item %}
                      price-comparison__extra-content 
                    {% endif %}
                  "
                  >
                  {{ block.settings.third_cell }}
                </div>
              {% else %}
                <div class="
                  price-comparison__table__cell block-{{ block.id }} third row-{{ forloop.index }}
                  {% if forloop.index > 10 and forloop.index != last_item %}
                      price-comparison__extra-content 
                  {% endif %}
                ">
                  {% if block.settings.third_cell_image != nil %}
                  {%
                    render 'image-element',
                    image: block.settings.third_cell_image,
                    alt: block.settings.third_cell_image.alt,
                    additional_wrapper_classes: 'price-comparison__table__cell__image'
                  %}
                  {% endif %}
                </div>
              {% endif %}
            
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  <button class="price-comparison__consclusion__toggle-button" id="price-toggle-button">
        Show More ▼
    </button>
  {% if section.settings.bottom_image_1 != nil or section.settings.bottom_image_2 != nil or section.settings.bottom_image_3 != nil %}
    <div class="price-comparison__consclusion">
      <div class="price-comparison__consclusion__block__images image_block_1">
        {% if section.settings.bottom_image_1 != nil %}
          {%
            render 'image-element',
            image: section.settings.bottom_image_1,
            alt: section.settings.bottom_image_1.alt,
            additional_wrapper_classes: 'price-comparison__consclusion__block__image'
          %}
        {% endif %}
        {% if section.settings.bottom_image_2 != nil %}
          {%
            render 'image-element',
            image: section.settings.bottom_image_2,
            alt: section.settings.bottom_image_2.alt,
            additional_wrapper_classes: 'price-comparison__consclusion__block__image'
          %}
        {% endif %}
      </div>
      <div class="price-comparison__consclusion__block__images image_block_2">
        {% if section.settings.bottom_image_3 != nil %}
          {%
            render 'image-element',
            image: section.settings.bottom_image_3,
            alt: section.settings.bottom_image_3.alt,
            additional_wrapper_classes: 'price-comparison__consclusion__block__image'
          %}
        {% endif %}
      </div>
    </div>
  {% endif  %}
  {% if section.settings.block_1 != null or section.settings.block_2 != null %}
    <div class="price-comparison__consclusion">
      {% if section.settings.block_1 != null %}
        <div class="price-comparison__consclusion__block block_1">
          <div>{{ section.settings.block_1 }}</div>
        </div>
      {% endif %}
      {% if section.settings.block_2 != null %}
        <div class="price-comparison__consclusion__block block_2">
          <div>{{ section.settings.block_2 }}</div>
        </div>
      {% endif %}
    </div>
  {% endif %}
  {% if section.settings.footnote %}
    <div class="price-comparison__footnote">
      {{ section.settings.footnote }}
    </div>
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const rowsLength = {{ rows.size }};
    for(let i = 1; i <= rowsLength; i++) {
      const rowElements = document.getElementsByClassName(`price-comparison__table__cell row-${i}`);
      let maxHeight = 0;
      for (const element of rowElements) {
        const elementHeight = element.clientHeight;
        if (elementHeight > maxHeight) {
          maxHeight = elementHeight;
        }
      }
      for (const element of rowElements) {
        element.style.height = `${maxHeight}px`;
        if (element.classList.contains("price-comparison__extra-content")) {
          element.classList.add("price-comparison__hidden");
          element.style.display = "none;"
        }
      }
    }

    const headerScrollable = document.querySelector('.price-comparison__table__header .price-comparison__table__columns.scrollable');
    const bodyScrollable = document.querySelector('.price-comparison__table__body .price-comparison__table__columns.scrollable');

    if (headerScrollable && bodyScrollable) {
      const syncScroll = (source, target) => {
        source.addEventListener('scroll', () => {
          target.scrollLeft = source.scrollLeft;
        });
      };

      syncScroll(headerScrollable, bodyScrollable);
      syncScroll(bodyScrollable, headerScrollable);
    }
    
  const triggers = document.querySelectorAll('.price-comparison__tooltip-trigger');

  triggers.forEach(trigger => {
    const tooltipId = trigger.getAttribute('data-tooltip-id');
    const tooltip = document.getElementById(tooltipId);

    trigger.addEventListener('mouseenter', () => {
      if (tooltip) {
        const rect = trigger.getBoundingClientRect();

        document.body.appendChild(tooltip);

        tooltip.style.position = 'absolute';
        tooltip.style.top = `${rect.bottom + window.scrollY}px`;
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.style.transform = 'translateX(-70%)';
        tooltip.classList.add('visible');
      }
    });

    trigger.addEventListener('mouseleave', () => {
      if (tooltip) {
        tooltip.classList.remove('visible');
      }
    });
  });

  function toggleContent() {
    var content = document.querySelectorAll(".price-comparison__extra-content");
    var button = document.getElementById("price-toggle-button");
    var downIcon = document.querySelector('[data-icon="down-caret"]');
    var upIcon = document.querySelector('[data-icon="up-caret"]');


      for (const item of content) {
        if (item.classList.contains("price-comparison__hidden")) {
          item.classList.remove("price-comparison__hidden");
          button.innerHTML = "Show Less ▲";
        } else {
          item.classList.add("price-comparison__hidden");
          button.innerHTML = "Show More ▼";
        }
      };
  }

  const toggleButton = document.getElementById("price-toggle-button");
  toggleButton.addEventListener("click", () => {
    toggleContent()
  });

  })
</script>

