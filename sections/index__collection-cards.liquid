{% assign top_collections = section.blocks | where: 'type', 'top_collection' %}
{% assign first_collections = section.blocks | where: 'type', 'collection' %}
{% assign second_collections = section.blocks | where: 'type', 'collection_2' %}
{% assign filters = section.blocks | where: 'type', 'filter' %}
{% assign top_collection_filter_param_name = "top_collection_filter" %}
{% assign collection_filter_param_name = "collection_filter" %}
{% assign collection_2_filter_param_name = "collection_2_filter" %}



{%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
{%- assign parts = contentForQuerystring
| split: '"pageurl":"'
| last
| split: '"'
| first
| split: '://'
| last
| split: '/'
-%}
{% if parts.size > 1 %}
{%- assign domain_removed_parts = parts | slice: 1, parts.size -%}
{%- assign finalurl = domain_removed_parts | join: '/' | prepend: '/' -%}
{% else %}
{%- assign finalurl = "/" -%}
{% endif %}

{%- assign finalurl = finalurl
| replace: '\/', '/'
| replace: '%20', ' '
| replace: '\u0026', '&'
-%}

{% assign url = finalurl %}
{% assign current_url = page.url %}
{% assign query_string = url | replace_first: current_url, "" %}
{% assign query_key = query_string | split: "?" | last | split: "=" | first %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
   #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .hidden { display: none; }

  .collection-cards__list__card {
    border-radius: 10px;

    position: relative;
  }

  .collection-cards__top_collection_list {
    display: grid;
    grid-template-columns: repeat({{ section.settings.top_collections_per_row }}, 1fr);
    column-gap: 48px; 
    row-gap: 45px; 
  } 

  .collection-cards__list__card__content {
    position: relative;
  }

  .collection-cards__list__card__content__info {
    border-radius: 8px;

    position: absolute;
    width: calc(100% - 20px);
    bottom: 0;
  }

  .collection-cards__list__card__content__image > .custom-image-element__wrap > img {
    object-fit: cover;
    border-radius: 10px;
  }

  .collection-cards__list__card__content__info__title_block {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .collection-cards__list__card__content__info__title_block .icon {
    width: 21px;
    height: 21px;
  }

  .collection-cards__collection_list {
    display: grid;
    grid-template-columns: repeat({{ section.settings.collections_per_row }}, 1fr);
    column-gap: 35px; 
    row-gap: 45px; 
  } 

  .collection-cards__filter {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 15px;
    margin-bottom: 56px;
  }

  .collection-cards__filter__title, .collection-cards__filter__item {
    font-size: 14px;
  }

  .collection-cards__filter__item {
    padding: 15px 30px;
    border-radius: 58px;
    cursor: pointer;
    text-align: center;
  }

  .collection-cards__filter__container {
    display: flex;
    gap: 20px;
  }

  
  @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .collection-cards__top_collection_list {
      display: flex;
      align-items: stretch; 
      justify-content: space-between;

      column-gap: 30px;
      grid-template-columns: unset;
    }

    .top_collection__card {
      width: {{ section.settings.top_collection_card_width_mobile }}px;
      height: {{ section.settings.top_collection_card_height_mobile }}px;

      margin-right: 30px;
    }

    .collection-cards__list__card__content__info {
      width: calc(100% - 14px);
    }

     .collection-cards__list__card__content__info__title_block .icon {
      width: 14px;
      height: 14px;
    }

    .collection-cards__list__card__opacity {
      display: none;
    }

    button.flickity-button.flickity-prev-next-button.previous, button.flickity-button.flickity-prev-next-button.next {
      display: none;
    }

    .collection-cards__top_collection_list__nav-buttons__next, .collection-cards__top_collection_list__nav-buttons__prev {
      border: none;
      background: none;
      padding: 0;
      color: #3F4444;
    }

    .collection-cards__top_collection_list__nav-buttons__next > .icon, .collection-cards__top_collection_list__nav-buttons__prev > .icon {
      width: 21px;
      height: 21px;
    }

    .collection-cards__top_collection_list__nav-buttons {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 28px;
      {% if first_collections.size > 0 %}
        margin-bottom: 28px;
      {% endif %}
    }

    .collection-cards__collection_list {
       display: flex;
      align-items: stretch; 
      justify-content: space-between;

      grid-template-columns: unset;
    }

    .collection__card {
      width: {{ section.settings.collection_card_width_mobile }}px;
      height: {{ section.settings.collection_card_height_mobile }}px;

      margin-right: 35px;
    }

    .without-margin-bottom {
      margin-bottom: unset;
    }

    .collection-cards__filter {
      flex-direction: column;
      margin-bottom: 50px;
      gap: 14px;
    }

    .collection-cards__filter__container  {
      gap: 10px;
    }

    .collection-cards__filter__item {
      padding: 8px 20px;
    }
  }

  @media only screen and (max-width: 375px) {
    .collection-cards__filter__container {
      flex-wrap: wrap;
    }
  }

   @media only screen and (min-width: 799px){
    .collection-cards__list__card__content__image {
      transition: flex 0.3s ease, transform 0.3s ease;
     overflow: hidden;
     flex-shrink: 1; 
    }

  .collection-cards__list__card__opacity {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    top: 0;

    background-color: rgba(0, 0, 0, 0.2); 
    transition: background-color 0.3s ease; 
  }

  .collection-cards__list__card:hover .collection-cards__list__card__opacity {
    background-color: rgba(0, 0, 0, 0); 
  }

   .collection-cards__list__card:hover .collection-cards__list__card__content__image {
    transform: scale(1.05);
  }

  .collection-cards__top_collection_list {
    {% if first_collections.size > 0 %}
    margin-bottom: 45px;
    {% endif %}
  }
}
  
  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}

<section
  class="
    section
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
  "
>
  {% if filters.size == 1 %}
    {% assign filter = filters.first.settings %}
    {% style %}
      .collection-cards__filter {
        border-top: 1px solid {{ filters.settings.border_color }};
        border-bottom: 1px solid {{ filters.settings.border_color }};
      }
    {% endstyle %}
    <div class="collection-cards__filter">
      <div class="collection-cards__filter__title">
        Filters
      </div>
      <div class="collection-cards__filter__container">
        {% if filter.top_collection_filter_name != blank %}
          {% style %}
            .collection-cards__filter__item.top_collection {
              background-color: {{ filter.top_collection_background_color }};
              color: {{ filter.top_collection_text_color }};
            }
            .collection-cards__filter__item.top_collection:hover {
              background-color: {{ filter.top_collection_background_color | color_modify: 'alpha', 0.85}};
            }
          {% endstyle %}
          <a 
              href="{{ page.url }}?{{ top_collection_filter_param_name }}={{ filter.top_collection_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: ","}}" 
          >
            <div class="collection-cards__filter__item top_collection">
               {{ filter.top_collection_filter_name }}
            </div>
          </a>
        {% endif %}
        {% if filter.collection_filter_name != blank %}
           {% style %}
              .collection-cards__filter__item.collection {
                background-color: {{ filter.collection_filter_background_color }};
                color: {{ filter.collection_filter_text_color }};
              }
             .collection-cards__filter__item.collection:hover {
                background-color: {{ filter.collection_filter_background_color | color_modify: 'alpha', 0.85}};
              }
            {% endstyle %}
           <a 
              href="{{ page.url }}?{{ collection_filter_param_name }}={{ filter.collection_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: ","}}" 
            >
              <div class="collection-cards__filter__item collection">
               {{ filter.collection_filter_name }}
              </div>
          </a>
        {% endif %}
        {% if filter.collection_2_filter_name != blank %}
          {% style %}
              .collection-cards__filter__item.collection_2 {
                background-color: {{ filter.collection_2_filter_background_color }};
                color: {{ filter.collection_2_filter_text_color }};
              }
            .collection-cards__filter__item.collection_2:hover {
                background-color: {{ filter.collection_2_filter_background_color | color_modify: 'alpha', 0.85}};
              }
            {% endstyle %}
            <a 
              href="{{ page.url }}?{{ collection_2_filter_param_name }}={{ filter.collection_2_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: ","}}" 
            >
              <div class="collection-cards__filter__item collection_2">
               {{ filter.collection_2_filter_name }}
              </div>
          </a>
        {% endif %}
        {% if filter.reset_filter_name != blank %}
          {% style %}
              .collection-cards__filter__item.reset {
                background-color: {{ filter.reset_filter_background_color }};
                color: {{ filter.reset_filter_text_color }};
              }
            .collection-cards__filter__item.reset:hover {
                background-color: {{ filter.reset_filter_background_color | color_modify: 'alpha', 0.85}};
              }
            {% endstyle %}
          {% if filter.reset_filter_url != blank %}
            <a 
              href="{{ filter.reset_filter_url }}" 
            >
              <div class="collection-cards__filter__item reset">{{ filter.reset_filter_name }}</div>
            </a>
          {% else %}
            <a 
              href="{{ page.url }}" 
            >
              <div class="collection-cards__filter__item reset">{{ filter.reset_filter_name }}</div>
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  {% endif %}
  <div class="collection-cards__lists">

    {% if top_collections.size > 0 %}
      <div id="collection-cards__top_collection_list" class="collection-cards__top_collection_list carousel-{{ section.id }}-top_collection">
        {% for top_collection in top_collections %}
          {% assign top_collection_card = top_collection.settings %}
          {% assign collection_details = collections[top_collection_card.top_collection]  %}

          {%- style -%}
            .card-{{ top_collection.id }} .collection-cards__list__card__content__info {
              padding: 21px;
              margin: 10px;
              color: {{ top_collection_card.text_color }};
              background: {{ top_collection_card.background_color }};
              height: 30%;
            }

            .card-{{ top_collection.id }} .collection-cards__list__card__content__info__heading {
              color: {{ top_collection_card.text_color }};
              font-size: {{ top_collection_card.heading_font_size }}px;
              font-weight: 900;
              line-height: 1.1;
            }

            .card-{{ top_collection.id }} .collection-cards__list__card__content__image {
              height: {{ section.settings.top_collection_card_height }}px;
            }

            .card-{{ top_collection.id }} .collection-cards__list__card__content__info__description {
              font-size: {{ top_collection_card.description_font_size }}px;
              line-height: 1.1;
              margin-top: {{ top_collection_card.heading_font_size }}px;
            }

            @media only screen and (max-width: 1024px) {
              .card-{{ top_collection.id }} .collection-cards__list__card__content__info {
                height: 35%;
              }
            }

            @media only screen and (max-width: 798px) {
              .card-{{ top_collection.id }} .collection-cards__list__card__content__image {
                width: {{ section.settings.top_collection_card_width_mobile }}px;
                height: {{ section.settings.top_collection_card_height_mobile }}px;
              }

              .card-{{ top_collection.id }} .collection-cards__list__card__content__info__heading {
                font-size: {{ top_collection_card.heading_font_size_mobile }}px;
              }

              .card-{{ top_collection.id }} .collection-cards__list__card__content__info__description {
                font-size: {{ top_collection_card.description_font_size_mobile }}px;
                margin-top: {{ top_collection_card.heading_font_size_mobile }}px;
              }

              .card-{{ top_collection.id }} .collection-cards__list__card__content__info {
                padding: 15px;
                margin: 7px;
              }

              .card-{{ top_collection.id }} .collection-cards__list__card__content__info {
                height: 30%;
              }
            }
          {%- endstyle -%}
          {% if top_collection_card.image != nil %}
            <div class="card-{{ top_collection.id }} collection-cards__list__card top_collection__card carousel-cell {{ top_collection_card.filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: ","}}">
              <a class="collection-cards__lists__link" href="{{ collection_details.url }}">
                <div class="collection-cards__list__card__content">
                  <div class="collection-cards__list__card__content__image">
                    {%
                      render 'image-element',
                      image: top_collection_card.image.src,
                      alt: top_collection_card.image.alt,
                      stretch_width: true,
                      object_fit: true
                    %}
                  </div>
                  {% if top_collection_card.heading != blank %}
                  <div class="collection-cards__list__card__content__info"> 
                    <div class="collection-cards__list__card__content__info__title_block">
                     <h2 class="collection-cards__list__card__content__info__heading">{{ top_collection_card.heading }}</h2>
                      <div class="collection-cards__list__card__content__info__icons">
                        {% render 'icon', name: 'read-more-left-arrow' %}
                        {% render 'icon', name: 'read-more-left-arrow' %}
                        {% render 'icon', name: 'read-more-left-arrow' %}
                      </div>
                    </div>
                    {% if top_collection_card.description != blank %}
                    <p class="collection-cards__list__card__content__info__description">{{ top_collection_card.description }}</p>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="collection-cards__list__card__opacity"></div>
                </div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>

     
      <div
        id="collection-cards__top_collection_list__nav-buttons"
        class="
       collection-cards__top_collection_list__nav-buttons
       is-hidden-desktop-only
       ">
        <button class="collection-cards__top_collection_list__nav-buttons__prev collection-cards__top_collection_list__nav-buttons__prev-{{ section.id }}">
          {% render 'icon', name: 'slider-left-arrow' %}  
        </button>
        <button class="collection-cards__top_collection_list__nav-buttons__next collection-cards__top_collection_list__nav-buttons__next-{{ section.id }}">
          {% render 'icon', name: 'slider-right-arrow' %} 
        </button>
      </div>
      
    {% endif %}

    {% if first_collections.size > 0 %}
      <div 
        id="collection-cards__other_collection_list"
        class="collection-cards__collection_list carousel-{{ section.id }}-collection first-collection">
          
        {% for collection in first_collections %}
          {% assign collection_card = collection.settings %}
          {% assign first_collection_details = collections[collection_card.collection]  %}

          {%- style -%}
            .card-{{ collection.id }} .collection-cards__list__card__content__info {
              padding: 14px;
              margin: 8px;
              color: {{ collection_card.text_color }};
              background: {{ collection_card.background_color }};
              height: 38%;
            }

            .card-{{ collection.id }} .collection-cards__list__card__content__info__heading {
              color: {{ collection_card.text_color }};
              font-size: {{ collection_card.heading_font_size }}px;
              font-weight: 900;
              line-height: 1.1;
            }

            .card-{{ collection.id }} .collection-cards__list__card__content__image {
              height: {{ section.settings.collection_card_height }}px;
            }

            .card-{{ collection.id }} .collection-cards__list__card__content__info__description {
              font-size: {{ collection_card.description_font_size }}px;
              line-height: 1.1;
              margin-top: {{ collection_card.heading_font_size }}px;
            }

            @media only screen and (max-width: 1024px) {
              .card-{{ collection.id }} .collection-cards__list__card__content__info {
                height: 47%;
              }
            }

            @media only screen and (max-width: 798px) {
              .card-{{ collection.id }} .collection-cards__list__card__content__image {
                width: {{ section.settings.collection_card_width_mobile }}px;
                height: {{ section.settings.collection_card_height_mobile }}px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info__heading {
                font-size: {{ collection_card.heading_font_size_mobile }}px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info__description {
                font-size: {{ top_collection_card.description_font_size_mobile }}px;
                margin-top: {{ top_collection_card.heading_font_size_mobile }}px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info {
                padding: 15px;
                margin: 7px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info {
                height: 36%;
              }
            }
          {%- endstyle -%}

          {% if collection_card.image != nil %}
            <div class="card-{{ collection.id }} collection-cards__list__card collection__card carousel-cell {{ collection_card.filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: ","}}">
              <a class="collection-cards__lists__link" href="{{ first_collection_details.url }}">
                <div class="collection-cards__list__card__content">
                  <div class="collection-cards__list__card__content__image">
                    {%
                      render 'image-element',
                      image: collection_card.image.src,
                      alt: collection_card.image.alt,
                      stretch_width: true,
                      object_fit: true
                    %}
                  </div>
                  {% if collection_card.heading != blank %}
                  <div class="collection-cards__list__card__content__info"> 
                    <div class="collection-cards__list__card__content__info__title_block">
                     <h2 class="collection-cards__list__card__content__info__heading">{{ collection_card.heading }}</h2>
                    </div>
                    {% if collection_card.description != blank %}
                    <p class="collection-cards__list__card__content__info__description">{{ collection_card.description }}</p>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="collection-cards__list__card__opacity"></div>
                </div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
        
        {% if second_collections.size > 0 %}
          {% for second_collection in second_collections %}
            {% assign second_collection_card = second_collection.settings %}
            {% assign second_collection_details = collections[second_collection_card.collection]  %}

            {%- style -%}
              .card-{{ second_collection.id }} .collection-cards__list__card__content__info {
                padding: 14px;
                margin: 8px;
                color: {{ second_collection_card.text_color }};
                background: {{ second_collection_card.background_color }};
                height: 38%;
              }

              .card-{{ second_collection.id }} .collection-cards__list__card__content__info__heading {
                color: {{ second_collection_card.text_color }};
                font-size: {{ second_collection_card.heading_font_size }}px;
                font-weight: 900;
                line-height: 1.1;
              }

              .card-{{ second_collection.id }} .collection-cards__list__card__content__image {
                height: {{ section.settings.collection_card_height }}px;
              }

              .card-{{ second_collection.id }} .collection-cards__list__card__content__info__description {
                font-size: {{ second_collection_card.description_font_size }}px;
                line-height: 1.1;
                margin-top: {{ second_collection_card.heading_font_size }}px;
              }

              @media only screen and (max-width: 1024px) {
                .card-{{ second_collection.id }} .collection-cards__list__card__content__info {
                  height: 47%;
                }
            }
          {%- endstyle -%}

          {% if second_collection_card.image != nil %}
            <div class="card-{{ second_collection.id }} collection-cards__list__card collection__card is-hidden-mobile-only {{ second_collection_card.filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: ","}}">
              <a class="collection-cards__lists__link" href="{{ second_collection_details.url }}">
                <div class="collection-cards__list__card__content">
                  <div class="collection-cards__list__card__content__image">
                    {%
                      render 'image-element',
                      image: second_collection_card.image.src,
                      alt: second_collection_card.image.alt,
                      stretch_width: true,
                      object_fit: true
                    %}
                  </div>
                  {% if second_collection_card.heading != blank %}
                  <div class="collection-cards__list__card__content__info"> 
                    <div class="collection-cards__list__card__content__info__title_block">
                     <h2 class="collection-cards__list__card__content__info__heading">{{ second_collection_card.heading }}</h2>
                    </div>
                    {% if second_collection_card.description != blank %}
                    <p class="collection-cards__list__card__content__info__description">{{ second_collection_card.description }}</p>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="collection-cards__list__card__opacity"></div>
                </div>
              </a>
            </div>
          {% endif %}
          {% endfor %}
        {% endif %}
        {%comment %}
          {% endif %}
        {% endcomment %}
        
      </div>

      <div
        id="collection-cards__collection_list__nav-buttons"
        class="
       collection-cards__top_collection_list__nav-buttons
       is-hidden-desktop-only
       ">
        <button class="collection-cards__top_collection_list__nav-buttons__prev collection-cards__collection_list__nav-buttons__prev-{{ section.id }}">
          {% render 'icon', name: 'slider-left-arrow' %}  
        </button>
        <button class="collection-cards__top_collection_list__nav-buttons__next collection-cards__collection_list__nav-buttons__next-{{ section.id }}">
          {% render 'icon', name: 'slider-right-arrow' %} 
        </button>
      </div>

        
    {% endif %}

    
    {% if second_collections.size > 0 %}
      <div id="collection-cards__2_collection_list" class="collection-cards__collection_list carousel-{{ section.id }}-collection-2">
        {% for collection in second_collections %}
          {% assign collection_card = collection.settings %}
          {% assign first_collection_details = collections[collection_card.collection]  %}

          {%- style -%}
            .card-{{ collection.id }} .collection-cards__list__card__content__info {
              padding: 14px;
              margin: 8px;
              color: {{ collection_card.text_color }};
              background: {{ collection_card.background_color }};
              height: 38%;
            }

            .card-{{ collection.id }} .collection-cards__list__card__content__info__heading {
              color: {{ collection_card.text_color }};
              font-size: {{ collection_card.heading_font_size }}px;
              font-weight: 900;
              line-height: 1.1;
            }

            .card-{{ collection.id }} .collection-cards__list__card__content__image {
              height: {{ section.settings.collection_card_height }}px;
            }

            .card-{{ collection.id }} .collection-cards__list__card__content__info__description {
              font-size: {{ collection_card.description_font_size }}px;
              line-height: 1.1;
              margin-top: {{ collection_card.heading_font_size }}px;
            }

            @media only screen and (max-width: 1024px) {
              .card-{{ collection.id }} .collection-cards__list__card__content__info {
                height: 47%;
              }
            }

            @media only screen and (max-width: 798px) {
              .card-{{ collection.id }} .collection-cards__list__card__content__image {
                width: {{ section.settings.collection_card_width_mobile }}px;
                height: {{ section.settings.collection_card_height_mobile }}px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info__heading {
                font-size: {{ collection_card.heading_font_size_mobile }}px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info__description {
                font-size: {{ top_collection_card.description_font_size_mobile }}px;
                margin-top: {{ top_collection_card.heading_font_size_mobile }}px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info {
                padding: 15px;
                margin: 7px;
              }

              .card-{{ collection.id }} .collection-cards__list__card__content__info {
                height: 36%;
              }
            }
          {%- endstyle -%}

          {% if collection_card.image != nil %}
            <div class="card-{{ collection.id }} collection-cards__list__card collection__card carousel-cell is-hidden-desktop-only {{ collection_card.filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: ","}}">
              <a class="collection-cards__lists__link" href="{{ first_collection_details.url }}">
                <div class="collection-cards__list__card__content">
                  <div class="collection-cards__list__card__content__image">
                    {%
                      render 'image-element',
                      image: collection_card.image.src,
                      alt: collection_card.image.alt,
                      stretch_width: true,
                      object_fit: true
                    %}
                  </div>
                  {% if collection_card.heading != blank %}
                  <div class="collection-cards__list__card__content__info"> 
                    <div class="collection-cards__list__card__content__info__title_block">
                     <p class="collection-cards__list__card__content__info__heading">{{ collection_card.heading }}</p>
                    </div>
                    {% if collection_card.description != blank %}
                    <p class="collection-cards__list__card__content__info__description">{{ collection_card.description }}</p>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="collection-cards__list__card__opacity"></div>
                </div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
