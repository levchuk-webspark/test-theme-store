<script>
  document.addEventListener('DOMContentLoaded', function() {
    const isMobileMedia = window.matchMedia("(max-width: 798px)");
    if (isMobileMedia.matches) {
      const topCollectionsListCarousel = document.querySelector('.carousel-{{ section.id }}-top_collection');
        if (topCollectionsListCarousel) {
            const topCollectionsListFlickity = new Flickity( topCollectionsListCarousel, {
                cellAlign: 'left',
                contain: true,
                groupCells: true,
                wrapAround: true,
                pageDots: false
            });

          const topCollectionsListPrevButton = document.querySelector('.collection-cards__top_collection_list__nav-buttons__prev-{{ section.id }}');
          const topCollectionsListNextButton = document.querySelector('.collection-cards__top_collection_list__nav-buttons__next-{{ section.id }}');
        
            if (topCollectionsListPrevButton) {
              topCollectionsListPrevButton.addEventListener( 'click', function() {
                topCollectionsListFlickity.previous();
              });
            }
        
            if (topCollectionsListNextButton) {
             topCollectionsListNextButton.addEventListener( 'click', function() {
                topCollectionsListFlickity.next( );
              });
            }
        }

      const collectionsListCarousel = document.querySelector('.carousel-{{ section.id }}-collection');
        if (collectionsListCarousel) {
            const collectionsListFlickity = new Flickity( collectionsListCarousel, {
                cellAlign: 'left',
                contain: true,
                groupCells: true,
                wrapAround: true,
                pageDots: false
            });

          const collectionsListPrevButton = document.querySelector('.collection-cards__collection_list__nav-buttons__prev-{{ section.id }}');
          const collectionsListNextButton = document.querySelector('.collection-cards__collection_list__nav-buttons__next-{{ section.id }}');
        
            if (collectionsListPrevButton) {
              collectionsListPrevButton.addEventListener( 'click', function() {
                collectionsListFlickity.previous();
              });
            }
        
            if (collectionsListNextButton) {
             collectionsListNextButton.addEventListener( 'click', function() {
                collectionsListFlickity.next( );
              });
            }
        }

      const collectionsListSecondCarousel = document.querySelector('.carousel-{{ section.id }}-collection-2');
        if (collectionsListSecondCarousel) {
            const collectionsListSecondFlickity = new Flickity( collectionsListSecondCarousel, {
                cellAlign: 'left',
                contain: true,
                groupCells: true,
                wrapAround: true,
                pageDots: false
            });

          const collectionsListSecondPrevButton = document.querySelector('.collection-cards__collection_list__nav-buttons__prev-{{ section.id }}-2');
          const collectionsListSecondNextButton = document.querySelector('.collection-cards__collection_list__nav-buttons__next-{{ section.id }}-2');
        
            if (collectionsListSecondPrevButton) {
              collectionsListSecondPrevButton.addEventListener( 'click', function() {
                collectionsListSecondFlickity.previous();
              });
            }
        
            if (collectionsListSecondNextButton) {
             collectionsListSecondNextButton.addEventListener( 'click', function() {
                collectionsListSecondFlickity.next( );
              });
            }
        }
    }
  })
</script>
<script>
    var urlParams = new URLSearchParams(window.location.search);
    var topCollectionFilterParam = urlParams.get('{{ top_collection_filter_param_name }}');
    var collectionFilterParam = urlParams.get('{{ collection_filter_param_name }}');
    var collection2FilterParam = urlParams.get('{{ collection_2_filter_param_name }}');
    const isMobileMedia = window.matchMedia("(max-width: 798px)");

  if (topCollectionFilterParam) {
    //Show top collection
    document.getElementById("collection-cards__top_collection_list").classList.remove("hidden");
    //Hide other collection
    document.getElementById("collection-cards__other_collection_list").classList.add("hidden");
    if (isMobileMedia.matches) {
      //Second collection navigation
      document.getElementById("collection-cards__2_collection_list").classList.add("hidden");
      document.getElementById("collection-cards__2_collection_list__nav-buttons").classList.add("hidden");
      //First collection navigation
      document.getElementById("collection-cards__collection_list__nav-buttons").classList.add("hidden"); 
    }
  } else if (collectionFilterParam) {
    //Show other collection
    document.getElementById("collection-cards__other_collection_list").classList.remove("hidden");
    //Hide top collection
    document.getElementById("collection-cards__top_collection_list").classList.add("hidden");
     if (isMobileMedia.matches) {
      //Second collection navigation
      document.getElementById("collection-cards__2_collection_list").classList.add("hidden");
      document.getElementById("collection-cards__2_collection_list__nav-buttons").classList.add("hidden");
      //Top collection navigation
      document.getElementById("collection-cards__top_collection_list__nav-buttons").classList.add("hidden"); 
    } else {
      var otherCollectionList = document.getElementById('collection-cards__other_collection_list');
      var childElementsOtherCollectionList = otherCollectionList.children;
      Array.from(childElementsOtherCollectionList).forEach(child => {
        if (!child.classList.contains(collectionFilterParam)) {
          child.classList.add("hidden");
        }
      });
    }
  } else if (collection2FilterParam) {
    //Show 2 collection
    document.getElementById("collection-cards__2_collection_list").classList.remove("hidden");
    document.getElementById("collection-cards__2_collection_list__nav-buttons").classList.remove("hidden");
    //Hide other collection
    //Hide top collection
    document.getElementById("collection-cards__top_collection_list").classList.add("hidden");
    if (isMobileMedia.matches) {
      //First collection navigation
      document.getElementById("collection-cards__other_collection_list").classList.add("hidden");
      document.getElementById("collection-cards__collection_list__nav-buttons").classList.add("hidden");
      //Top collection navigation
      document.getElementById("collection-cards__top_collection_list__nav-buttons").classList.add("hidden"); 
    } else {
      var otherCollectionList = document.getElementById('collection-cards__other_collection_list');
      var childElementsOtherCollectionList = otherCollectionList.children;
      Array.from(childElementsOtherCollectionList).forEach(child => {
        if (!child.classList.contains(collection2FilterParam)) {
          child.classList.add("hidden");
        }
      });
    }
  } else {
    //Show all
  }

</script>

