{% assign data = section.settings %}

{% style %}
  .edward-van-harmelen {
    padding: 124px 0;
    background: #EDF2E9;
  }

  .edward-van-harmelen__wrapper {
    margin: 0 auto;
    max-width: 1280px;
    padding: 0 20px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .edward-van-harmelen__founder {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .edward-van-harmelen__image {
    flex: 0 0 104px;
    max-width: 104px;
    object-fit: cover;
    aspect-ratio: 1;
    border-radius: 24px;
  }

  .edward-van-harmelen__column {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .edward-van-harmelen__position {
    color: #284734;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -2.2%;
  }

  .edward-van-harmelen__name {
    color: #284734;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -2.2%;
  }

  .edward-van-harmelen__info {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .edward-van-harmelen__title {
    font-family: 'Romie' !important;
    color: #284734;
    font-weight: 400;
    font-size: 46px;
    line-height: 1.3;
    letter-spacing: -2.2%;
    text-align: left;
  }

  .edward-van-harmelen__description {
    font-size: 26px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -2.2%;
    color: #284734;
  }

  @media (max-width: 768px) {
    .edward-van-harmelen {
      padding: 80px 0;
    }

    .edward-van-harmelen__wrapper {
      gap: 32px;
    }

    .edward-van-harmelen__info {
      gap: 24px;
    }

    .edward-van-harmelen__image {
      flex: 0 0 64px;
      max-width: 64px;
      border-radius: 16px;
    }

    .edward-van-harmelen__position {
      font-size: 14px;
    }

    .edward-van-harmelen__name {
      font-size: 24px;
    }

    .edward-van-harmelen__title {
      font-size: 32px;
    }

    .edward-van-harmelen__description {
      font-size: 20px;
    }
  }
{% endstyle %}

<section class="edward-van-harmelen edward-van-harmelen--{{ template.suffix }}">
  <div class="edward-van-harmelen__wrapper">
    <div class="edward-van-harmelen__founder">
      {% if data.image != blank %}
        {{ data.image | image_url: width: 208, height: 208 | image_tag: class: 'edward-van-harmelen__image', loading: 'lazy' }}
      {% endif %}
      <div class="edward-van-harmelen__column">
          {% if data.position != blank %}
            <div class="edward-van-harmelen__position">{{ data.position }}</div>
          {% endif %}
          {% if data.name != blank %}
            <h3 class="edward-van-harmelen__name">{{ data.name }}</h3>
          {% endif %}
      </div>
    </div>
    <div class="edward-van-harmelen__info">
      {% if data.title != blank %}
        <h2 class="edward-van-harmelen__title">{{ data.title }}</h2>
      {% endif %}
      {% if data.description != blank %}
        <p class="edward-van-harmelen__description">{{ data.description }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Edward van Harmelen",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "text",
      "id": "position",
      "label": "Founder position"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Founder name"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section description"
    },
  ],
  "presets": [
    {
      "name": "Landing: Edward van Harmelen"
    }
  ]
}
{% endschema %}
