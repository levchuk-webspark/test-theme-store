{% style %}
    #shopify-section-{{ section.id }} .product__video-with-title {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if template.name == 'product' and product.metafields.custom.product_video_with_title.value.background_color %}
        background-color: {{ product.metafields.custom.product_video_with_title.value.background_color }};
    {% else %}
        background-color: {{ section.settings.background_color }};
    {% endif %}
    }

  .product__video-with-title__title {
      font-weight: normal;
      width: 44%;
      margin-bottom: 43px;
    }

    #shopify-section-{{ section.id }} .product__video-with-title__title {
      {% if template.name == 'product' and product.metafields.custom.product_video_with_title.value.title_color %}
        color: {{ product.metafields.custom.product_video_with_title.value.title_color }};
    {% else %}
        color: {{ section.settings.title_color }};
    {% endif %}
      
    }

    #shopify-section-{{ section.id }} .product__video-with-title__title {
      font-size: {{ section.settings.title-font-size }}px;
    }

  .product__video-with-title__video-container {
    border-radius: 10px;
    height: {{ section.settings.video-height }}px;
    width: 100%;
    overflow: hidden;
    object-fit: cover;
  }

  .product__video-with-title__video-container > video {
    height: {{ section.settings.video-height }}px;
    object-fit: cover;
    width: 100%;
   }

    @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} .product__video-with-title {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .product__video-with-title__title {
        font-size: {{ section.settings.title-font-size-mobile }}px;
      }

      .product__video-with-title__title {
        width: 100%;
      }

      .product__video-with-title__video-container {
        height: {{ section.settings.video-height-mobile }}px;
      }

      .product__video-with-title__video-container > video {
        height: {{ section.settings.video-height-mobile }}px;
      }
    }
  
  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}

{% if product.metafields.custom.product_video_with_title %}
  {% assign metaobject = product.metafields.custom.product_video_with_title.value %}
  <section
      class="
        section
        {{ section.settings.css_class }}
        product__video-with-title
      "
    >
    {% if metaobject.title != blank %}
      <h2 class="product__video-with-title__title">{{ metaobject.title }}</h2>
    {% endif %}
    {% if metaobject.video_link != nil %}
      <div class="product__video-with-title__video-container">
        <video loop muted width="100%" height="100%" controls>     
            <source src="{{ metaobject.video_link }}" type="video/mp4">          
        </video> 
      </div>
    {% endif %}
  </section>
{% endif %}

{% schema %}
  {
    "name": "Product video with title",
    "settings": [
      {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
      {
      "type": "range",
      "id": "title-font-size",
      "label": "Title font size",
      "min": 0,
      "max": 100,
      "default": 34,
      "unit": "px"
    },
       {
      "type": "range",
      "id": "video-height",
      "label": "Video height",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 750,
      "unit": "px"
    },
      {
      "type": "header",
      "content": "Colors"
    },
     {
      "type": "color",
      "id": "background_color",
      "label": "Background",
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
    },
      {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "default": 20,
      "unit": "px"
    },
      {
      "type": "range",
      "id": "title-font-size-mobile",
      "label": "Mobile title font size",
      "min": 0,
      "max": 100,
      "default": 34,
      "unit": "px"
    },
      {
      "type": "range",
      "id": "video-height-mobile",
      "label": "Mobile ideo height",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 200,
      "unit": "px"
    },
       {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
    ],
     "presets": [
      {
        "name": "Product video with title"
      }
    ]
  }
{% endschema %}