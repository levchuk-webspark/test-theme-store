<script>
  document.addEventListener('DOMContentLoaded', function () {
    const slider = document.querySelector('.product__study-findings__comparison-slider');
    const afterImage = document.querySelector('.product__study-findings__comparison-after');
    const beforeLabel = document.querySelector('.product__study-findings__before');
    const afterLabel = document.querySelector('.product__study-findings__after');
    let isDragging = false;

    const handleMouseMove = (e) => {
        if (!isDragging) return;

        let rect = slider.parentElement.getBoundingClientRect();
        let xPos = e.clientX - rect.left;

        if (xPos < 0) xPos = 0;
        if (xPos > rect.width) xPos = rect.width;

        if (xPos === 0) {
          beforeLabel.style.display = "none";
          afterLabel.style.display = "flex";
        }

        if (xPos === rect.width) {
          afterLabel.style.display = "none";
          beforeLabel.style.display = "flex";
        }

        if (xPos !== 0 && xPos !== rect.width) {
          beforeLabel.style.display = "flex";
          afterLabel.style.display = "flex";
        }

        const percent = (xPos / rect.width) * 100;

        slider.style.left = `${percent}%`;
        afterImage.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
    };

    slider.addEventListener('mousedown', () => (isDragging = true));
    document.addEventListener('mouseup', () => (isDragging = false));
    document.addEventListener('mousemove', handleMouseMove);

    // For touch devices
    slider.addEventListener('touchstart', () => (isDragging = true));
    document.addEventListener('touchend', () => (isDragging = false));
    document.addEventListener('touchmove', (e) => handleMouseMove(e.touches[0]));
});
</script>

