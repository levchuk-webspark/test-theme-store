{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .product__study-findings {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product__study-findings {
    display: flex;
    gap: 32px;
  }

  .product__study-findings__image-container {
    width: 435px;
    max-width: 435px;
    min-width: 435px;
  }

  .product__study-findings__image-container > .custom-image-element__wrap > img {
    object-fit: cover;
    height: auto;
    border-radius: 10px;
  }

  #shopify-section-{{ section.id }} .product__study-findings__info-container__title {
    font-size: {{ section.settings.title_font_size }}px;
    color: {{ section.settings.title_color }};
  }

  .product__study-findings__info-container__title {
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .product__study-findings__info-container__description {
    font-size: {{ section.settings.description_font_size }}px;
    color: {{ section.settings.description_color }};
  }

  .product__study-findings__info-container__description {
    margin-bottom: 39px;
  }

  .product__study-findings .carousel-cell {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 20px;
    margin-right: 20px;
  }

  .product__study-findings__item-block {
    display: flex;
    flex-direction: column;
    padding: 19px;
    border-radius: 10px;
  }

   #shopify-section-{{ section.id }} .product__study-findings__item-block {
     background-color: {{ section.settings.item_background_color }};
   }

  #shopify-section-{{ section.id }} .product__study-findings__item-block__title {
    font-size: {{ section.settings.item_title_font_size }}px;
    color: {{ section.settings.item_title_color }};
  }

  .product__study-findings__item-block__title {
    margin-bottom: 12px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .product__study-findings__item-block__description {
    font-size: {{ section.settings.item_description_font_size }}px;
    color: {{ section.settings.item_description_color }};
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} a.button.button--custom {
    background-color: {{ section.settings.button_color }};
    border-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }} a.button.button--custom:hover {
    background-color: {{ section.settings.button_text_color }};
    border-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_color }};
  }

  .product__study-findings__info-container__link {
    margin-top: 25px;
  }

  .product__study-findings__info-container {
    display: grid;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots {
    position: relative;
    width: 100%;
    bottom: unset;
  }

  .carousel-{{ section.id }}-mobile {
      display: none;
  }

   #shopify-section-{{ section.id }} .flickity-page-dots {
	counter-reset: a;
    background-image: unset;
     display: flex;
    justify-content: center;
    align-items: end;
  }

   #shopify-section-{{ section.id }} .flickity-page-dots .dot {
    width: 9px;
    height: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid {{ section.settings.item_background_color }};
    transform: rotate(-45deg);
    color: {{ section.settings.item_background_color }};
    background-color: {{ section.settings.item_background_color }};
    margin-top: 25px;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots .dot.is-selected {
    border: 1px solid {{ section.settings.item_title_color }};
    color: {{ section.settings.item_title_color }};
    background-color: {{ section.settings.item_title_color }};
  }

  .product__study-findings__comparison {
    width: 100%;
    position: relative;
  }

  .product__study-findings__label-container {
    position: absolute;
    width: 100%;
    padding: 0 24px;
    bottom: 24px;
    height: 37px;

  }

  .product__study-findings__before {
    position: absolute;
    left: 24px;
  }

  .product__study-findings__after {
    position: absolute;
    right: 24px;
  }

  .product__study-findings__label {
    text-shadow: 4px 4px 4px #00000040;
    font-size: 27px;
    line-height: 37px;
    font-weight: 900;
    color: #F7F5F1;
  }

  .product__study-findings__comparison-container {
    width: 100%;
    height: 435px;
    max-width: 100%;
    position: relative;
  }

  .product__study-findings__comparison-wrapper {
    position: relative;
    width: 100%;
    height: 435px;
    overflow: hidden;
    border-radius: 10px;
  }

  .product__study-findings__comparison-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 435px;
    overflow: hidden;
  }

  .product__study-findings__comparison-image img {
    width: 100%;
    height: 435px;
    display: flex;
    
    object-fit: cover;
  }

  .product__study-findings__comparison-after {
    clip-path: inset(0 50% 0 0); 
  }

  .product__study-findings__comparison-slider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 6px;
    height: 100%;
    background-color: {{ section.settings.slider_color }};
    cursor: ew-resize;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .product__study-findings__slider-handle {
    position: absolute;
    width: 58px;
    height: 27px;
    bottom: 70px;

    left: -22px;
  }

  .product__study-findings__comparison-container,
  .product__study-findings__comparison-container * {
    user-select: none; /* Disable text/image selection */
    -webkit-user-drag: none; /* Prevent image dragging in WebKit browsers */
  }

  @media only screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .product__study-findings {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .product__study-findings {
      display: flex;
      flex-direction: column;
      gap: 19px;
    }

    #shopify-section-{{ section.id }} .product__study-findings__info-container__title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }

    .product__study-findings__info-container__title {
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .product__study-findings__info-container__description {
      font-size: {{ section.settings.description_font_size_mobile }}px;
    }

    .product__study-findings__info-container__description {
      margin-bottom: 19px;
    }

    #shopify-section-{{ section.id }} .product__study-findings__item-block__title {
      font-size: {{ section.settings.item_title_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .product__study-findings__item-block__description {
      font-size: {{ section.settings.item_description_font_size_mobile }}px;
    }

    .product__study-findings__info-container__link {
      margin-top: 20px;
      align-items: center;
      display: flex;
      justify-content: center;
    }
  }

  @media only screen and (max-width: 768px) {
    .product__study-findings__image-container {
      height: 435px;
      width: unset;
      max-width: unset;
      min-width: unset;
    }

    .product__study-findings__image-container > .custom-image-element__wrap > img {
      height: 435px;
    }

    .carousel-{{ section.id }}-desktop {
      display: none;
    }

    .carousel-{{ section.id }}-mobile {
      display: block;
    }

    .product__study-findings .carousel-cell {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(2, 1fr);
    }

    #shopify-section-{{ section.id }} .flickity-page-dots .dot {
      margin-top: 20px;
    }

    .product__study-findings__info-container__link {
      justify-content: flex-end;
    }
  }

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}
