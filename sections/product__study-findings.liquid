              <div class="product__study-findings__item-block">
                <div class="product__study-findings__item-block__title">{{ metaobject.item_title_12 }}</div>
                {% if metaobject.item_description_12 %}
                  <div class="product__study-findings__item-block__description">
                    {{ metaobject.item_description_12 }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

