{% assign data = section.settings %}

{% style %}
  .ready-to-feel {
    padding: 80px 0;
    min-height: min(730px, 100dvh);
    position: relative;
    display: flex;
    align-items: center;
  }

  .ready-to-feel__image {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    z-index: 0;
    object-fit: cover;
  }

  .ready-to-feel__wrapper {
    position: relative;
    margin: 0 auto;
    max-width: 1100px;
    padding: 0 20px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .ready-to-feel__title {
    font-family: 'Romie' !important;
    color: #fff;
    font-weight: 400;
    font-size: 76px;
    line-height: 1.3;
    letter-spacing: -2.2%;
  }

  .ready-to-feel__button {
    font-family: Ambit SemiBold !important;
    background: linear-gradient(65deg, #294031 10%, #71B743 130%);
    padding: 24px 32px;
    border-radius: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    min-width: 240px;
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -2.2%;
    color: #fff;
    width: fit-content;
    transition: all 0.3s ease-in-out; 
  }

  .ready-to-feel__button:hover {
    transform: scale(1.04);
    color: #fff;
  }

  .ready-to-feel--christmas-landing {
    min-height: 742px;
  }

  @media (max-width: 768px) {
    .ready-to-feel,
    .ready-to-feel--christmas-landing {
      min-height: auto;
    }

    .ready-to-feel__title {
      font-size: 48px;
    }
  }
{% endstyle %}

<section class="ready-to-feel ready-to-feel--{{ template.suffix }}">
  {% if data.background_image != blank %}
    {{ data.background_image | image_url: width: 2880, height: 1484 | image_tag: class: 'ready-to-feel__image', loading: 'lazy' }}
  {% endif %}

  <div class="ready-to-feel__wrapper">
    {% if data.title != blank %}
      <h2 class="ready-to-feel__title">{{ data.title }}</h2>
    {% endif %}
    {% if data.cta_label != blank %}
      <a 
        {% if data.cta_url != blank %}
          href="{{ data.cta_url }}"
        {% endif %}
        class="ready-to-feel__button"
      >
        {{ data.cta_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Landing - Ready To Feel",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Section title"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Section CTA label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Section CTA link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Landing: Ready To Feel"
    }
  ]
}
{% endschema %}
