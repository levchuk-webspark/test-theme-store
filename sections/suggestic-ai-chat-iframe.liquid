{% style %}
  .suggestic-ai-chat-iframe .suggestic-ai-chat-iframe__chat-content {
    overflow: hidden;
    border-radius: 10px;
}
  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}
<section 
  class="
    section
    {{ section.settings.css_class }}
    suggestic-ai-chat-iframe
  "
  >
  <div class="suggestic-ai-chat-iframe__chat-content">
    <iframe 
    style="width: 100%;height: 100%; border:0;min-height:500px;"
    src="https://widget-chat-suggestic.vercel.app/?client_id=b9311b9f-b243-40ba-a06f-236f811609af&assistant_id=QXNzaXN0YW50OjM3MTAyNTQ3LWMyZGMtNDNkOS05YjIzLTU0ZDUxM2U4ZDQwOA==&color=%23e56a54&disable_image_upload=true"
    allow="camera; microphone" 
  >
    </iframe>
  </div>
</section>
{% schema %}
  {
    "name": "Suggestic AI chat",
    "settings": [
      {
        "type": "header",
        "content": "Advanced",
        "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
      },
      {
        "type": "text",
        "id": "css_class",
        "label": "CSS Class"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS"
      }
    ],
    "presets": [
      {
        "name": "Suggestic AI chat",
      }
     ]
  }
{% endschema %}