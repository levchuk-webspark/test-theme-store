        const selectedCardVitalityIngredientsCarouselPrevButton = document.querySelector('.vitality-ingredients__modal__cards-list__item__button-prev-{{ section.id }}');
        const selectedCardVitalityIngredientsCarouselNextButton = document.querySelector('.vitality-ingredients__modal__cards-list__item__button-next-{{ section.id }}');

              if (selectedCardVitalityIngredientsCarouselPrevButton) {
                selectedCardVitalityIngredientsCarouselPrevButton.addEventListener( 'click', function() {
                  selectedCardVitalityIngredientsCarouselFlickity.previous();
                });
              }
          
              if (selectedCardVitalityIngredientsCarouselNextButton) {
                selectedCardVitalityIngredientsCarouselNextButton.addEventListener( 'click', function() {
                  selectedCardVitalityIngredientsCarouselFlickity.next( );
                });
              }

        vitalityIngredientsModalBackdrop.onclick = function(event) {
                  vitalityIngredientsModalContent.classList.remove("vitality-ingredients__modal__content__is-open");
                  vitalityIngredientsModalBackdrop.classList.remove("vitality-ingredients__modal-backdrop-is-open");
                  removeSelectedClassFromCards();
                  removeSelectedCardNamePropertyFromUrl();
                  selectedCardVitalityIngredientsCarouselFlickity.destroy();
              }

              vitalityIngredientsModalClose.onclick = function() {
                  vitalityIngredientsModalContent.classList.remove("vitality-ingredients__modal__content__is-open");
                  vitalityIngredientsModalBackdrop.classList.remove("vitality-ingredients__modal-backdrop-is-open");
                  removeSelectedClassFromCards();
                  removeSelectedCardNamePropertyFromUrl();
                  selectedCardVitalityIngredientsCarouselFlickity.destroy();
              }

 
              vitalityIngredientsModalContent.onclick = function(e) {
                  e.stopPropagation();
              }
      }
    }
  }


      const antioxidantOpenAll = document.getElementById("antioxidant-open-all");
      const antioxidantHideAll = document.getElementById("antioxidant-hide-all");
      
      const antioxidantsElements = document.querySelector(".antioxidants-ingredients");
      
      antioxidantOpenAll.addEventListener("click", () => {
        for (const child of antioxidantsElements.children) {
          child.style.display = "flex";
          child.style.filter = "unset";
          antioxidantOpenAll.style.display = "none";
        }
        antioxidantHideAll.style.display = "flex";
      });

      antioxidantHideAll.addEventListener("click", () => {
        let i = 0;
        for (const child of antioxidantsElements.children) {
          if (i > 5) {
            child.style.display = "none";
          }
          if (i == 5) {
            child.style.filter = "blur(4px)";
          }
          antioxidantHideAll.style.display = "none";
          i++;
        }
        antioxidantOpenAll.style.display = "flex";
      });

  });
  
</script>

