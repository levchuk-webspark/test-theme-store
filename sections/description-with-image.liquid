{% assign slides = section.blocks | where: 'type', 'slide' %}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .description-with-image {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .description-with-image__large-image-container-mobile {
    display: none;
  }

  .description-with-image__large-image-container-desktop,
  .description-with-image__large-image-container-mobile {
    border-radius: 8px;
    overflow: hidden;
  }

   .description-with-image__large-image-container-desktop img,
    .description-with-image__large-image-container-mobile img {
     object-fit: cover;
    border-radius: 8px;
      
      /* height: 100%; */
   }

  .description-with-image__content {
    display: flex;
    justify-content: space-between;
  }

  .description-with-image__separator.description-with-image__icons {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .description-with-image__separator.description-with-image__icons {
    margin-right: 15px;
  }

   .description-with-image__separator.description-with-image__icons > .icon {
    transform: rotate(90deg);
  }

  .description-with-image__separator.description-with-image__icons > .icon {
    width: 30px;
    height: 30px;
  }

  .description-with-image__description-container__top-row__text-block-heading {
    font-size: 34px;
    line-height: 1.1;

    margin-bottom: 48px;
  }

  .description-with-image__content-main {
    display: flex;

    width: 60%;
  }

  .description-with-image__content-main-description-block {
    display: flex;
    gap: 30px;
  }

  .description-with-image__content-main-description-block__description {
    font-size: 20px;
    line-height: 1.1;

    width: 50%;
  }

  .description-with-image__content-main-description-block__image-block > .custom-image-element__wrap.image-element__wrap > img {
    object-fit: cover;
    
    border-radius: 8px;
  }

  .description-with-image__content-main-description-block__image-block {
    margin-left: 48px;

    /* height: 312px;
    width: 247px; */
  }

  .description-with-image__content-main-description-block__image-block > .custom-image-element__wrap.image-element__wrap {
    height: 312px;
    width: 247px;
  }

  .description-with-image__content-main-description-block__image-block::before {
    content: '';
    
    width: 181px;
    height: 234px;

    display: block;
    border-radius: 8px;
    border: 1px solid {{ section.settings.text_color }};

    margin-left: -48px;
    margin-bottom: -185px;
  }

  .description-with-image__content-main-description-block__image-and-button {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 30px;
  }

  .description-with-image__button {
    display: flex;
    align-self: end;
  }

  .description-with-image__large-image-container-desktop {
    /* position: relative; */

    /* height: 660px; */
    height: 580px;

    display: flex;
  }

  .description-with-image__large-image-container-desktop__icon {
    position: absolute;

    width: 246px;
    height: 246px;
    
    bottom: 24px;
    right: 24px;
  }

  .description-with-image__image-container {
    position: relative;

    width: 50%;
  }

  .description-with-image__separator.description-with-image__icons.description-with-image__icons__mobile {
    display: none;
  }

   #shopify-section-{{ section.id }}  .carousel-cell.is-selected {
     /* height: 100%; */
   }

  #shopify-section-{{ section.id }} .flickity-prev-next-button.previous, 
  #shopify-section-{{ section.id }} .flickity-prev-next-button.next {
    display: none;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots {
	counter-reset: a;
    background-image: unset;
     display: flex;
    justify-content: center;
    align-items: end;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots {
    bottom: 0;
    height: 20%;
    background: linear-gradient(360deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 56.45%);
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots .dot {
    width: 19px;
    height: 19px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid #f7f5f1;;
    transform: rotate(-45deg);
    color: #f7f5f1;
    margin-bottom: 12px;
  }
  
  #shopify-section-{{ section.id }} .flickity-page-dots .dot.is-selected {
    border: 1px solid {{ section.settings.active_dot_color }};
    border-bottom-color: transparent;
    color: {{ section.settings.active_dot_color }};
  }
  
   #shopify-section-{{ section.id }} .flickity-page-dots .dot::after {
  	content: counter(a);
  	counter-increment: a;
    font-size: 12px;
    font-weight: bold;
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .carousel-cell > img {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .description-with-image__large-image-container-desktop .carousel-{{ section.id }},
     #shopify-section-{{ section.id }} .description-with-image__large-image-container-desktop .carousel-{{ section.id }} .flickity-viewport,
     #shopify-section-{{ section.id }} .description-with-image__large-image-container-desktop .carousel-{{ section.id }} .flickity-viewport .flickity-slider,
     #shopify-section-{{ section.id }} .description-with-image__large-image-container-desktop .carousel-{{ section.id }} .flickity-viewport .flickity-slider .carousel-cell,
    #shopify-section-{{ section.id }} .description-with-image__large-image-container-desktop .carousel-{{ section.id }} .flickity-viewport .flickity-slider .carousel-cell img {
       height: 100%;
            border-radius: 8px;
     }

      #shopify-section-{{ section.id }} .description-with-image__large-image-container-desktop .carousel-{{ section.id }} .flickity-viewport .flickity-slider .carousel-cell video,
      #shopify-section-{{ section.id }} .description-with-image__large-image-container-desktop .carousel-{{ section.id }} .flickity-viewport .flickity-slider .carousel-cell video > source {
        height: 100%;
        border-radius: 8px;
        object-fit: cover;
      }

  .description-with-image__content-main-block {
    /* height: 100%; */
  }

  @media only screen and (max-width: 2560px) {
    .description-with-image__content-main {
      width: 58%;
    }

    .description-with-image__large-image-container-desktop__icon {
      bottom: 32px;
