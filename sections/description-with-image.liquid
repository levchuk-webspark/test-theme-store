<section
  class="
    section
    {{ section.settings.css_class }}
    description-with-image
  "
>
  <div class="description-with-image__content">
    <div class="description-with-image__content-main">
      <div class="description-with-image__content-main-block"> 
        {% if section.settings.heading != blank %}
          <div class="description-with-image__description-container__top-row__text-block-heading">{{ section.settings.heading }}</div>
        {% endif %}
        <div class="description-with-image__content-main-description-block">
          {% if section.settings.small-image != nil %}
            <div class="description-with-image__content-main-description-block__image-and-button">
              <div class="description-with-image__content-main-description-block__image-block">
                {%
                  render 'image-element',
                  image: section.settings.small-image,
                  alt: section.settings.small-image.alt
                %}
               </div>

              {% for block in section.blocks %}
                    {% if block.type == 'button-block' %}
    
                        {% if block.settings.button_label != blank %}
                            {% style -%}
                                
                                .block--{{ block.id }}.description-with-image__button .button--custom {
                                  border-radius: {{ block.settings.button_custom_border_radius | append: 'px' }};
                                  border: 1px solid;
                                  width: auto;
                                  max-width: 100%;
                                  white-space: normal;
                                  overflow-wrap: normal;
                                }
                      
                                .block--{{ block.id }}.description-with-image__button a.button--custom.button,
                                .block--{{ block.id }}.description-with-image__button a.button--custom.button:link,
                                .block--{{ block.id }}.description-with-image__button a.button--custom.button:visited {
                                  background-color: {{ block.settings.button_custom_bg_color }};
                                  color: {{ block.settings.button_custom_text_color }};
                                  border-color: {{ block.settings.button_custom_border_color }};
                                }
                      
                                .block--{{ block.id }}.description-with-image__button a.button--custom.button:hover,
                                .block--{{ block.id }}.description-with-image__button a.button--custom.button.is-hovered {
                                  color: {{ block.settings.button_custom_text_color--highlight }};
                                  border-color: {{ block.settings.button_custom_border_color--highlight }};
                                  background-color: {{ block.settings.button_custom_bg_color--highlight }};
                                }

                              .block--{{ block.id }}.description-with-image__button a.button--primary.button {
                                padding-bottom: 10px;
                                padding-top: 10px;
                              }
        
                                @media only screen and (max-width: 389px) {
                                  .block--{{ block.id }}.list-with-image__button .button--custom {
                                    width: 230px;
                                  }
                                }
              
                      
                            {%- endstyle -%}
                            
                              <div class="description-with-image__button block--{{ block.id }} description-with-image__button-mobile">
                                <a href="{{ block.settings.button_link }}" class="button {{ block.settings.button_style }}">
                                  {{ block.settings.button_label }}
                                </a>
                              </div>
                        {% endif %}
                      
                    {% endif %}
                
              {% endfor %} 
            </div>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="description-with-image__content-main-description-block__description">{{ section.settings.description }}</div>
          {% endif %}
        </div>
      </div>
      {% if section.settings.icon-separator != blank %}
      <div class="description-with-image__separator description-with-image__icons description-with-image__icons__mobile">
