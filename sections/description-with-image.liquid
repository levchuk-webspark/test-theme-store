<script>
  document.addEventListener('DOMContentLoaded', function() {
    var elemDescriptionWithImage = document.querySelector('.carousel-{{ section.id }}');
    var flktyDescriptionWithImage = new Flickity( elemDescriptionWithImage, {
      cellAlign: 'left',
      contain: true,
      groupCells: true,
      wrapAround: true,
      adaptiveHeight: false,
      prevNextButtons: false,
      pageDots: true,
      draggable: true,
      imagesLoaded: true,
      fade: true ,
      autoPlay: {{ section.settings.image_slideshow_speed | json }} * 1000,
    });

    var elemDescriptionWithImageMobile = document.querySelector('.carousel-{{ section.id }}-mobile');
    var flktyDescriptionWithImageMobile = new Flickity( elemDescriptionWithImageMobile, {
      cellAlign: 'left',
      contain: true,
      groupCells: true,
      wrapAround: true,
      adaptiveHeight: false,
      prevNextButtons: false,
      pageDots: true,
      draggable: true,
      imagesLoaded: true,
      fade: true ,
      autoPlay: {{ section.settings.image_slideshow_speed | json }} * 1000,
    });
  });
</script>

