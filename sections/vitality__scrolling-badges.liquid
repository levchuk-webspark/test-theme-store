{% assign time = 60 %}

{% style %}
  #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.background_color }};
        color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .vitality__scrolling-badges {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .vitality__scrolling-badges__title {
    color: {{ section.settings.text_color }};
  }

  .vitality__scrolling-badges__title__block {
     margin-right: 57px;
  }

  .vitality__scrolling-badges__title {
    font-size: 34px;
    white-space: nowrap;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .vitality__scrolling-badges__list__item {
    background: {{ section.settings.text_color }};
  }

  .vitality__scrolling-badges__list__item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    border-radius: 16px;
    padding: 10px;
    margin-right: 16px;
}

  #shopify-section-{{ section.id }} .vitality__scrolling-badges__list__item__text {
    color: {{ section.settings.background_color }};
    white-space: nowrap;
  }

  .vitality__scrolling-badges__list__item__image {
    width: 45px;
    height: 45px;
    min-width: 45px;
    min-height: 45px;
  }

  .vitality__scrolling-badges__list__item__text {
    font-size: 28px;
  }

  .vitality__scrolling-badges__content {
    display: flex;
    align-items: center;

    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .vitality__scrolling-badges__list {
    display: flex;
    
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
    position: relative;

    /* -webkit-mask-image: linear-gradient(90deg, transparent, #fff 20%, #fff 80%, transparent); */

  }

  .vitality__scrolling-badges_caurosel-primary, .vitality__scrolling-badges_caurosel-secondary {
    display: flex;
  }

   .vitality__scrolling-badges_caurosel-primary {
    white-space: nowrap;
    animation: scrolling-badges_scroll {{ time }}s linear infinite;
    animation-delay: {{ time | times: -1 }}s;
  }

  .vitality__scrolling-badges_caurosel-secondary {
    animation: scrolling-badges_scroll2 {{ time }}s linear infinite;
    animation-delay: {{ time | divided_by: -2}}s;
  }

  /* .vitality__scrolling-badges_caurosel-primary > div, .vitality__scrolling-badges_caurosel-secondary > div {
    padding-left: 10px;
  } */


   @keyframes scrolling-badges_scroll {
    0% {
        transform: translateX(100%);
    }

    100% {
        transform: translateX(-100%);
    }
  }

  @keyframes scrolling-badges_scroll2 {
    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-200%);
    }
  }

@media only screen and (max-width: 1200px) {
   .vitality__scrolling-badges__title {
     white-space: wrap;
   }

  .vitality__scrolling-badges__content {
    flex-direction: column;
    gap: 10px;
  }

  .vitality__scrolling-badges__title {
    margin-right: unset;
  }
}

  @media only screen and (max-width: 798px) {
  .vitality__scrolling-badges__list__item__image {
    width: 27px;
    height: 27px;
    min-width: 27px;
    min-height: 27px;
  }

  .vitality__scrolling-badges__list__item__text {
    font-size: 18px;
  }
}

 {%
