{% style %}
    #shopify-section-{{ section.id }} .how-to-use-product {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if template.name == 'product' and product.metafields.custom.how_to_use_product.value.background %}
        background-color: {{ product.metafields.custom.how_to_use_product.value.background }};
    {% else %}
        background-color: {{ section.settings.background_color }};
    {% endif %}
    }

     .how-to-use-product__title {
      font-weight: normal;
      margin-bottom: 50px;
    }

    #shopify-section-{{ section.id }} .how-to-use-product__title {
      {% if template.name == 'product' and product.metafields.custom.how_to_use_product.value.text_color %}
        color: {{ product.metafields.custom.how_to_use_product.value.text_color }};
    {% else %}
        color: {{ section.settings.text_color }};
    {% endif %}
      
    }

    #shopify-section-{{ section.id }} .how-to-use-product__title {
      font-size: {{ section.settings.title-font-size }}px;
    }

    .how-to-use-product__cards-list {
      display: flex;
      align-items: stretch;
      justify-content: space-between;
      position: relative;
    }

    .how-to-use-product__card {
      padding-right: 10px;
      width: 25%;
    }

    .how-to-use-product__card:last-of-type {
       padding-right: 0;
    }

    #shopify-section-{{ section.id }} .how-to-use-product__card-content {
      width: 100%;
    }

    .how-to-use-product-wrapper-image {
      position: relative;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .how-to-use-product__card__number {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: {{ section.settings.card-number-font-size }}px;
      font-weight: 900;
      width: {{ section.settings.card-number-size }}px;
      height: {{ section.settings.card-number-size }}px;
      border-radius: 50%;
      position: absolute;
      bottom: 8px;
      left: 8px;
    }

     #shopify-section-{{ section.id }} .how-to-use-product__card__description {
      margin-top: 15px;
    }

    #shopify-section-{{ section.id }} .how-to-use-product__description {
      font-size: {{ section.settings.card-description-font-size }};
    }

    #shopify-section-{{ section.id }} .how-to-use-product__card__image {
      height: 440px;
      border-radius: 5px;
      object-fit: cover;
    }

  #shopify-section-{{ section.id }} .how-to-use-product__card__image > img {
      object-fit: cover;
    }

   #shopify-section-{{ section.id }} .how-to-use-product__card__description {
    {% if template.name == 'product' and product.metafields.custom.how_to_use_product.value.text_color %}
        color: {{ product.metafields.custom.how_to_use_product.value.text_color }};
    {% else %}
        color: {{ section.settings.text_color }};
    {% endif %}
  }

   #shopify-section-{{ section.id }} .how-to-use-product__card__number {
      color: {{ product.metafields.custom.how_to_use_product.value.number_color }};;
      background-color: {{ product.metafields.custom.how_to_use_product.value.background_number }};
  }

    .how-to-use-product__nav-buttons {
      display: none;
    }

    .how-to-use-product .flickity-button {
      display: none;
    }

    @media only screen and (max-width: 1439px) {
      #shopify-section-{{ section.id }} .how-to-use-product__card__image {
        height: 350px;
      }
    }

     @media only screen and (max-width: 1063px) {
       .how-to-use-product__card {
          padding-right: 8px;
          width: 260px;
        }

       .how-to-use-product__card:last-of-type {
          padding-right: 8px;
       }

       .how-to-use-product__nav-buttons__prev,
      .how-to-use-product__nav-buttons__next {
        width: 30px;
        height: 30px;
        {% if template.name == 'product' and product.metafields.custom.how_to_use_product.value.text_color %}
          border: 1px solid{{ product.metafields.custom.how_to_use_product.value.text_color }};
        {% else %}
          border: 1px solid {{ settings.text_color }};
        {% endif %}
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
  
        cursor: pointer;
  }

      .how-to-use-product__nav-buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
      }

        .how-to-use-product__nav-buttons__arrow-prev,
  .how-to-use-product__nav-buttons__arrow-next {
    width: 6px;
    height: 6px;
    {% if template.name == 'product' and product.metafields.custom.how_to_use_product.value.text_color %}
          border-top: 1px solid{{ product.metafields.custom.how_to_use_product.value.text_color }};
        {% else %}
          border-top: 1px solid {{ settings.text_color }};
        {% endif %}
    {% if template.name == 'product' and product.metafields.custom.how_to_use_product.value.text_color %}
          border-right: 1px solid{{ product.metafields.custom.how_to_use_product.value.text_color }};
        {% else %}
          border-right: 1px solid {{ settings.text_color }};
        {% endif %}
  }

  .how-to-use-product__nav-buttons__arrow-prev {
    transform: rotate(-135deg);
  }

  .how-to-use-product__nav-buttons__arrow-next {
    transform: rotate(45deg);
  }
}

    @media only screen and (max-width: 798px) {
      #shopify-section-{{ section.id }} .how-to-use-product {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        padding-left: 16px;
        padding-right: 16px;
      }

      .how-to-use-product__title {
        margin-bottom: 34px;
      }

      #shopify-section-{{ section.id }} .how-to-use-product__title {
        font-size: {{ section.settings.title-font-size-mobile }}px;
      }

      #shopify-section-{{ section.id }} .how-to-use-product__card__number {
        width: {{ section.settings.card-number-size-mobile }}px;
        height: {{ section.settings.card-number-size-mobile }}px;
        font-size: {{ section.settings.card-number-font-size-mobile }}px;
      }
    }
  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}
{% if product.metafields.custom.how_to_use_product %}
  {% assign metaobject = product.metafields.custom.how_to_use_product.value %}
  <section
      class="
        section
        {{ section.settings.css_class }}
        how-to-use-product
      "
    >
    {% if metaobject.title != blank and metaobject.image_1 != nil %}
      <h2 class="how-to-use-product__title">{{ metaobject.title }}</h2>
    {% endif %}
    <ul class="how-to-use-product__cards-list carousel-{{ section.id }}">
      {% if metaobject.image_1 != nil %}
        <li class="how-to-use-product__card block-1 how-to-use-product__carousel-cell">
            <div class="how-to-use-product__card-content">
                <div class="how-to-use-product-wrapper-image">
                  {% render 'image-element',
                    image: metaobject.image_1,
                    alt: metaobject.image_1.alt,
                    additional_wrapper_classes: 'how-to-use-product__card__image',
                    object_fit: true
                  %}
                  <div class="how-to-use-product__card__number">1</div>
                </div>
              {% if metaobject.text_1 != blank %}
                 <div class="how-to-use-product__card__description">{{ metaobject.text_1 }}</div>
              {% endif %}
            </div>
          </li>
      {% endif %}

      {% if metaobject.image_2 != nil %}
        <li class="how-to-use-product__card block-2 how-to-use-product__carousel-cell">
            <div class="how-to-use-product__card-content">
                <div class="how-to-use-product-wrapper-image">
                  {% render 'image-element',
                    image: metaobject.image_2,
                    alt: metaobject.image_2.alt,
                    additional_wrapper_classes: 'how-to-use-product__card__image',
                    object_fit: true
                  %}
                  <div class="how-to-use-product__card__number">2</div>
                </div>
              {% if metaobject.text_2 != blank %}
                 <div class="how-to-use-product__card__description">{{ metaobject.text_2 }}</div>
              {% endif %}
            </div>
          </li>
      {% endif %}

      {% if metaobject.image_3 != nil %}
        <li class="how-to-use-product__card block-3 how-to-use-product__carousel-cell">
            <div class="how-to-use-product__card-content">
                <div class="how-to-use-product-wrapper-image">
                  {% render 'image-element',
                    image: metaobject.image_3,
                    alt: metaobject.image_3.alt,
                    additional_wrapper_classes: 'how-to-use-product__card__image',
                    object_fit: true
                  %}
                  <div class="how-to-use-product__card__number">3</div>
                </div>
              {% if metaobject.text_3 != blank %}
                 <div class="how-to-use-product__card__description">{{ metaobject.text_3 }}</div>
              {% endif %}
            </div>
          </li>
      {% endif %}

      {% if metaobject.image_4 != nil %}
        <li class="how-to-use-product__card block-4 how-to-use-product__carousel-cell">
            <div class="how-to-use-product__card-content">
                <div class="how-to-use-product-wrapper-image">
                  {% render 'image-element',
                    image: metaobject.image_4,
                    alt: metaobject.image_4.alt,
                    additional_wrapper_classes: 'how-to-use-product__card__image',
                    object_fit: true
                  %}
                  <div class="how-to-use-product__card__number">4</div>
                </div>
              {% if metaobject.text_4 != blank %}
                 <div class="how-to-use-product__card__description">{{ metaobject.text_4 }}</div>
              {% endif %}
            </div>
          </li>
      {% endif %}
    </ul>
    {% if metaobject.image_1 != nil %}
       <div class="how-to-use-product__nav-buttons">
        <div class="how-to-use-product__nav-buttons__prev how-to-use-product__nav-buttons__prev-{{ section.id }}">
          <div class="how-to-use-product__nav-buttons__arrow-prev"></div>
        </div>
        <div class="how-to-use-product__nav-buttons__next how-to-use-product__nav-buttons__next-{{ section.id }}">
          <div class="how-to-use-product__nav-buttons__arrow-next"></div>
        </div>
      </div>
    {% endif %}

  </section>
  {% endif %}
  {% comment %}JavaScript{% endcomment %}

<script>
  window.addEventListener('load', function() {

    const howToUseProductCarousel = document.querySelector('.carousel-{{ section.id }}');

        if (howToUseProductCarousel) {
            const howToUseProductFlickity = new Flickity( howToUseProductCarousel, {
                cellAlign: 'left',
                contain: true,
                groupCells: true,
                wrapAround: true,
                pageDots: false
            });


            const howToUseProductPrevButton = document.querySelector('.how-to-use-product__nav-buttons__prev-{{ section.id }}');
            const howToUseProductNextButton = document.querySelector('.how-to-use-product__nav-buttons__next-{{ section.id }}');

            if (howToUseProductPrevButton) {
              howToUseProductPrevButton.addEventListener( 'click', function() {
                howToUseProductFlickity.previous();
              });
            }

            if (howToUseProductNextButton) {
              howToUseProductNextButton.addEventListener( 'click', function() {
                howToUseProductFlickity.next();
              });
            }

        }

  });
</script>
