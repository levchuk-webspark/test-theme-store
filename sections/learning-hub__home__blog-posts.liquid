    {
      "type": "header",
      "content": "Audio"
    },
    {
      "type": "image_picker",
      "id": "audio_type_icon_big",
      "label": "Audio type icon Big"
    },
    {
      "type": "image_picker",
      "id": "audio_type_icon_small",
      "label": "Audio type icon Small"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "image_picker",
      "id": "video_type_icon_big",
      "label": "Video type icon Big"
    },
    {
      "type": "image_picker",
      "id": "video_type_icon_small",
      "label": "Video type icon Small"
    },
    {
      "type": "header",
      "content": "Recipes"
    },
    {
      "type": "image_picker",
      "id": "recipes_type_icon_big",
