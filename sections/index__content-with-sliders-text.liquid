  {%
    render 'css-loop',
    css: section_css,
    id: section.id,
  %}

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}


<section
  class="
    section
    {{ section.settings.css_class }}
    is-width-{{ width }}
    under-overlay-menu
    {% if section.settings.mobile_text_below_image == true %}
      mobile-text--below-media
      {% else %}
      mobile-text--over-media
    {% endif %}
    content-with-sliders-text
  "
  {% if section.settings.animation != "none" %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="
      content-with-sliders-text-container
      container
      {% if width == 'wide' %}
        equal-columns--outside-trim
      {% endif %}
    "
  >
      <div class="content-with-sliders-text__static_content">
        {% if section.settings.video_link != blank %}
          <video class="video-js custom-image-element__wrap image-element__wrap is-hidden-mobile-only content-with-sliders-text__background-image" loop autoplay muted playsinline>
            <source src="{{ section.settings.video_link }}" type="video/mp4">      
          </video>
        {% else if section.settings.image != nill %}
          <div class="custom-image-element__wrap image-element__wrap is-hidden-mobile-only content-with-sliders-text__background-image ">
                <img src="{{ section.settings.image | img_url: 'master' }}" />
          </div>
        {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg is-hidden-mobile-only' }}
        {% endif %}

        {% if section.settings.video_link_mobile != blank %}
          <video class="video-js custom-image-element__wrap image-element__wrap is-hidden-desktop-only content-with-sliders-text__background-image" loop autoplay muted playsinline>
            <source src="{{ section.settings.video_link_mobile }}" type="video/mp4">      
          </video>
        {% else if section.settings.mobile_image != blank %}
              {%
                render 'image-element',
                image: section.settings.mobile_image,
                alt: section.settings.mobile_image.alt,
                stretch_width: true,
                additional_wrapper_classes: 'is-hidden-desktop-only content-with-sliders-text__background-image',
                focal_point: section.settings.mobile_image.presentation.focal_point,
              %}
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg is-hidden-desktop-only' }}
            {% endif %}
      </div>
      <div
        class="
          content-with-sliders-text
          carousel-{{ section.id }}
        "
      >
        {% for block in blocks %}
        {% liquid
            assign link = block.settings.link
            assign pretext = block.settings.pretext
            assign mobile_pretext = block.settings.mobile_pretext | default: pretext
            assign title = block.settings.title
            assign mobile_title = block.settings.mobile_title | default: title
            assign subtitle = block.settings.subtitle
            assign mobile_subtitle = block.settings.mobile_subtitle | default: subtitle
            assign text_horizontal_position = block.settings.text_horizontal_position
            assign button_1 = block.settings.button_1
            assign button_1_link = block.settings.button_1_link
            assign button_2 = block.settings.button_2
            assign button_2_link = block.settings.button_2_link
            assign background_color_alpha = block.settings.background_opacity | divided_by: 100.00
            assign heading_alpha = block.settings.heading_color | color_extract: 'alpha'
            assign preheading_alpha = block.settings.pretext_color | color_extract: 'alpha'
            assign subheading_alpha = block.settings.subheading_color | color_extract: 'alpha'
            assign caption_border_alpha = block.settings.border_color | color_extract: 'alpha'
            assign mobile_headline_alpha = block.settings.heading_color_mobile | color_extract: 'alpha'
            assign mobile_preheading_alpha = block.settings.pretext_color_mobile | color_extract: 'alpha'
            assign mobile_subtitle_alpha = block.settings.subheading_color_mobile | color_extract: 'alpha'
            assign caption_background_alpha = block.settings.background_color | color_extract: 'alpha'
            assign description_alpha = block.settings.description_color | color_extract: 'alpha'
            assign item_title_alpha = block.settings.item_title_color | color_extract: 'alpha'

            if button_1 != blank and button_2 != blank
              assign buttons = true
            else
              assign buttons = false
            endif
          %}
        <div
            class="
              carousel-cell
              image-slideshow__slide
              content-with-sliders-text__banner
              {% if section.settings.mobile_text_below_image == true %}
                mobile-text--below-media
              {% else %}
                mobile-text--over-media
              {% endif %}
            "
            id="shopify-section-{{ block.id }}"
            data-slide-index={{ forloop.index0 }}
            {{ block.shopify_attributes }}
          >
          {% style -%}
              #shopify-section-{{ block.id }} .caption-content {
                background-color: {% if caption_background_alpha != 0 %}{% if background_color_alpha != 100  %}{{ block.settings.background_color | color_modify: 'alpha', background_color_alpha }}{% else %}{{ block.settings.background_color }}{% endif %}{% else %}rgba(0,0,0,0){% endif %};
                border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
              }

              #shopify-section-{{ block.id }} .content-with-sliders-text__heading {
                color: {% if heading_alpha != 0 %}{{ block.settings.heading_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }} .content-with-sliders-text__preheading {
                color: {% if preheading_alpha != 0 %}{{ block.settings.pretext_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }} .content-with-sliders-text__subheading {
                color: {% if subheading_alpha != 0 %}{{ block.settings.subheading_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }}  .content-with-sliders-text__description {
                  color: {% if description_alpha != 0 %}{{ block.settings.description_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }}  .content-with-sliders-text__title {
                  color: {% if item_title_alpha != 0 %}{{ block.settings.item_title_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              @media only screen and (min-width: 799px) {
                #shopify-section-{{ block.id }} .caption-content {
                  width: {{ block.settings.text_width }}%;
                }
              }

              @media only screen and (max-width: 480px) {
                #shopify-section-{{ block.id }}  .content-with-sliders-text__heading {
                  color: {% if mobile_headline_alpha != 0 %}{{ block.settings.heading_color_mobile}}{% endif %};
                }
                #shopify-section-{{ block.id }}  .content-with-sliders-text__preheading {
                  color: {% if mobile_preheading_alpha != 0 %}{{ block.settings.pretext_color_mobile}}{% endif %};
                }
                #shopify-section-{{ block.id }}  .content-with-sliders-text__subheading {
                  color: {% if mobile_subtitle_alpha != 0 %}{{ block.settings.subheading_color_mobile}}{% endif %};
                }
              }
            {%- endstyle -%}

          {% if pretext != blank or mobile_pretext != blank or title != blank or mobile_title != blank or subtitle != blank or mobile_subtitle != blank or button_1 != blank or button_2 != blank %}
              <div class="caption text-align-{{ text_horizontal_position }}">
                <div
                  class="
                    caption-content
                    text-align-{{ block.settings.text_alignment }}
                    {% if block.settings.mobile_text_alignment != 'none' %}
                      text-align--mobile-{{ block.settings.mobile_text_alignment }}
                    {% endif %}
                  "
                >
                  {% if pretext != blank %}
                    <div
                      class="
                        content-with-sliders-text__preheading
                        pretext
                        is-hidden-mobile-only
                      "
                    >
                      {{- pretext -}}
                    </div>
                  {% endif %}

                  {% if mobile_pretext != blank %}
                    <div
                      class="
                        content-with-sliders-text__preheading
                        pretext
                        is-hidden-desktop-only
                      "
                    >
                      {{- mobile_pretext -}}
                    </div>
                  {% endif %}

                  {% if title != blank %}
                    <h2
                      class="
                        content-with-sliders-text__heading
                        title
                        {% if title != mobile_title  %}is-hidden-mobile-only{% endif %}
                      "
                    >
                      {{- title -}}
                    </h2>
                  {% endif %}

                  {% if mobile_title != blank and title != mobile_title %}
                    <h2
                      class="
                        content-with-sliders-text__heading
                        title
                        {% if title != mobile_title  %}is-hidden-desktop-only{% endif %}
                      "
                    >
                      <span>
                        {{- mobile_title -}}
                      </span>
                    </h2>
                  {% endif %}

                  {% if subtitle != blank or mobile_subtitle != blank %}
                    <div class="content-with-sliders-text__subheading subtitle">
                      {% if subtitle != blank %}
                        <div class="is-hidden-mobile-only">
                          {{- subtitle -}}
                        </div>
                      {% endif %}

                      {% if mobile_subtitle != blank %}
                        <div class="is-hidden-desktop-only">
                          {{- mobile_subtitle -}}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="
                    content-with-sliders-text__small-image-and-review
                    {% if block.settings.image_small == blank %}
                      is-flex-column
                    {% endif %}
                  ">

                    <div class="content-with-sliders-text__small-image-and-review__first-part">
                      {% if block.settings.image_small != blank %}
                        <div class="content-with-sliders-text__small-image is-hidden-mobile-only">
                          {%
                            render 'image-element',
                            image: block.settings.image_small,
                            alt: block.settings.image_small.alt
                          %}
                        </div>
                       {% endif %}
                       {% if block.settings.image_small_mobile != blank %}
                          <div class="content-with-sliders-text__small-image-mobile is-hidden-desktop-only">
                          {%
                            render 'image-element',
                            image: block.settings.image_small_mobile,
                            alt: block.settings.image_small_mobile.alt
                            %}
                          </div>
                        {% endif %}

                      <div class="content-with-sliders-text__description-and-button">
                        {% if block.settings.item_title != blank %}
                          <div class="content-with-sliders-text__title ambit-black-text">
                            {{- block.settings.item_title -}}
                          </div>
                        {% endif %}
                        {% if block.settings.description != blank %}
                          <div class="content-with-sliders-text__description">
                            {{- block.settings.description -}}
                          </div>
                        {% endif %}
                        {% if button_1 != blank or button_2 != blank %}
                        <div
                          class="
                            content-with-sliders-text__buttons
                            buttons
                            buttons-auto-width
                            {% unless buttons == true %}
                              is-justify-{{ block.settings.text_alignment }}
                            {% endunless %}
                          "
                        >
                          {% if button_1 != blank %}
                            {%
                              render 'button',
                              label: button_1,
                              href: button_1_link,
                              type: "link",
                              style: block.settings.button_1_style,
                            %}
                          {% endif %}
    
                          {% if button_2 != blank %}
                            {%
                              render 'button',
                              label: button_2,
                              href: button_2_link,
                              type: "link",
                              style: block.settings.button_2_style,
                            %}
                          {% endif %}
                        </div>
                      {% endif %}
                      </div>
                    </div>

                    <div class="reveiwsection">
                      <div class="award-winning" style="opacity: 1;">
                      <div class="image" style="opacity: 1;"><img src="{{ section.settings.gallery_image1 | img_url: "800x"}}" style="opacity: 1;"></div>  
                      <div class="image" style="opacity: 1;"><img src="{{ section.settings.gallery_image2 | img_url: "800x"}}" style="opacity: 1;"></div>
                      <div class="image" style="opacity: 1;"><img src="{{ section.settings.gallery_image3 | img_url: "800x"}}" style="opacity: 1;"></div>
                      <div class="image" style="opacity: 1;"><img src="{{ section.settings.gallery_image4 | img_url: "800x"}}" style="opacity: 1;"></div>
                    </div> 
                    </div> 
                  </div>
                </div>
              </div>
          {% endif %}
        </div>
      {% endfor %}
      </div>
  </div>
  <div class="content-with-sliders-text__banner-line-mobile" />
</section>

<style>
.award-winning img, .award-winning .image { width: 60px; height: 60px; }
.award-winning .image { padding: 0; margin: 0 15px; }
.award-winning .image:first-of-type { margin: 0 15px 0 0 }

.award-winning { 
	display: flex;
   flex-direction: row;
   align-items: center;
   justify-content: flex-start; 
}

@media only screen and (max-width: 767px) {
  .award-winning img, .award-winning .image { width: 80px; }
  .award-winning .image { margin: 0 10px;}
  .awardwinning .page-width { padding-left: 5px; padding-right: 5px; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var contentWithSliderTextElement = document.querySelector('.carousel-{{ section.id }}');
       
        var flktyContentWithSliderText = new Flickity( contentWithSliderTextElement, {
          wrapAround: true,
          adaptiveHeight: true,
          prevNextButtons: {{ blocks.size | json }} > 1 ? {{ section.settings.show_arrows | json }} : false,
          pageDots: {{ blocks.size | json }} > 1 ? {{ section.settings.show_nav_buttons | json }} : false,
          draggable: true,
          imagesLoaded: true,
          fade: {{ section.settings.image_transition | json }} == "fade" ? true : false,
          autoPlay: {{ section.settings.image_slideshow_speed | json }} * 1000,
          arrowShape: {{ section.settings.show_arrows | json }},

          lazyLoad: true,
          cellAlign: 'left',
          contain: true,
          groupCells: true,
      });
  })
</script>
    
