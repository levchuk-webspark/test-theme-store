{% liquid
  assign blocks = section.blocks
  assign width = section.settings.width
%}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .desktop-image,
  #shopify-section-{{ section.id }} .mobile-image {
    width: 100%;
  }

  .content-with-sliders-text-container {
    position: relative;
  }

  .content-with-sliders-text video {
    object-fit: cover;
  }

  .content-with-sliders-text__static_content {
    position: absolute;
    z-index: -1;
  }

   #shopify-section-{{ section.id }} .flickity-page-dots {
	counter-reset: a;
    background-image: unset;
     display: flex;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots .dot {
    width: 19px;
    height: 19px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid #f7f5f1;;
    transform: rotate(-45deg);
    color: #f7f5f1;
  }
  
  #shopify-section-{{ section.id }} .flickity-page-dots .dot.is-selected {
    border: 1px solid {{ section.settings.active_dot_color }};
    border-bottom-color: transparent;
    color: {{ section.settings.active_dot_color }};
  }
  
   #shopify-section-{{ section.id }} .flickity-page-dots .dot::after {
  	content: counter(a);
  	counter-increment: a;
    font-size: 12px;
    font-weight: bold;
    transform: rotate(45deg);
  }

  .content-with-sliders-text__banner h2.title {
    font-size: 25px;
    margin-bottom: 34px;
  }

  .content-with-sliders-text__small-image-and-review {
    display: flex;
    flex-direction: column;
    gap: 33px;
    margin-top: 20px;
  }

  .content-with-sliders-text__small-image-and-review__first-part {
    display: flex;
    gap: 20px;
  }

  .content-with-sliders-text__small-image {
    width: 150px;
    height: 210px;
    min-width: 150px;
    min-height: 210px;
  }

  .content-with-sliders-text__small-image,
  .content-with-sliders-text__small-image-mobile {
    border-radius: 8px;
    overflow: hidden;
  }

  .content-with-sliders-text__small-image-mobile {
    width: 203px;
    height: 295px;
    min-width: 203px;
    min-height: 295px;
  }

  .content-with-sliders-text .gallery-cell .content-with-sliders-text__small-image .custom-image-element__wrap {
    min-height: unset;
    height: 100%;
  }

  .content-with-sliders-text .gallery-cell .content-with-sliders-text__small-image .custom-image-element__wrap > img,  .content-with-sliders-text .gallery-cell .content-with-sliders-text__small-image .custom-image-element__wrap > video {
    min-height: unset;
    aspect-ratio: unset !important;
    object-fit: cover;
  }

  .content-with-sliders-text__description-and-button {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 15px;

    background-color: #F7F5F1A6;
    width: 298px;
    border-radius: 10px;
    padding: 20px;
    
    height: 162px;
    /* height: fit-content; */
  }

  .content-with-sliders-text__description {
    font-size: 16px;
    line-height: 1.1;
  }

  .content-with-sliders-text__description-and-button .content-with-sliders-text__buttons a.button {
    margin-bottom: 0;
    height: 33px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content-with-sliders-text__description-and-button a.button--primary.button {
    font-size: 16px;
  }

  .content-with-sliders-text .reveiwsection {
    display: flex;
    flex-direction: column;
    height: fit-content;
  }

  .content-with-sliders-text:not(.flickity-enabled) .content-with-sliders-text-container .caption {
    /* top: 45px; */
    top: 60px;
    transform: translateY(0);
    max-width: {{ settings.section-max-width-large-screen | append: 'px' }};
    margin-left: auto;
    margin-right: auto;
    left: 0px;
    right: 0px;
    box-sizing: content-box;

    position: relative;
}

  .content-with-sliders-text .flickity-button.flickity-prev-next-button.previous,
  .content-with-sliders-text .flickity-button.flickity-prev-next-button.next {
    display: none;
  }

  
  .reveiwsection {
    position: relative;
  }
  
  .reveiwsection:before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
  }

    .content-with-sliders-text .gallery-cell .custom-image-element__wrap.content-with-sliders-text__background-image > img,
    .content-with-sliders-text .gallery-cell .custom-image-element__wrap.content-with-sliders-text__background-image > video {
      object-fit: cover;
    }

  .content-with-sliders-text__title {
    font-size: 25px;
    line-height: 1.1;
    font-weight: 900;
  }

  .content-with-sliders-text__static_content {
    width: 100%;
  }
  
@media only screen and (max-width: 2560px) {
  .content-with-sliders-text .image-slideshow, .content-with-sliders-text .flickity-viewport  {
      height: 600px;  
      min-height: 600px;
      overflow: hidden;
    }
  
    .content-with-sliders-text .gallery-cell .custom-image-element__wrap.content-with-sliders-text__background-image > img {
      height: 600px;  
      min-height: 600px;
    }

  .content-with-sliders-text .content-with-sliders-text-container, .content-with-sliders-text .content-with-sliders-text__static_content {
    height: 600px;  
    min-height: 600px;
  }

  .carousel-{{ section.id }} {
      width: 100%;
      height: 600px;
      min-height: 600px;
    }

  .content-with-sliders-text video.custom-image-element__wrap.image-element__wrap.is-hidden-mobile-only.content-with-sliders-text__background-image > source,
  .content-with-sliders-text video.custom-image-element__wrap.image-element__wrap.is-hidden-mobile-only.content-with-sliders-text__background-image {
    object-fit: cover;
    width: 100%;
    height: 600px;  
    min-height: 600px;
  }
}

@media only screen and (max-width: 1600px) {
