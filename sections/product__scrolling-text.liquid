{% assign product-scrolling-time = 60 %}

{% style %}
  #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.background_color }};
        color: {{ section.settings.text_color }};
  }

   #shopify-section-{{ section.id }} .product__scrolling-text {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

   .product__scrolling-text__list {
    display: flex;
    
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
    position: relative;
  }

  .product__scrolling-text__list__item {
    margin-right: 44px;
    white-space: nowrap;
    font-size: {{ section.settings.text_size }}px;
  }

   .product__scrolling-text_caurosel-primary, .product__scrolling-text_caurosel-secondary {
    display: flex;
  }

   .product__scrolling-text_caurosel-primary {
    white-space: nowrap;
    animation: product_text_scroll {{ product-scrolling-time }}s linear infinite;
    animation-delay: {{ product-scrolling-time | times: -1 }}s;
  }

  .product__scrolling-text_caurosel-secondary {
    animation: product_text_scroll2 {{ product-scrolling-time }}s linear infinite;
    animation-delay: {{ product-scrolling-time | divided_by: -2}}s;
  }

  @keyframes product_text_scroll {
    0% {
        transform: translateX(100%);
    }

    100% {
        transform: translateX(-100%);
    }
  }

  @keyframes product_text_scroll2 {
    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-200%);
    }
  }

    @media only screen and (max-width: 798px) {
       .product__scrolling-text__list__item {
        margin-right: 12px;
        font-size: {{ section.settings.text_size_mobile }}px;
      }
    }
{% endstyle %}

{% if product.metafields.custom.product_scrolling_text %}
  {% assign metaobject = product.metafields.custom.product_scrolling_text.value %}
   <section class="section
                  {{ section.settings.css_class }}
                  product__scrolling-text
                  "
  >
    {% style %}
      #shopify-section-{{ section.id }} .product__scrolling-text {
        color: {{ metaobject.text_color }};
        background-color: {{ metaobject.background_color }};
      }
      
      #shopify-section-{{ section.id }} .product__video__subheading {
        color: {{ metaobject.section_subheading_color }};
      }
    {% endstyle %}

     <div class="product__scrolling-text__list">
       <div class="product__scrolling-text_caurosel-primary">
          {% if metaobject.text_1 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_1 }}
           </div>
          {% endif %}
         {% if metaobject.text_2 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_2 }}
           </div>
          {% endif %}
         {% if metaobject.text_3 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_3 }}
           </div>
          {% endif %}
         {% if metaobject.text_4 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_4 }}
           </div>
          {% endif %}
         {% if metaobject.text_5 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_5 }}
           </div>
          {% endif %}
         {% if metaobject.text_6 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_6 }}
           </div>
          {% endif %}
         {% if metaobject.text_7 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_7 }}
           </div>
          {% endif %}
         {% if metaobject.text_8 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_8 }}
           </div>
          {% endif %}
       </div>

       <div class="product__scrolling-text_caurosel-secondary">
         {% if metaobject.text_1 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_1 }}
           </div>
          {% endif %}
         {% if metaobject.text_2 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_2 }}
           </div>
          {% endif %}
         {% if metaobject.text_3 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_3 }}
           </div>
          {% endif %}
         {% if metaobject.text_4 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_4 }}
           </div>
          {% endif %}
         {% if metaobject.text_5 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_5 }}
           </div>
          {% endif %}
         {% if metaobject.text_6 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_6 }}
           </div>
          {% endif %}
         {% if metaobject.text_7 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_7 }}
           </div>
          {% endif %}
         {% if metaobject.text_8 != blank %}
            <div class="product__scrolling-text__list__item"> 
              {{ metaobject.text_8 }}
           </div>
          {% endif %}
       </div>
     </div>
   </section>
{% endif %}
