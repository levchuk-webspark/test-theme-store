{% assign data = section.settings %}
{% assign lists = section.blocks | where: 'type', 'list' %}

{% style %}
  .nmn-vs-other {
    padding: 124px 0;
    background: #fff;
  }

  .nmn-vs-other__wrapper {
    margin: 0 auto;
    max-width: 1280px;
    padding: 0 20px;
    width: 100%;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 56px;
  }

  .nmn-vs-other__title {
    font-family: 'Romie' !important;
    color: #284734;
    font-weight: 400;
    font-size: 56px;
    line-height: 1.3;
    letter-spacing: -2.2%;
    text-align: center;
  }

  .nmn-vs-other__grid {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 8px;
  }

  .nmn-vs-other__item {
    flex: 0 0 calc(33.333% - ((8px * 2) / 3));
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-radius: 16px;
    overflow: hidden;
  }

  .nmn-vs-other__item:nth-child(1) .nmn-vs-other__heading,
  .nmn-vs-other__item:nth-child(1) .nmn-vs-other__list li {
    text-align: left;
    justify-content: unset;
    background: #FBFAF8;
  }

  .nmn-vs-other__item:nth-child(1) .nmn-vs-other__heading {
    color: #284734;
  }

  .nmn-vs-other__item:nth-child(1) .nmn-vs-other__list li {
    color: #404544;
    font-size: 24px;
  }

  .nmn-vs-other__item:nth-child(2) .nmn-vs-other__list {
    padding-bottom: 32px;
  }

  .nmn-vs-other__item:nth-child(2) .nmn-vs-other__heading,
  .nmn-vs-other__item:nth-child(2) .nmn-vs-other__list {
    background: #EDF2E9;
  }

  .nmn-vs-other__item:nth-child(2) .nmn-vs-other__list li {
    color: #284734;
    font-family: Ambit SemiBold !important;
    font-weight: 600;
  }

  .nmn-vs-other__item:nth-child(3) .nmn-vs-other__heading,
  .nmn-vs-other__item:nth-child(3) .nmn-vs-other__list li {
    background: #FBFBFB;
    color: #6F726E;
  }

  .nmn-vs-other__heading {
    font-family: Ambit SemiBold !important;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 24px;
    font-weight: 600;
    font-size: 34px;
    line-height: 39px;
    letter-spacing: -2.2%;
  }

  .nmn-vs-other__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nmn-vs-other__list li {
    padding: 20px 24px;
    font-size: 20px;
    line-height: 32px;
    text-align: center;
  }

  .nmn-vs-other__list li > span {
    display: none;
  }

  .nmn-vs-other--christmas-landing .nmn-vs-other__list {
    letter-spacing: -0.5px;
  }

  .nmn-vs-other--christmas-landing .nmn-vs-other__list li {
    min-height: 71px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 24px;
    line-height: 1.3;
  }

  .nmn-vs-other--christmas-landing .nmn-vs-other__item:nth-child(2) .nmn-vs-other__list {
    background: none;
    padding-bottom: 0;
  }

  .nmn-vs-other--christmas-landing .nmn-vs-other__item:nth-child(2) .nmn-vs-other__list li {
    background: #EDF2E9;
  }

  .nmn-vs-other--christmas-landing .nmn-vs-other__heading {
    letter-spacing: -0.9px;
  }

  .nmn-vs-other--christmas-landing .nmn-vs-other__heading,
  .nmn-vs-other--christmas-landing .nmn-vs-other__item:nth-child(2) .nmn-vs-other__list li {
    font-family: 'Ambit', sans-serif !important;
    font-weight: 400;
    color: #6F726E;
  }

  .nmn-vs-other--christmas-landing .nmn-vs-other__item:nth-child(2) .nmn-vs-other__heading {
    font-family: 'Romie', sans-serif !important;
    font-style: italic;
  }

  @media (max-width: 991px) {
    .nmn-vs-other__title {
      font-size: 48px;
    }

    .nmn-vs-other__grid {
      display: flex;
      flex-direction: column;
    }

    .nmn-vs-other__grid::-webkit-scrollbar {
      display: none;
    }

    .nmn-vs-other__item {
      flex: 1 1 auto;
      width: 100%;
    }

    .nmn-vs-other__item:first-child {
      display: none;
    }

    .nmn-vs-other__heading {
      padding: 32px 16px;
    }

    .nmn-vs-other__list li {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }

    .nmn-vs-other__list li > span {
      display: block;
      font-weight: 400;
      font-size: 14px;
      line-height: 1.3;
      letter-spacing: -2.2%;
      color: #404544;
    }

    .nmn-vs-other__list li {
      padding: 16px;
    }
  }

  @media (max-width: 768px) {
    .nmn-vs-other {
      padding: 80px 0;
    }

    .nmn-vs-other__wrapper {
      gap: 48px;
    }
  }

  @media (max-width: 450px) {
    .nmn-vs-other__title {
      font-size: 36px;
    }
  }
{% endstyle %}

<section class="nmn-vs-other nmn-vs-other--{{ template.suffix }}">
  <div class="nmn-vs-other__wrapper">
    {% if data.title != blank %}
      <h2 class="nmn-vs-other__title">{{ data.title }}</h2>
    {% endif %}

    <div class="nmn-vs-other__grid">
      {% for block in lists %}
        {% assign list = block.settings %}

        <div class="nmn-vs-other__item">
          {% if list.title != blank %}
            <h3 class="nmn-vs-other__heading">
              {{ list.title }}
            </h3>
          {% endif %}
          {% if list.items != blank %}
            <ul class="nmn-vs-other__list">
              {{ list.items }}
            </ul>
          {% endif %}
        </div>
      {% endfor %}   
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NMN vs Other",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title"
    },
  ],
  "blocks": [
    {
      "type": "list",
      "name": "List",
      "settings": [
        {
          "type": "html",
          "id": "title",
          "label": "List title"
        },
        {
          "type": "html",
          "id": "items",
          "label": "List items"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing: NMN vs Other"
    }
  ]
}
{% endschema %}
