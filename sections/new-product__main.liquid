{% comment %}
** Product - main content area **
- Product template
{% endcomment %}

{% assign id = section.id %}
{% comment %} Layout {% endcomment %}
{% assign width = section.settings.width %}
{% assign padding_top = section.settings.padding_top %}
{% assign padding_bottom = section.settings.padding_bottom %}
{% assign animation = section.settings.animation | default: 'none' %}
{% comment %} Advanced {% endcomment %}
{% assign css_class = section.settings.css_class %}
{% assign custom_css = section.settings.custom_css %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  .section--has-sidebar-option.has-sidebar-enabled {
    max-width: 900px;
    {% if width == 'wide' -%}
      width: 100%;
      max-width: 95%;
    {%- endif %}
  }

  .section--has-sidebar-option.has-sidebar-disabled {
    width: 100%;
    max-width: none;
  }

  .product-block--discount-promo .discount_promo{
    padding-top:15px;
    background:{%- render 'color_to_rgba', color:settings.discount_promo_bg_color, opacity:settings.discount_promo_bg_color_transparency -%};
    color: {{ settings.discount_promo_text_color }};
    border-radius:{{ settings.discount_promo_border_radius }}px;
    padding:{{ settings.discount_promo_padding }}px;
    text-align:{{ settings.discount_promo_text_alignment }};
    margin-top: {{ settings.discount_promo_top_margin }}px;
    margin-bottom:{{ settings.discount_promo_bottom_margin }}px;
    font-size: {{ settings.discount_promo_product_page_font_size }}px;
  }

  .metafield_message_preorder_wrapper .panel-cell.size-box {
    {% for block in section.blocks %}
      {% if block.type == 'form' %}
    background-color: {{ block.settings.preordermessage_bg_color }};
    border-color: {{ block.settings.preordermessage_border_color }};
    border-radius: {{ block.settings.preordermessage_border_radius }}px;
    {% endif %}
    {% endfor %}
  }

  .feefowidget-rating-stars > svg { fill: #78BE20!important; }
  .feefowidget-rating-stars > svg > g > path { fill: #78BE20!important; }
  .feefo-rating-stars > svg > g > path#inner { fill: #78BE20!important; }
  .feefo-rating-stars > svg > g > path#border-star { fill: #78BE20!important; }

  @media only screen and (max-width: 798px) {
    .product-block--discount-promo .discount_promo{
      padding-top:15px;
      background:{%- render 'color_to_rgba', color:settings.discount_promo_bg_color_mobile, opacity:settings.discount_promo_bg_color_transparency_mobile -%};
      color: {{ settings.discount_promo_text_color_mobile }};
      border-radius:{{ settings.discount_promo_border_radius_mobile }}px;
      padding:{{ settings.discount_promo_padding_mobile }}px;
      text-align:{{ settings.discount_promo_text_alignment_mobile }};
      margin-top: {{ settings.discount_promo_top_margin_mobile }}px;
      margin-bottom:{{ settings.discount_promo_bottom_margin_mobile }}px;
      font-size: {{ settings.discount_promo_product_page_font_size_mobile }}px;
    }
  }

  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% liquid
  assign selected_variant = product.selected_variant

  if product.variants.size == 1 or settings.select_first_available_variant
    assign selected_variant = product.selected_or_first_available_variant
  endif

  for block in section.blocks
    if block.type == 'price'
      assign display_savings = block.settings.display_savings | json
    endif
    if block.type == 'complementary_products'
      assign product_recommendation_limit = block.settings.product_recommendation_limit
    endif
  endfor
%}

<section class="section
        {{ css_class }}
        is-width-{{ width }}"
        {% if animation != "none" %}
          data-scroll-class="{{ animation }}"
        {% endif %}>
  <div class="product-{{ product.id }}">
    {%
      render 'new-product',
      product: product,
      sold_out_options: settings.sold_out_options,
      selected_variant: selected_variant,
      width: width,
      css_class: css_class,
      display_thumbnails: section.settings.display_thumbnails,
      enable_product_lightbox: section.settings.enable_product_lightbox,
      enable_shopify_product_badges: section.settings.enable_shopify_product_badges,
      enable_thumbnail_slider: section.settings.enable_thumbnail_slider,
      enable_zoom: section.settings.enable_zoom,
      gallery_arrows: section.settings.gallery_arrows,
      product_height: section.settings.product_height,
      product_height_mobile: section.settings.product_height_mobile,
      product_images_position: section.settings.product_images_position,
      set_product_height: section.settings.set_product_height,
      slideshow_transition: section.settings.slideshow_transition,
      stickers_enabled: settings.stickers_enabled,
      tag_style: settings.tag_style,
      thumbnail_position: section.settings.thumbnail_position,
      video_looping: section.settings.video_looping,
    %}
  </div>
</section>

{% comment %} JavaScript {% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-data
>
  {
    "product": {{ product | json }},
    "section_id": {{ section.id | json }},
    "product_recommendation_limit": {{ product_recommendation_limit | json }},
    "display_savings": {{ display_savings }},
    "gallery_arrows": {{ section.settings.gallery_arrows | json }},
    "thumbnail_arrows": {{ section.settings.gallery_arrows | json }},
    "enable_zoom": {{ section.settings.enable_zoom | json }},
    "enable_product_lightbox": {{ section.settings.enable_product_lightbox | json }},
    "enable_thumbnail_slider": {{ section.settings.enable_thumbnail_slider | json }},
    "slideshow_speed": {{ section.settings.slideshow_speed | json }},
    "slideshow_transition": {{ section.settings.slideshow_transition | json }},
    "thumbnails_enabled": {{ section.settings.display_thumbnails | json }},
    "thumbnail_position": {{ section.settings.thumbnail_position | json }},
    "product_media_amount": {{ product.media.size }},
    "template": "classic"
  }
</script>

<script src="{{ 'z__jsProduct.js' | asset_url }}"></script>

<script>
  setTimeout(() => {
var mystyle = document.createElement( 'style' )
mystyle.innerHTML = 'button.chip.chip-selected {background:#fc4301 !important}'
document.querySelector('div#feefo-product-review-widgetId').shadowRoot?.appendChild( mystyle);
}, 1000);
</script>

{% comment %} Shopify-XR {% endcomment %}
{% if product.media %}
  <script>
    window.ShopifyXR=window.ShopifyXR||function(){(ShopifyXR.q=ShopifyXR.q||[]).push(arguments)}
      {% assign models = product.media | where: 'media_type', 'model' | json %}
      ShopifyXR('addModels', {{ models }});
  </script>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var vitalityMenu = document.getElementById('vitality-menu');
    if (vitalityMenu) {
      const paddingTop = Number('{{ padding_top }}');
    const vitalityMenuHeight = vitalityMenu.clientHeight;
    const newPadding = paddingTop + vitalityMenuHeight;
    let currentSection = document.getElementById('shopify-section-{{ id }}');
    
    if (currentSection && newPadding) {
      currentSection.style.paddingTop = newPadding + 'px';
    }
    }
  });
</script>

