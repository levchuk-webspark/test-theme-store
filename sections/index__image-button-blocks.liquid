{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

   .image-button-blocks__title {
    font-size: 34px;
     line-height: 1;
    font-weight: normal;
    margin-bottom: 100px;
     max-width: 500px;
  }

  #shopify-section-{{ section.id }} .image-button-blocks__title {
    color: {{ section.settings.title_color }};
  }

  .image-button-blocks__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 77px;
  }

  .image-button-blocks__card {
    display: flex;
    align-items: flex-end;
    gap: 40px;
    position: relative;
    z-index: 1;
  }

  .image-button-blocks__card:before {
    content: "";
    position: absolute;
    left: 0;
    bottom: -36px;
    width: 427px;
    height: 255px;
    border-radius: 8px;
    border: 1px solid;
    z-index: -1;
  }
  
  .image-button-blocks__card__title-and-button {
    margin-bottom: 20px;
  }

  .image-button-blocks__card__image {
    width: 209px;
    height: 264px;
    min-width: 209px;
    min-height: 264px;
    margin: 0 0 0 50px;
    border-radius: 8px;
  }

  .image-button-blocks__card__image img {
    object-fit: cover;
  }

  .image-button-blocks__card__title {
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 27px;
  }

  .image-button-blocks__card-mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .image-element__wrap img {
    object-fit: cover;
  }

  @media only screen and (max-width: 1439px) {
    .image-button-blocks__list {
      column-gap: 42px;
    }

  }

  @media only screen and (max-width: 1200px) {
    .image-button-blocks__card {
      display: none;
    }

    .image-button-blocks__list {
      row-gap: 42px;
      column-gap: 10px;
    }

    .image-button-blocks__card-mobile {
      display: flex;
      flex-direction: column;
      gap: 36px;
      width: 134px;
      justify-self: center;
    }

    .image-button-blocks__card__image-mobile {
      width: 121px;
      height: 153px;
      min-width: 121px;
      min-height: 153px;
      margin-left: 30px;
      margin-top: 30px;
    }

    .image-button-blocks__card_button-and-image-mobile {
      display: block;
      position: relative;
      border-radius: 8px;
      border: 1px solid;
      width: 134px;
      height: 163px;
    }

    .image-button-blocks__card__title-mobile {
      font-size: 18px;
      font-weight: bold;
    }

    .image-button-blocks__button-mobile {
      position: absolute;
      left: 15px;
      top: 21px;
    }

    .image-button-blocks__button-mobile .button--custom {
      width: 150px;
      height: 39px;
    }

  }

 
  @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .image-button-blocks__title {
      margin-bottom: 63px;
      font-size: 32px;
    }

    .image-button-blocks__card-mobile {
      justify-self: start
    }
  }

   @media only screen and (max-width: 389px) {
   .image-button-blocks__card__image-mobile {
      margin-left: 15px;
    }

    .image-button-blocks__button-mobile {
      left: 12px;
      width: 130px;
    }
  }


 
{%
  render 'css-loop',
  css: section.settings.custom_css,
  id: section.id,
%}
  
{% endstyle %} 

<section
  class="
    section
    {{ section.settings.css_class }}
    image-button-blocks
  "
>
    {% if section.settings.title != blank %}
        <h2 class="image-button-blocks__title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}

      <div class="image-button-blocks__list">
        {% for block in section.blocks %}        
          {% if block.type == 'card' %} 

            {% style %}
              
              .block-{{ block.id }}.image-button-blocks__card,
              .block-{{ block.id }}.image-button-blocks__card-mobile {
                border-color: {{ block.settings.text_color }};
              }

              .block-{{ block.id }} .image-button-blocks__card__title, 
              .block-{{ block.id }} .image-button-blocks__card__title-mobile {
                color: {{ block.settings.text_color }};
              }

              .block-{{ block.id }}.image-button-blocks__card:before,
              .block-{{ block.id }} .image-button-blocks__card_button-and-image-mobile {
                border-color: {{ block.settings.text_color }};
              }

              .image-button-blocks__button .button--custom {
                border: 1px solid;
                width: 297px;
                height: 60px;
              }

              .image-button-blocks__button .button--custom,
              .image-button-blocks__button-mobile .button--custom {
                border-radius: {{ block.settings.button_custom_border_radius | append: 'px' }};
                border: 1px solid;
                white-space: normal;
                overflow-wrap: normal;
              }
    
              .block-{{ block.id }} .image-button-blocks__button a.button--custom.button,
              .block-{{ block.id }} .image-button-blocks__button a.button--custom.button:link,
              .block-{{ block.id }} .image-button-blocks__button a.button--custom.button:visited,
              .block-{{ block.id }} .image-button-blocks__button-mobile a.button--custom.button,
              .block-{{ block.id }} .image-button-blocks__button-mobile a.button--custom.button:link,
              .block-{{ block.id }} .image-button-blocks__button-mobile a.button--custom.button:visited {
                background-color: {{ block.settings.button_custom_bg_color }};
                color: {{ block.settings.button_custom_text_color }};
                border-color: {{ block.settings.button_custom_border_color }};
              }
    
              .block-{{ block.id }} .image-button-blocks__button a.button--custom.button:hover,
              .block-{{ block.id }} .image-button-blocks__button a.button--custom.button.is-hovered,
              .block-{{ block.id }} .image-button-blocks__button-mobile a.button--custom.button:hover,
              .block-{{ block.id }} .image-button-blocks__button-mobile a.button--custom.button.is-hovered {
                color: {{ block.settings.button_custom_text_color--highlight }};
                border-color: {{ block.settings.button_custom_border_color--highlight }};
                background-color: {{ block.settings.button_custom_bg_color--highlight }};
              }

                @media only screen and (max-width: 1439px) {
                  .image-button-blocks__button .button--custom {
                    width: 200px;
                  }             
                }

            {% endstyle %}

            <li class="image-button-blocks__card block-{{ block.id }} ">
                {% if block.settings.image != nil %}
                  {%
                    render 'image-element',
                    image: block.settings.image,
                    alt: block.settings.image.alt,
                    additional_wrapper_classes: 'image-button-blocks__card__image',
                  %}
                {% endif %}
                 <div class="image-button-blocks__card__title-and-button">
                    {% if block.settings.title != 'blank' %} 
                      <div class="image-button-blocks__card__title">{{ block.settings.title }}</div>
                     {% endif %}
    
                    {% if block.settings.button_label != blank %}
                      <div class="buttons image-button-blocks__button">
                        {% render 'button',
                          label: block.settings.button_label,
                          href: block.settings.button_link,
                          style: block.settings.button_style,
                          type: "link"
                        %}
                      </div>
                    {% endif %}
                   
                 </div>
              
            </li>

             <li class="image-button-blocks__card-mobile block-{{ block.id }} ">
              
                <div class="image-button-blocks__card_button-and-image-mobile">
                    {% if block.settings.button_label != blank %}
                      <div class="buttons image-button-blocks__button-mobile">
                        {% render 'button',
                          label: block.settings.button_label,
                          href: block.settings.button_link,
                          style: block.settings.button_style,
                          type: "link"
                        %}
                      </div>
                    {% endif %}
                  
                    {% if block.settings.image != nil %}
                      {%
                        render 'image-element',
                        image: block.settings.image,
                        alt: block.settings.image.alt,
                        additional_wrapper_classes: 'image-button-blocks__card__image-mobile',
                      %}
                  {% endif %}
                  
                </div>

                {% if block.settings.title != 'blank' %} 
                  <div class="image-button-blocks__card__title-mobile">{{ block.settings.title }}</div>
                 {% endif %}

            </li>

            
          {% endif %}
        {% endfor %} 
      </div>
      
    {% endif %}
  
</section>

{% schema %}
  {
    "name": "Image and button blocks",
    "settings": [
      {
        "type": "html",
        "id": "title",
        "label": "Section title"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top spacing",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 90,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom spacing",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Section background color",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Section title color",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "header",
        "content": "Mobile layout"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Mobile top spacing",
        "min": 0,
        "max": 80,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Mobile bottom spacing",
        "min": 0,
        "max": 80,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Advanced",
        "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
      },
      {
        "type": "text",
        "id": "css_class",
        "label": "CSS Class"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS"
      }
    ],
    "blocks": [
      {
        "type": "card",
        "name": "Card",
        "settings": [
          {
            "type": "html",
            "id": "title",
            "label": "Card title"
          },
          {
            "type": "header",
            "content": "Colors"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "button_label",
            "label": "Button label"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Button style",
            "options": [
              {
                "value": "button--primary",
                "label": "Primary"
              },
              {
                "value": "button--secondary",
                "label": "Secondary"
              },
              {
                "value": "button--link-style",
                "label": "Link style"
              },
              {
                "value": "button--custom",
                "label": "Custom"
              }
            ],
            "default": "button--primary"
          },
          {
            "type": "header",
            "content": "Custom button style"
          },
          {
            "type": "range",
            "id": "button_custom_border_radius",
            "label": "Border radius",
            "min": 0,
            "max": 50,
            "default": 8,
            "unit": "px"
          },
          {
            "type": "color",
            "id": "button_custom_bg_color",
            "label": "Background"
          },      
          {
            "type": "color",
            "id": "button_custom_border_color",
            "label": "Border"
          },
          {
            "type": "color",
            "id": "button_custom_text_color",
            "label": "Text"
          },
          {
            "type": "color",
            "id": "button_custom_bg_color--highlight",
            "label": "Background hover"
          },
          {
            "type": "color",
            "id": "button_custom_border_color--highlight",
            "label": "Border hover"
          },
          {
            "type": "color",
            "id": "button_custom_text_color--highlight",
            "label": "Text hover"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image and button blocks"
      }
    ]
  }
{% endschema %}