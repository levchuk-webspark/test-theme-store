        <a
          class="vitality__big-card__blocks__block-1"
          {% if section.settings.block_link_1 != blank %}
            href="{{ section.settings.block_link_1 }}"
          {% endif %}
        >
          <div class="vitality__big-card__blocks__block-1__arrow">
            {% render 'icon', name: 'read-more-right-arrow' %}
          </div>
          <div class="vitality__big-card__blocks__block-1__title">{{ section.settings.block_title_1 }}</div>
        </a>
      {% endif %}
      {% if section.settings.block_title_2 != blank %}
        <a
          class="vitality__big-card__blocks__block-2"
          {% if section.settings.block_link_2 != blank %}
            href="{{ section.settings.block_link_2 }}"
          {% endif %}
        >
          <div class="vitality__big-card__blocks__block-2__title">{{ section.settings.block_title_2 }}</div>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitality: one big card",
  "settings": [
    {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
    },
    {
    "type": "html",
    "id": "block_title_1",
    "label": "Block title 1"
  },
  {
    "type": "url",
    "id": "block_link_1",
    "label": "Block link 1"
  },
  {
    "type": "html",
    "id": "block_title_2",
    "label": "Block title 2"
  },
  {
    "type": "url",
    "id": "block_link_2",
    "label": "Block link 2"
  },
     {
    "type": "header",
    "content": "Layout"
  },
  {
    "type": "range",
    "id": "section_height",
    "label": "Section height",
    "min": 0,
    "max": 1000,
    "default": 700,
    "step": 10,
    "unit": "px"
  },
  {
    "type": "range",
    "id": "padding_top",
    "label": "Top spacing",
    "min": 0,
    "max": 500,
    "default": 80,
    "step": 10,
    "unit": "px"
  },
  {
    "type": "range",
    "id": "padding_bottom",
    "label": "Bottom spacing",
    "min": 0,
    "max": 500,
    "default": 80,
    "step": 10,
    "unit": "px"
  },
    {
    "type": "header",
    "content": "Colors"
  },
  {
    "type": "color",
    "id": "background_color",
    "label": "Section background color",
    "default": "rgba(0,0,0,0)"
  },
    {
    "type": "color",
    "id": "text_color",
    "label": "Text color",
    "default": "rgba(0,0,0,0)"
  },
    {
    "type": "header",
    "content": "Mobile layout"
  },
     {
    "type": "range",
    "id": "section_height_mobile",
    "label": "Section height mobile",
    "min": 0,
    "max": 1000,
    "default": 360,
    "step": 10,
    "unit": "px"
  },
  {
    "type": "range",
    "id": "padding_top_mobile",
    "label": "Mobile top spacing",
    "min": 0,
    "max": 200,
    "step": 5,
    "default": 20,
    "unit": "px"
  },
  {
    "type": "range",
    "id": "padding_bottom_mobile",
    "label": "Mobile bottom spacing",
    "min": 0,
    "max": 200,
    "step": 5,
    "default": 20,
    "unit": "px"
  },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
   "presets": [
    {
      "name": "Vitality: one big card"
    }
  ]
}
{% endschema %}
