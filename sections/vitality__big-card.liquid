{% style %}
    #shopify-section-{{ section.id }} .vitality__big-card {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;

      {% if section.settings.background_image != nil %}
                  background: url("{{section.settings.background_image | img_url: 'master'}}");
                  background-size:cover;
                  background-position:center;
                  background-repeat:norepeat;
     {% else %}
                  background-color: {{ section.settings.background_color }};
     {% endif %}

     min-height: {{ section.settings.section_height }}px;
      color: {{ section.settings.text_color }};
    }

  .vitality__big-card {
    border-radius: 20px;
    
    display: flex;
    align-content: flex-end;

    padding-left: 50px;
    padding-right: 50px;
  }

  .vitality__big-card__blocks {
      position: relative;
      width: 65%;
      height: 100%;

    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vitality__big-card__content {
    display: flex;
    gap: 28px;

    width: 100%;
  }

  .vitality__big-card__image__wrapper {
    width: 100%;
  }

  .vitality__big-card__image > svg {
      width: 323px;
      height: 126px;
      min-width: 323px;
      min-height: 126px;
    }

  #shopify-section-{{ section.id }} .vitality__big-card__blocks__block-1 {
      border: 1px solid {{ section.settings.text_color }};
    }

    .vitality__big-card__blocks__block-1 {
      padding: 30px;
      display: flex;
      gap: 35px;
      justify-content: space-between;
      font-size: 40px;
      line-height: 1.1;
    }

   #shopify-section-{{ section.id }} .vitality__big-card__blocks__block-1,
    #shopify-section-{{ section.id }} .vitality__big-card__blocks__block-2 {
      border-radius: 5px;
      border: 1px solid {{ section.settings.text_color }};
      color: {{ section.settings.text_color }};
    }

    .vitality__big-card__blocks__block-2,
    .vitality__big-card__blocks__block-3 {
      display: flex;
      justify-content: center;
      align-items: center;
    }

  .vitality__big-card__blocks__block-1__arrow .icon {
    width: 100px;
    height: 100px;
    min-width: 100px;
    min-height: 100px;
  }

  .vitality__big-card__blocks__block-3__title {
    text-decoration: underline dashed;
  }

  #shopify-section-{{ section.id }} .vitality__big-card__blocks__block-2__title__arrow {
    width: 4px;
    height: 4px;
    border-top: 1px solid {{ section.settings.text_color }};
    border-right: 1px solid {{ section.settings.text_color }};
    margin-left: 3px;
    transform: rotate(45deg);
  }

  a.vitality__big-card__blocks__block-2 {
    padding: 17px;
  }

  .vitality__big-card__blocks__block-1__title {
    display: flex;
    align-items: center;
  }

  @media only screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .vitality__big-card {
      min-height: {{ section.settings.section_height_mobile }}px;

      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;

      padding-left: 15px;
      padding-right: 15px;
    }

    .vitality__big-card__content {
      flex-direction: column-reverse;
    }

    .vitality__big-card__image__wrapper {
     display: flex;
     align-self: end;
    }

    .vitality__big-card__image > svg {
        width: 210px;
        height: 82px;
        min-width: 210px;
        min-height: 82px;
      }

    .vitality__big-card__blocks {
      width: 100%;
    }

    a.vitality__big-card__blocks__block-2 {
      width: 40%;
      display: flex;
      align-self: end;
    }

    .vitality__big-card__blocks__block-1__arrow .icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        min-height: 62px;
      }

    .vitality__big-card__blocks__block-1 {
      padding: 23px 23px 23px 30px;
      gap: 22px;
      font-size: 24px;
    }
  }

  @media only screen and (max-width: 798px) {
    a.vitality__big-card__blocks__block-2 {
      width: 100%;
    }
  }

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}

<section
  class="
    section
    {{ section.settings.css_class }}
    container
    vitality__big-card
  "
>
