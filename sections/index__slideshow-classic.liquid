{% comment %}
  ** Slideshow classic **
{% endcomment %}

{% liquid
  assign blocks = section.blocks
  assign width = section.settings.width
%}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;

      {% if width == 'wide' %}
        width: 100%;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .desktop-image,
    #shopify-section-{{ section.id }} .mobile-image {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .flickity-page-dots {
  	  counter-reset: a;
      background-image: unset;
      display: flex;
    }

    #shopify-section-{{ section.id }} .flickity-page-dots .dot {
      width: 19px;
      height: 19px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      border: 1px solid #f7f5f1;;
      transform: rotate(-45deg);
      color: #f7f5f1;
    }

    #shopify-section-{{ section.id }} .flickity-page-dots .dot.is-selected {
      border: 1px solid {{ section.settings.active_dot_color }};
      border-bottom-color: transparent;
      color: {{ section.settings.active_dot_color }};
    }

     #shopify-section-{{ section.id }} .flickity-page-dots .dot::after {
    	content: counter(a);
    	counter-increment: a;
      font-size: 12px;
      font-weight: bold;
      transform: rotate(45deg);
    }

    .slideshow-classic__banner h2.title {
      font-size: 25px;
      margin-bottom: 34px;
    }

    .slideshow-classic__small-image-and-review {
      display: flex;
      flex-direction: column;
      gap: 33px;
      margin-top: 20px;
    }

    .slideshow-classic__small-image-and-review__first-part {
      display: flex;
      gap: 20px;
    }

    .slideshow-classic__small-image {
      width: 150px;
      height: 210px;
      min-width: 150px;
      min-height: 210px;
    }

    .slideshow-classic__small-image,
    .slideshow-classic__small-image-mobile {
      border-radius: 8px;
      overflow: hidden;
    }

    .slideshow-classic__small-image-mobile {
      width: 203px;
      height: 295px;
      min-width: 203px;
      min-height: 295px;
    }

    .slideshow-classic .gallery-cell .slideshow-classic__small-image .custom-image-element__wrap {
      min-height: unset;
      height: 100%;
    }

    .slideshow-classic .gallery-cell .slideshow-classic__small-image .custom-image-element__wrap > img,  .slideshow-classic .gallery-cell .slideshow-classic__small-image .custom-image-element__wrap > video {
      min-height: unset;
      aspect-ratio: unset !important;
      object-fit: cover;
    }

    .slideshow-classic__description-and-button {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 15px;

      background-color: #F7F5F1A6;
      width: 298px;
      border-radius: 10px;
      padding: 20px;

      height: 162px;
      /* height: fit-content; */
    }

    .slideshow-classic__description {
      font-size: 16px;
      line-height: 1.1;
    }

    .slideshow-classic__description-and-button .slideshow-classic__buttons a.button {
      margin-bottom: 0;
      height: 33px;
      padding: 0 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slideshow-classic__description-and-button a.button--primary.button {
      font-size: 16px;
    }

    .slideshow-classic .reveiwsection {
      display: flex;
      flex-direction: column;
      height: fit-content;
    }

    .slideshow-classic:not(.flickity-enabled) .slideshow-classic-container .caption {
      top: 45px;
      transform: translateY(0);
      max-width: {{ settings.section-max-width-large-screen | append: 'px' }};
      margin-left: auto;
      margin-right: auto;
      left: 0px;
      right: 0px;
      box-sizing: content-box;
      height: -webkit-fill-available;
  }

    .slideshow-classic .flickity-button.flickity-prev-next-button.previous,
    .slideshow-classic .flickity-button.flickity-prev-next-button.next {
      display: none;
    }


    .reveiwsection {
      position: relative;
    }

    .reveiwsection:before {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      pointer-events: none;
      z-index: 1;
    }

    .reveiwsection > * {
      position: relative;
      z-index: 2;
    }

      .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > img,
      .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > video {
        object-fit: cover;
      }

    .slideshow-classic__title {
      font-size: 25px;
      line-height: 1.1;
      font-weight: 900;
    }

  @media only screen and (max-width: 2560px) {
    .slideshow-classic .image-slideshow {
        height: 600px;
        min-height: 600px;
        overflow: hidden;
      }

      .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > img {
        height: 600px;
        min-height: 600px;
      }

    .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-mobile-only.slideshow-classic__background-image > source,
    .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-mobile-only.slideshow-classic__background-image {
      object-fit: cover;
      height: 600px;
      min-height: 600px;
    }
  }

  @media only screen and (max-width: 1600px) {
      .slideshow-classic__background-image img {
        object-position: 43.0% 50.0% !important;
      }
  }



    @media only screen and (max-width: 1440px) {
      .slideshow-classic:not(.flickity-enabled) .slideshow-classic-container .caption,
      .slideshow-classic .flickity-page-dots {
        max-width: 1200px;
        width: 95%;
        height: -webkit-fill-available;
    }
  }

    @media only screen and (max-width: 1199px) {

        .slideshow-classic__description {
          font-size: 18px;
        }

      .slideshow-classic .gallery-cell .image-element__wrap {
        height: 100%;
      }


    }

    @media only screen and (max-width: 1024px) {
      .slideshow-classic__background-image img {
        object-position: 75.0% 50.0% !important;
      }
  }

    @media only screen and (max-width: 950px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      .slideshow-classic .image-slideshow {
        min-height: 790px;
        overflow: hidden;
      }

      .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > img {
        /* min-height: 1100px; */
        min-height: 790px;
      }

      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-mobile-only.slideshow-classic__background-image > source,
      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-mobile-only.slideshow-classic__background-image {
        min-height: 790px;
      }

      .slideshow-classic:not(.flickity-enabled) .slideshow-classic-container .caption {
        top: 45px;
        transform: translateY(0);
      }

      .slideshow-classic .gallery-cell .slideshow-classic__small-image-mobile .custom-image-element__wrap {
        min-height: unset;
        height: 100%;
      }

      .slideshow-classic .gallery-cell .slideshow-classic__small-image-mobile .custom-image-element__wrap > img {
        min-height: unset;
        height: 100%;
        object-fit: cover;
      }

      .slideshow-classic__small-image-and-review {
        flex-direction: column;
        margin-top: 20px;
        gap: 0;
      }

    .slideshow-classic__small-image {
      width: 203px;
      height: 295px;
      min-width: 203px;
      min-height: 295px;
    }

      .slideshow-classic .slideshow-classic__heading {
        margin-bottom: 20px;
      }

      .slideshow-classic .reveiwsection  {
        margin-top: 40px;
        padding-top: 0;
      }


    }

  @media only screen and (max-width: 798px) {
      .slideshow-classic .image-slideshow {
        min-height: 650px;
        overflow: hidden;
      }

    .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > img {
        /* height: 950px;
        min-height: 950px; */
        height: 650px;
        min-height: 650px;
      }

      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image > source,
      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image {
        height: 650px;
        min-height: 650px;
        object-fit: cover;
      }

      .slideshow-classic .reveiwsection  {
        margin-top: 20px;
      }

      .slideshow-classic .image-slideshow .mobile-text--over-media .caption .caption-content {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .slideshow-classic__small-image-and-review__first-part {
        flex-direction: column;
        align-items: center;
        gap: 20px;
      }

     #shopify-section-{{ section.id }} .slideshow-classic__banner-line-mobile {
      height: {{ section.settings.strip_height }}px;
      background-color: {{ section.settings.strip_color }};
    }

      .slideshow-classic__description-and-button {
        /* justify-content: end; */
        gap: 10px;
        /* height: 120px; */
        height: 164px;
      }

    .slideshow-classic__banner h2.title {
      margin-bottom: 65px;
    }

    .slideshow-classic__buttons.is-justify-left {
      margin-top: 6px;
    }
  }

    @media only screen and (max-width: 480px) {
      .slideshow-classic .image-slideshow {
        height: 560px;
        min-height: 560px;
        overflow: hidden;
      }

      .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > img {
        height: 560px;
        min-height: 560px;
      }

      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image > source,
      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image {
        height: 560px;
        min-height: 560px;
      }

      .slideshow-classic .image-slideshow .mobile-text--over-media .caption .caption-content {
        width: 100%;
        padding: 0 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .slideshow-classic__banner h2.title {
        font-size: 20px;
        width: 100%;
        margin-bottom: 20px;
      }

      .slideshow-classic__title {
        font-size: 20px;
      }

      .slideshow-classic__small-image-and-review__first-part {
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }

      .slideshow-classic__description {
        font-size: 12px;
      }

      .slideshow-classic__description-and-button {
        padding: 16px;
        height: 120px;
      }

      .slideshow-classic__description-and-button a.button--primary.button {
        font-size: 13px !important;
        width: -webkit-fit-content;
      }
    }

    @media only screen and (max-width: 389px) {
      .slideshow-classic__small-image-mobile {
        width: 140px;
        height: auto;
        min-width: 140px;
        min-height: auto;
      }

      .slideshow-classic .image-slideshow {
       height: 530px;
        min-height: 530px;
        overflow: hidden;
      }

      .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > img {
        height: 530px;
        min-height: 530px;
      }

      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image > source,
      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image {
        height: 530px;
        min-height: 530px;
      }

      .slideshow-classic div#feefo-service-review-carousel-widgetId {
          left: -20%;
      }

      .slideshow-classic__banner h2.title {
        margin-bottom: unset;
      }

    }

    @media only screen and (max-width: 350px) {
    .slideshow-classic .image-slideshow {
       height: 550px;
        min-height: 550px;
        overflow: hidden;
      }

    .slideshow-classic .gallery-cell .custom-image-element__wrap.slideshow-classic__background-image > img {
        /* height: 1030px;
        min-height: 1030px; */
        height: 550px;
        min-height: 550px;
      }

      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image > source,
      .slideshow-classic video.custom-image-element__wrap.image-element__wrap.is-hidden-desktop-only.slideshow-classic__background-image {
        height: 550px;
        min-height: 550px;
      }
   }

    @media only screen and (max-width: 798px) {
    .slideshow-classic .is-hidden-mobile-only {
      display: none !important;
    }
  }
  @media only screen and (min-width: 799px) {
    .slideshow-classic .is-hidden-desktop-only {
      display: none !important;
    }
  }


    {%
      render 'css-loop',
      css: section_css,
      id: section.id,
    %}

    {%
      render 'css-loop',
      css: section.settings.custom_css,
      id: section.id,
    %}
{% endstyle %}
{% render 'bf25-slideshow-styles' %}

<section
  class="
    section
    {{ section.settings.css_class }}
    is-width-{{ width }}
    under-overlay-menu
    {% if section.settings.mobile_text_below_image == true %}
      mobile-text--below-media
      {% else %}
      mobile-text--over-media
    {% endif %}
    slideshow-classic
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="
      slideshow-classic-container
      container
      {% if width == 'wide' %}
        equal-columns--outside-trim
      {% endif %}
    "
  >
    <div class="one-whole column">
      <div
        class="
          slideshow-classic
          image-slideshow
          image-slideshow--{{ section.settings.image_transition }}
          page-dots--{{ section.settings.show_nav_buttons }}
        "
        data-slideshow-classic
      >
        {% for block in blocks %}
          {% liquid
            assign image = block.settings.image
            assign video = block.settings.video_link
            assign mobile_image = block.settings.mobile_image | default: block.settings.image
            assign mobile_video = block.settings.video_link_mobile
            assign link = block.settings.link
            assign pretext = block.settings.pretext
            assign mobile_pretext = block.settings.mobile_pretext | default: pretext
            assign title = block.settings.title
            assign mobile_title = block.settings.mobile_title | default: title
            assign subtitle = block.settings.subtitle
            assign mobile_subtitle = block.settings.mobile_subtitle | default: subtitle
            assign text_horizontal_position = block.settings.text_horizontal_position
            assign button_1 = block.settings.button_1
            assign button_1_link = block.settings.button_1_link
            assign button_2 = block.settings.button_2
            assign button_2_link = block.settings.button_2_link
            assign background_color_alpha = block.settings.background_opacity | divided_by: 100.00
            assign heading_alpha = block.settings.heading_color | color_extract: 'alpha'
            assign preheading_alpha = block.settings.pretext_color | color_extract: 'alpha'
            assign subheading_alpha = block.settings.subheading_color | color_extract: 'alpha'
            assign caption_border_alpha = block.settings.border_color | color_extract: 'alpha'
            assign mobile_headline_alpha = block.settings.heading_color_mobile | color_extract: 'alpha'
            assign mobile_preheading_alpha = block.settings.pretext_color_mobile | color_extract: 'alpha'
            assign mobile_subtitle_alpha = block.settings.subheading_color_mobile | color_extract: 'alpha'
            assign caption_background_alpha = block.settings.background_color | color_extract: 'alpha'
            assign description_alpha = block.settings.description_color | color_extract: 'alpha'
            assign item_title_alpha = block.settings.item_title_color | color_extract: 'alpha'

            if button_1 != blank and button_2 != blank
              assign buttons = true
            else
              assign buttons = false
            endif
          %}

          <div
            class="
              gallery-cell
              image-slideshow__slide
              slideshow-classic__banner
              {% if section.settings.mobile_text_below_image == true %}
                mobile-text--below-media
              {% else %}
                mobile-text--over-media
              {% endif %}
            "
            id="shopify-section-{{ block.id }}"
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {% style -%}
              #shopify-section-{{ block.id }} .caption-content {
                background-color: {% if caption_background_alpha != 0 %}{% if background_color_alpha != 100  %}{{ block.settings.background_color | color_modify: 'alpha', background_color_alpha }}{% else %}{{ block.settings.background_color }}{% endif %}{% else %}rgba(0,0,0,0){% endif %};
                border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
              }

              #shopify-section-{{ block.id }} .slideshow-classic__heading {
                color: {% if heading_alpha != 0 %}{{ block.settings.heading_color }}{%elsif bf25_title_text_enabled%} var(--Snow-White){% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }} .slideshow-classic__preheading {
                color: {% if preheading_alpha != 0 %}{{ block.settings.pretext_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }} .slideshow-classic__subheading {
                color: {% if subheading_alpha != 0 %}{{ block.settings.subheading_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }}  .slideshow-classic__description {
                  color: {% if description_alpha != 0 %}{{ block.settings.description_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              #shopify-section-{{ block.id }}  .slideshow-classic__title {
                  color: {% if item_title_alpha != 0 %}{{ block.settings.item_title_color }}{% else %}{{ settings.heading_color }}{% endif %};
              }

              @media only screen and (min-width: 799px) {
                #shopify-section-{{ block.id }} .caption-content {
                  width: {{ block.settings.text_width }}%;
                  height: 100%;

                }
              }

              @media only screen and (max-width: 480px) {
                #shopify-section-{{ block.id }}  .slideshow-classic__heading {
                  color: {% if mobile_headline_alpha != 0 %}{{ block.settings.heading_color_mobile}}{% endif %};
                }
                #shopify-section-{{ block.id }}  .slideshow-classic__preheading {
                  color: {% if mobile_preheading_alpha != 0 %}{{ block.settings.pretext_color_mobile}}{% endif %};
                }
                #shopify-section-{{ block.id }}  .slideshow-classic__subheading {
                  color: {% if mobile_subtitle_alpha != 0 %}{{ block.settings.subheading_color_mobile}}{% endif %};
                }
              }
            {% endstyle -%}

            {% if video != blank %}
              <video
                src="{{ video }}"
                type="video/mp4"
                class="custom-image-element__wrap image-element__wrap is-hidden-mobile-only slideshow-classic__background-image"
                preload="metadata"
                loop
                muted
                autoplay
                playsinline
                loading="lazy"
              ></video>
              <!--
                <video class="custom-image-element__wrap image-element__wrap is-hidden-mobile-only slideshow-classic__background-image" loop muted autoplay playsinline preload="metadata" >
                    <source
                      src="{{ video }}"
                      type="video/webm"
                    >
                </video>
              -->
            {% else %}
              <div class="custom-image-element__wrap image-element__wrap is-hidden-mobile-only slideshow-classic__background-image ">
                <img
                  src="{{ image | img_url: 'master' }}"
                  {% if forloop.index0 != 0 %}
                    loading="lazy"
                  {% else %}
                    loading="eager"
                    fetchpriority="high"
                  {% endif %}
                >
              </div>
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg is-hidden-mobile-only' }}
            {% endif %}

            {% if mobile_video != blank %}
              <video
                src="{{ mobile_video }}"
                type="video/mp4"
                class="custom-image-element__wrap image-element__wrap is-hidden-desktop-only slideshow-classic__background-image"
                preload="metadata"
                loop
                muted
                autoplay
                playsinline
                loading="lazy"
              ></video>
            {% else %}
              {% render 'image-element',
                image: mobile_image,
                alt: mobile_image.alt,
                stretch_width: true,
                additional_wrapper_classes: 'is-hidden-desktop-only slideshow-classic__background-image',
                focal_point: mobile_image.presentation.focal_point
              %}
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg is-hidden-desktop-only' }}
            {% endif %}

            {% if pretext != blank
              or mobile_pretext != blank
              or title != blank
              or mobile_title != blank
              or subtitle != blank
              or mobile_subtitle != blank
              or button_1 != blank
              or button_2 != blank
            %}
              <div class="caption text-align-{{ text_horizontal_position }}">
                <div
                  class="
                    {% if block.settings.bf25_title_text_enabled %}bf25-caption-wrapper {% else %}caption-content{% endif %}
                    text-align-{{ block.settings.text_alignment }}
                    {% if block.settings.mobile_text_alignment != 'none' %}
                      text-align--mobile-{{ block.settings.mobile_text_alignment }}
                    {% endif %}
                  "
                >
                  {% if pretext != blank %}
                    <div
                      class="
                        slideshow-classic__preheading
                        pretext
                        is-hidden-mobile-only
                      "
                    >
                      {{- pretext -}}
                    </div>
                  {% endif %}

                  {% if mobile_pretext != blank %}
                    <div
                      class="
                        slideshow-classic__preheading
                        pretext
                        is-hidden-desktop-only
                      "
                    >
                      {{- mobile_pretext -}}
                    </div>
                  {% endif %}

                  {% if block.settings.bf25_title_text_enabled and block.settings.bf25_title_text != blank %}
                    <div class="bf25-caption-wrapper">
                      <div
                        class="
                          slideshow-classic__heading--bf25
                          {% if title != mobile_title  %}is-hidden-mobile-only{% endif %}
                        "
                      >
                        {{- block.settings.bf25_title_text -}}
                      </div>
                      <div class="cta-and-review-section">
                        {% render 'bf25-cta', block: block %}
                        <div class="reveiwsection bf25">
                          <!--
                            <div id="feefo-service-review-carousel-widgetId" class="feefo-review-carousel-widget-service"></div>
                          -->
                          <div class="award-winning" style="opacity: 1;">
                            <div class="image" style="opacity: 1;">
                              <img
                                src="{{ section.settings.gallery_image1 | img_url: "800x"}}"
                                style="opacity: 1;"
                                loading="lazy"
                              >
                            </div>
                            <div class="image" style="opacity: 1;">
                              <img
                                src="{{ section.settings.gallery_image2 | img_url: "800x"}}"
                                style="opacity: 1;"
                                loading="lazy"
                              >
                            </div>
                            <div class="image" style="opacity: 1;">
                              <img
                                src="{{ section.settings.gallery_image3 | img_url: "800x"}}"
                                style="opacity: 1;"
                                loading="lazy"
                              >
                            </div>
                            <div class="image" style="opacity: 1;">
                              <img
                                src="{{ section.settings.gallery_image4 | img_url: "800x"}}"
                                style="opacity: 1;"
                                loading="lazy"
                              >
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {% else %}
                    {% if title != blank %}
                      <h2
                        class="
                          slideshow-classic__heading
                          title
                          {% if title != mobile_title  %}is-hidden-mobile-only{% endif %}
                        "
                      >
                        {{- title -}}
                      </h2>

                      {% if mobile_title != blank and title != mobile_title %}
                        <h2
                          class="
                            slideshow-classic__heading
                            title
                            {% if title != mobile_title  %}is-hidden-desktop-only{% endif %}
                          "
                        >
                          <span>
                            {{- mobile_title -}}
                          </span>
                        </h2>
                      {% endif %}

                      {% if subtitle != blank or mobile_subtitle != blank %}
                        <div class="slideshow-classic__subheading subtitle">
                          {% if subtitle != blank %}
                            <div class="is-hidden-mobile-only">
                              {{- subtitle -}}
                            </div>
                          {% endif %}

                          {% if mobile_subtitle != blank %}
                            <div class="is-hidden-desktop-only">
                              {{- mobile_subtitle -}}
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}

                      <div
                        class="
                          slideshow-classic__small-image-and-review
                          {% if block.settings.image_small == blank %}
                            is-flex-column
                          {% endif %}
                        "
                      >
                        <div class="slideshow-classic__small-image-and-review__first-part">
                          {% if block.settings.image_small != blank %}
                            <div class=" slideshow-classic__small-image is-hidden-mobile-only">
                              {% render 'image-element',
                                image: block.settings.image_small,
                                alt: block.settings.image_small.alt
                              %}
                            </div>
                          {% endif %}
                          {% if block.settings.image_small_mobile != blank %}
                            <div class=" slideshow-classic__small-image-mobile is-hidden-desktop-only">
                              {% render 'image-element',
                                image: block.settings.image_small_mobile,
                                alt: block.settings.image_small_mobile.alt
                              %}
                            </div>
                          {% endif %}

                          <div class="slideshow-classic__description-and-button">
                            {% if block.settings.item_title != blank %}
                              <div class="slideshow-classic__title ambit-black-text">
                                {{- block.settings.item_title -}}
                              </div>
                            {% endif %}
                            {% if block.settings.description != blank %}
                              <div class="slideshow-classic__description">
                                {{- block.settings.description -}}
                              </div>
                            {% endif %}
                            {% if button_1 != blank or button_2 != blank %}
                              <div
                                class="
                                  slideshow-classic__buttons
                                  buttons
                                  buttons-auto-width
                                  {% unless buttons == true %}
                                    is-justify-{{ block.settings.text_alignment }}
                                  {% endunless %}
                                "
                              >
                                {% if button_1 != blank %}
                                  {% render 'button',
                                    label: button_1,
                                    href: button_1_link,
                                    type: 'link',
                                    style: block.settings.button_1_style
                                  %}
                                {% endif %}

                                {% if button_2 != blank %}
                                  {% render 'button',
                                    label: button_2,
                                    href: button_2_link,
                                    type: 'link',
                                    style: block.settings.button_2_style
                                  %}
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>
                    {% endif %}

                    <div class="reveiwsection">
                      <!--
                        <div id="feefo-service-review-carousel-widgetId" class="feefo-review-carousel-widget-service"></div>
                      -->
                      <div class="award-winning" style="opacity: 1;">
                        <div class="image" style="opacity: 1;">
                          <img
                            src="{{ section.settings.gallery_image1 | img_url: "800x"}}"
                            style="opacity: 1;"
                            loading="lazy"
                          >
                        </div>
                        <div class="image" style="opacity: 1;">
                          <img
                            src="{{ section.settings.gallery_image2 | img_url: "800x"}}"
                            style="opacity: 1;"
                            loading="lazy"
                          >
                        </div>
                        <div class="image" style="opacity: 1;">
                          <img
                            src="{{ section.settings.gallery_image3 | img_url: "800x"}}"
                            style="opacity: 1;"
                            loading="lazy"
                          >
                        </div>
                        <div class="image" style="opacity: 1;">
                          <img
                            src="{{ section.settings.gallery_image4 | img_url: "800x"}}"
                            style="opacity: 1;"
                            loading="lazy"
                          >
                        </div>
                      </div>
                    </div>
                    </div>
                  {% endif %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="slideshow-classic__banner-line-mobile" />
  <preference name="AllowInlineMediaPlayback" value="true" />
</section>

<style>
  .award-winning .image {
    padding: 0;
    margin: 0 15px;
  }
  .award-winning .image:first-of-type {
    margin: 0 15px 0 0;
  }

  .award-winning {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }

  @media only screen and (max-width: 767px) {
    .award-winning .image {
      margin: 0 10px;
    }
    .awardwinning .page-width {
      padding-left: 5px;
      padding-right: 5px;
    }
  }
</style>

<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-data
>
  {
    "image_transition": {{ section.settings.image_transition | json }},
    "image_slideshow_speed": {{ section.settings.image_slideshow_speed | json }},
    "show_arrows": {{ section.settings.show_arrows | json }},
    "show_nav_buttons": {{ section.settings.show_nav_buttons | json }},
    "number_of_slides": {{ blocks.size | json }}
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsSlideshowClassic.js' | asset_url }}" defer></script>

