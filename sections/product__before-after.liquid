{% style %}
  #shopify-section-{{ section.id }} {
    {% if template.name == 'product' and product.metafields.custom.product_before_after.value.background_color %}
        background-color: {{ product.metafields.custom.product_before_after.value.background_color }};
    {% else %}
        background-color: {{ section.settings.background_color }};
    {% endif %}

   {% if template.name == 'product' and product.metafields.custom.product_before_after.value.text_color %}
        color: {{ product.metafields.custom.product_before_after.value.text_color }};
    {% else %}
        color: {{ section.settings.text_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }} .product__before-after {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product__before-after__title {
    font-size: 34px;
    line-height: 37px;
    font-weight: normal;
    margin-bottom: 50px;
  }

   #shopify-section-{{ section.id }}  .product__before-after__title {
     {% if template.name == 'product' and product.metafields.custom.product_before_after.value.text_color %}
        color: {{ product.metafields.custom.product_before_after.value.text_color }};
    {% else %}
        color: {{ section.settings.text_color }};
    {% endif %}
   }

  .product__before-after__description {
    font-size: 20px;
    line-height: 28px;
    font-weight: normal;
    margin-bottom: 40px;
    width: 60%;
  }

  #shopify-section-{{ section.id }}  .product__before-after__description {
     {% if template.name == 'product' and product.metafields.custom.product_before_after.value.text_color %}
        color: {{ product.metafields.custom.product_before_after.value.text_color }};
    {% else %}
        color: {{ section.settings.text_color }};
    {% endif %}
  }

  .product__before-after__comparison {
    width: 100%;
    position: relative;
  }

  .product__before-after__label-container {
    position: absolute;
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 0 36px;
    bottom: 32px;

    /* z-index: 3; */
  }

  .product__before-after__label {
    text-shadow: 4px 4px 4px #00000040;
    font-size: 34px;
    line-height: 37px;
    font-weight: 900;
    color: #F7F5F1;
  }

  .product__before-after__comparison-container {
    width: 100%;
    height: 700px;
    max-width: 100%;
    position: relative;
}

.product__before-after__comparison-wrapper {
    position: relative;
    width: 100%;
    height: 700px;
    overflow: hidden;
    border-radius: 10px;
}

.product__before-after__comparison-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 700px;
    overflow: hidden;
}

.product__before-after__comparison-image img {
    width: 100%;
    height: 700px;
    /* display: block; */
   display: flex;
    
  object-fit: cover;
}

.product__before-after__comparison-before {
    /* z-index: 1; */
}

.product__before-after__comparison-after {
    /* z-index: 2; */
    clip-path: inset(0 50% 0 0); /* Initially half visible */
}

.product__before-after__comparison-slider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 6px;
    height: 100%;
    background-color: {{ product.metafields.custom.product_before_after.value.slider_color }};
    cursor: ew-resize;
  /* z-index: 3; */
    display: flex;
    justify-content: center;
    align-items: center;
}

.product__before-after__slider-handle {
    position: absolute;
    width: 58px;
    height: 27px;
    bottom: 70px;
}

  .product__before-after__comparison-container,
.product__before-after__comparison-container * {
    user-select: none; /* Disable text/image selection */
    -webkit-user-drag: none; /* Prevent image dragging in WebKit browsers */
}


  @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} .product-video-with-content {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: 20px;
      padding-right: 20px;
    }

  .product__before-after__title {
    font-size: 34px;
    line-height: 37px;
    margin-bottom: 30px;
    }

  .product__before-after__description {
    font-size: 20px;
    line-height: 28px;
    width: 100%;
    margin-bottom: 40px;
    }

    .product__before-after__label-container {
      bottom: 17px;
      padding: 0 15px;
    }

    .product__before-after__label {
      font-size: 16px;
    }

    .product__before-after__slider-handle {
      bottom: 46px;
    }

    .product__before-after__comparison-image img, .product__before-after__comparison-container, .product__before-after__comparison-wrapper {
      height: 450px;
    }
  }

   {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}
{% if product.metafields.custom.product_before_after %}

    {% assign metaobject = product.metafields.custom.product_before_after.value %}
    <section
      class="
        section
        {{ section.settings.css_class }}
        product__before-after
      "
    >
      {% if metaobject.title != blank %}
                <h2 class="product__before-after__title">
                  {{ metaobject.title }}
                </h2>
            {% endif %}
          {% if metaobject.description != blank %}
                <div class="product__before-after__description">
                  {{ metaobject.description }}
                </div>
            {% endif %}
      <div class="product__before-after__comparison">
        <div class="product__before-after__comparison-container">
        <div class="product__before-after__comparison-wrapper">
            <div class="product__before-after__comparison-image product__before-after__comparison-before">
              <img src="{{ metaobject.after_image_link }}" alt="After Image"> 
            </div>
            <div class="product__before-after__comparison-image product__before-after__comparison-after">
                <img src="{{ metaobject.before_image_link }}" alt="Before Image">
            </div>
            <div class="product__before-after__comparison-slider">
                <div class="product__before-after__slider-handle">
                  <svg width="58" height="27" viewBox="0 0 58 27" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M0 13.5C0 6.04416 6.04416 0 13.5 0H44.5C51.9558 0 58 6.04416 58 13.5C58 20.9558 51.9558 27 44.5 27H13.5C6.04416 27 0 20.9558 0 13.5ZM49.0102 14.7245L41.051 19.4184C40.4388 19.7755 39.7245 19.6224 39.2653 19.1122C38.8061 18.602 38.8571 17.8367 39.2653 17.3265L41.8163 14.4694C42.2755 13.9592 42.2755 13.1429 41.8163 12.6327L39.2653 9.77551C38.8061 9.26531 38.8061 8.5 39.2653 7.9898C39.7245 7.47959 40.4388 7.32653 41.051 7.68367L49.0102 12.3776C49.4694 12.6327 49.6735 13.0918 49.6735 13.551C49.6735 14.0102 49.4184 14.4694 49.0102 14.7245ZM16.949 7.58163L8.9898 12.2755C8.58163 12.5306 8.32653 12.9898 8.32653 13.449C8.32653 13.9082 8.53061 14.3673 8.9898 14.6224L16.949 19.3163C17.5612 19.6735 18.2755 19.5204 18.7347 19.0102C19.1939 18.5 19.1939 17.7347 18.7347 17.2245L16.1837 14.3673C15.7245 13.8571 15.7245 13.0408 16.1837 12.5306L18.7347 9.67347C19.1429 9.16327 19.1939 8.39796 18.7347 7.88775C18.2755 7.37755 17.5612 7.22449 16.949 7.58163Z" fill="{{ product.metafields.custom.product_before_after.value.slider_color }}"/>
                  </svg>
                </div>
            </div>
        </div>
    </div>
        <div class="product__before-after__label-container">
          <p class="product__before-after__label">Before</p>
          <p class="product__before-after__label">After</p>
        </div>
      </div>
    </section>
{% endif %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const slider = document.querySelector('.product__before-after__comparison-slider');
    const afterImage = document.querySelector('.product__before-after__comparison-after');
    let isDragging = false;

    const handleMouseMove = (e) => {
        if (!isDragging) return;

        let rect = slider.parentElement.getBoundingClientRect();
        let xPos = e.clientX - rect.left;

        if (xPos < 0) xPos = 0;
        if (xPos > rect.width) xPos = rect.width;

        const percent = (xPos / rect.width) * 100;

        slider.style.left = `${percent}%`;
        afterImage.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
    };

    slider.addEventListener('mousedown', () => (isDragging = true));
    document.addEventListener('mouseup', () => (isDragging = false));
    document.addEventListener('mousemove', handleMouseMove);

    // For touch devices
    slider.addEventListener('touchstart', () => (isDragging = true));
    document.addEventListener('touchend', () => (isDragging = false));
    document.addEventListener('touchmove', (e) => handleMouseMove(e.touches[0]));
});
</script>
