{% style %}
    #shopify-section-{{ section.id }} .product__compare {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if template.name == 'product' and product.metafields.custom.compare_product.value.background_color %}
        background-color: {{ product.metafields.custom.compare_product.value.background_color }};
    {% else %}
        background-color: {{ section.settings.background_color }};
    {% endif %}
    }

  .product__compare__title {
      font-weight: normal;
    }

    #shopify-section-{{ section.id }} .product__compare__title {
      {% if template.name == 'product' and product.metafields.custom.compare_product.value.text_color %}
        color: {{ product.metafields.custom.compare_product.value.text_color }};
    {% else %}
        color: {{ section.settings.text_color }};
    {% endif %}
      
    }

    #shopify-section-{{ section.id }} .product__compare__title {
      font-size: {{ section.settings.title-font-size }}px;
    }

  .product__compare__container {
    display: flex;
    gap: 25px;
  }

  .product__compare__product-container, .product__compare__other-brand-container, .product__compare__our-brand-container {
    width: 33%;
    border-radius: 10px;
    padding: 30px;
  }

  .product__compare__logo-container {
    height: 350px;
    display: flex;
    align-items: center;
  }

  .product__compare__logo > img {
    object-fit: cover;
  }

  .product__compare__other-brand-name {
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: center;
    width: 100%;
    height: 100%;
    font-size: 24px;
    font-weight: 900;
    line-height: 1;
  }

  .product__compare__our-logo {
    width: 192px;
    height: 71px;
  }

  .product__compare__our-brand-container {
    {% if template.name == 'product' and product.metafields.custom.compare_product.value.our_brand_background_color %}
        background-color: {{ product.metafields.custom.compare_product.value.our_brand_background_color }};
    {% endif %}
  }

  .product__compare__other-brand-container {
    border: 1px solid;
    border-color: {{ '#3F4444' | color_modify: 'alpha', 0.2  }}
  }

  .product__compare__item-icon {
    width: 26px;
    height: 26px;
    margin-right: 35px; 
  }

  .product__compare__item-icon-img {
    width: 26px;
    height: 26px;
  }

  .product__compare__item-text {
    font-size: 20px;
  }

  .product__compare__item {
    display: flex;
    padding: 18px 30px;
    flex: 1;
  }

  .product__compare__item__bottom-border {
    border-bottom: 1px solid;
    border-color: {{ '#3F4444' | color_modify: 'alpha', 0.3  }};
  }

  .product__compare__has-icon, .product__compare__has-icon > img {
    width: 31px;
    height: 31px;
  }

  .product__compare__item-text-mobile {
    display: none;
  }

  @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} .product__compare {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .product__compare__title {
        font-size: {{ section.settings.title-font-size-mobile }}px;
      }

    .product__compare__container {
      flex-direction: column;
    }

    .product__compare__product-container, .product__compare__other-brand-container, .product__compare__our-brand-container {
      width: 100%;
    }

    .product__compare__logo-container {
      height: 305px;
    }

    .product__compare__product-container .product__compare__items-container {
      display: none;
    }

    .product__compare__other-brand-container .product__compare__logo-container, .product__compare__our-brand-container .product__compare__logo-container{
      height: fit-content;
    }

     .product__compare__item-text-mobile {
      display: flex;
    }

    .product__compare__item {
      display: flex;
      justify-content: space-between;
    }

    .product__compare__has-icon {
      margin: 0;
      width: 28px;
      height: 28px;
    }

    .product__compare__has-icon > img {
      width: 28px;
      height: 28px;
    }

    .product__compare__our-logo {
      width: 128px;
      height: 47px;
    }

    .product__compare__item {
      padding: 18px 0;
    }

    .product__compare__our-brand-container .product__compare__item .product__compare__item-text-mobile {
      {% if template.name == 'product' and product.metafields.custom.compare_product.value.our_brand_text_color %}
        color: {{ product.metafields.custom.compare_product.value.our_brand_text_color }};
    {% elsif  template.name == 'product' and product.metafields.custom.compare_product.value.text_color %}
        color: {{ product.metafields.custom.compare_product.value.text_color }};
     {% else %}   
        color: {{ section.settings.text_color }};
    {% endif %}
    }
  }

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}
