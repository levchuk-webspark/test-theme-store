{% assign data = section.settings %}
{% assign cards = section.blocks | where: 'type', 'card' %}

{% style %}
  .customers-reported {
    padding: 124px 0 24px;
    background: #fff;
  }

  .customers-reported__wrapper {
    margin: 0 auto;
    max-width: 1280px;
    padding: 0 20px;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .customers-reported__title {
    font-family: 'Romie' !important;
    color: #284734;
    font-weight: 400;
    font-size: 56px;
    line-height: 1.3;
    letter-spacing: -2.2%;
    text-align: center;
    margin-bottom: 8px;
  }

  .customers-reported__disclaimer,
  .customers-reported__description {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -2.2%;
    text-align: center;
    max-width: 630px;
    margin: 0 auto;
    color: #949992;
  }

  .customers-reported__description {
    margin-bottom: 24px;
  }

  .customers-reported__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 80px;
  }

  .customers-reported__card {
    flex: 0 0 calc(25% - ((8px * 3) / 4));
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 8px;
    margin-bottom: 16px;
  }

  .customers-reported__card-percent {
    font-family: Ambit SemiBold !important;
    font-weight: 600;
    font-size: 76px;
    letter-spacing: -2.2%;
    text-transform: capitalize;
    line-height: 1.25;
    color: #284734;
    text-align: center;
    margin: 0 auto 12px;
  }

  .customers-reported__card-title {
    font-family: Ambit SemiBold !important;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -2.2%;
    color: #284734;
    text-align: center;
    margin: 0 auto 8px;
  }

  .customers-reported__card-description {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: -2.2%;
    text-align: center;
    color: #44693D;
  }

  @media (max-width: 1200px) {}

  @media (max-width: 991px) {
    .customers-reported__list {
      flex-wrap: wrap;
      margin-bottom: 64px;
    }

    .customers-reported__card {
      flex: 0 0 calc(50% - (8px / 2));
    }
  }

  @media (max-width: 768px) {
    .customers-reported {
      padding: 80px 0 24px;
    }

    .customers-reported__title {
      font-size: 48px;
    }

    .customers-reported__list {
      flex-wrap: nowrap;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 48px;
    }

    .customers-reported__card {
      flex: 1 1 auto;
    }

    .customers-reported__card-percent {
      margin-bottom: 8px;
    }
  }

  @media (max-width: 425px) {
    .customers-reported__title {
      font-size: 36px;
    }
  }
{% endstyle %}

<section class="customers-reported customers-reported--{{ template.suffix }}">
  <div class="customers-reported__wrapper">
    <div class="customers-reported__head">
      {% if data.title != blank %}
        <h2 class="customers-reported__title">{{ data.title }}</h2>
      {% endif %}
      {% if data.description != blank %}
        <p class="customers-reported__description">{{ data.description }}</p>
      {% endif %}
    </div>
    <ul class="customers-reported__list">
      {% for block in cards %}
        {% assign card = block.settings %}

        <li class="customers-reported__card">
          {% if card.percent != blank %}
            <h3 class="customers-reported__card-percent">{{ card.percent }}</h3>
          {% endif %}
          {% if card.title != blank %}
            <h4 class="customers-reported__card-title">{{ card.title }}</h4>
          {% endif %}
          {% if card.description != blank %}
            <p class="customers-reported__card-description">{{ card.description }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    {% if data.disclaimer != blank %}
      <div class="customers-reported__disclaimer">{{ data.disclaimer }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Customers Reported",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Section title"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section description"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Section disclaimer"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "percent",
          "label": "Card percent"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Card description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing: Customers Reported"
    }
  ]
}
{% endschema %}
