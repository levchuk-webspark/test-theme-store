{% assign tip_card_first_cards = section.blocks | where: 'type', 'tip_card_first_card' %}
{% assign tip_card_second_cards = section.blocks | where: 'type', 'tip_card_second_card' %}
{% assign tip_card_third_cards = section.blocks | where: 'type', 'tip_card_third_card' %}
{% assign tip_card_fourth_cards = section.blocks | where: 'type', 'tip_card_fourth_card' %}
{% assign tip_card_fifth_cards = section.blocks | where: 'type', 'tip_card_fifth_card' %}
{% assign filters = section.blocks | where: 'type', 'filter' %}

{% assign first_row_filter = "first_row_filter" %}
{% assign second_row_filter = "second_row_filter" %}
{% assign third_row_filter = "third_row_filter" %}
{% assign fourth_row_filter = "fourth_row_filter" %}
{% assign fifth_row_filter = "fifth_row_filter" %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
   #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .longevity-tips__title {
    font-size: {{ section.settings.title-font-size }}px;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .hidden {
    display: none;
  }

  .longevity-tips__title {
       line-height: 1.1;
       margin-bottom: 68px;
     }
  
  #shopify-section-{{ section.id }} .longevity-tips__description {
    font-size: {{ section.settings.description-font-size }}px;
    color: {{ section.settings.text_color }};
  }

  .longevity-tips__description {
      line-height: 1.1;
      margin-bottom: 36px;
  }

  .longevity-tips__cards-list {
    display: flex;
    
    align-items: stretch; 
    justify-content: space-between;
    
    gap: 45px;
  }

  .longevity-tips__cards-list-carousel {
    display: flex;
    
    align-items: stretch; 
    justify-content: space-between;
    
    gap: 45px;
    margin-bottom: 50px;

    height: {{ section.settings.card-size }}px;
  }

  .longevity-tips__card {
    width: {{ section.settings.card-size }}px;
    height: {{ section.settings.card-size }}px;
    border-radius: 10px;
    padding: 40px;
    margin-right: 45px;
  }

  .longevity-tips__card-opacity {
    width: {{ section.settings.card-size }}px;
    height: {{ section.settings.card-size }}px;

    position: absolute;
    top: 0;
    left: 0;
    border-radius: 10px;
  }

  .longevity-tips__cover__title {
    font-size: {{ section.settings.card-title-font-size }}px;
    font-weight: 900;
    line-height: 1;
    width: 60%;

    display: flex;
    align-items: center;
  }

  .longevity-tips__card-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .longevity-tips__cover__bottom {
    display: flex;
    justify-content: space-between;
  }

  .longevity-tips__cover__icon {
    width: {{ section.settings.card-icon-size }}px;
    height: {{ section.settings.card-icon-size }}px;
  }

  .longevity-tips__cover__icon.image-element__wrap {
    margin-left: unset;
    margin-right: unset;
  }

  .longevity-tips__nav-buttons {
    display: flex;
    align-self: end;

    width: 55px;
    justify-content: space-between;
  }

  .longevity-tips__nav-buttons__prev, .longevity-tips__nav-buttons__next {
    border: none;
    background: none;
    padding: 0;
    color: {{ section.settings.nav_button_color }};
    cursor: pointer
  }

  .longevity-tips__card-top {
    display: flex;
    justify-content: space-between;
  }

  .longevity-tips__card-title {
    font-weight: 900;
    font-size: 12px;
    line-height: 1.1;
    width: 40%;
    text-align: end;
  }

  .longevity-tips__card-tip {
    font-size: {{ section.settings.card-title-font-size }}px;
    font-weight: 900px;
  }

  .longevity-tips__card-number {
    border-radius: 50%;
    width: {{ section.settings.card-title-font-size | plus: 2 }}px;
    height: {{ section.settings.card-title-font-size | plus: 2 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    font-size: {{ section.settings.card-title-font-size | minus: 5 }}px;
    margin-left: 14px;
  }

  .longevity-tips__list {
    list-style: disc;
    font-size: {{ section.settings.card-text-font-size }}px;
    line-height: 1.1;
    margin-top: 30px;
  }

  .longevity-tips__item {
    margin-left: 20px;
  }

  .longevity-tips__list li:first-child {
    margin-bottom: {{ section.settings.card-text-font-size }}px;
  }

  .longevity-tips__filter__container {
    display: flex;
    gap: 25px;
    margin-bottom: 69px;
    flex-wrap: wrap;
  }

  .longevity-tips__filter__item {
    padding: 17px;
    border-radius: 58px;
    font-size: 20px;
    border: none;
    cursor: pointer;
    text-align: center;
  }

   @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .longevity-tips__title {
      font-size: {{ section.settings.title-font-size-mobile }}px;
    }

     .longevity-tips__title {
       margin-bottom: 21px;
     }

    #shopify-section-{{ section.id }} .longevity-tips__description {
      font-size: {{ section.settings.description-font-size-mobile }}px;
    }

     .longevity-tips__description {
       margin-bottom: 19px;
     }

    .longevity-tips__cards-list {
    gap: 25px;
  }

  .longevity-tips__cards-list-carousel {
    margin-bottom: 20px;
    height: {{ section.settings.card-size-mobile }}px;
  }

  .longevity-tips__card {
    width: {{ section.settings.card-size-mobile }}px;
    height: {{ section.settings.card-size-mobile }}px;
    padding: 20px;
    margin-right: 25px;
  }
     
  .longevity-tips__card-opacity {
    width: {{ section.settings.card-size-mobile }}px;
    height: {{ section.settings.card-size-mobile }}px;
  }

  .longevity-tips__cover__title {
    font-size: {{ section.settings.card-title-font-size-mobile }}px;
  }

  .longevity-tips__cover__icon {
    width: {{ section.settings.card-icon-size-mobile }}px;
    height: {{ section.settings.card-icon-size-mobile }}px;
  }

  .longevity-tips__card-number {
    width: {{ section.settings.card-title-font-size-mobile | plus: 2 }}px;
    height: {{ section.settings.card-title-font-size-mobile | plus: 2 }}px;
    padding: 5px;
    font-size: {{ section.settings.card-title-font-size-mobile | minus: 5 }}px;
    margin-left: 7px;
  }

  .longevity-tips__list {
    font-size: {{ section.settings.card-text-font-size-mobile }}px;
    margin-top: 20px;
  }

  .longevity-tips__item {
    margin-left: 14px;
  }

  .longevity-tips__list li:first-child {
    margin-bottom: {{ section.settings.card-text-font-size-mobile }}px;
  }

  .longevity-tips__cover__title_block {
    display: flex;
    justify-content: space-between;
  }

   .longevity-tips__cover__title_block .longevity-tips__nav-buttons {
     width: fit-content;
     height: 100%;
    align-items: baseline;
   }

  .longevity-tips__filter__container {
    margin-bottom: 35px;
    gap: 10px;
  }

  .longevity-tips__filter__item {
    font-size: 15px;
    padding: 13px;
  }
}
  @media only screen and (min-width: 799px) {
    .longevity-tips__nav-buttons {
      width: 130px;
    }

    .longevity-tips__nav-buttons .icon {
      width: 53px;
      height: 53px;
    }

    .longevity-tips__cover_card {
      position: absolute;
      left: 0;
      z-index: 1; 
    } 

    .carousel-{{ section.id }}-tip_card_first_cards, 
    .carousel-{{ section.id }}-tip_card_second_cards,
    .carousel-{{ section.id }}-tip_card_third_cards,
    .carousel-{{ section.id }}-tip_card_fourth_cards,
    .carousel-{{ section.id }}-tip_card_fifth_cards {
      padding-left: {{ section.settings.card-size | plus: 45 }}px;
    }
  }
  
  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}
{% endstyle %}
<section
  class="
    section
    {{ section.settings.css_class }}
    longevity-tips
  "
>
  {% if section.settings.title != blank %}
    <h1 class="longevity-tips__title">{{ section.settings.title }}</h1>
  {% endif %}
  {% if section.settings.description != blank %}
    <p class="longevity-tips__description">{{ section.settings.description }}</p>
  {% endif %}
  {% if filters.size == 1 %}
    {% assign filter = filters.first.settings %}
    <div class="longevity-tips__filter__container">
      {% style %}
        .longevity-tips__filter__item {
          background-color: {{filter.filter_background_color}};
          color: {{filter.filter_text_color}};
        }
        
        .longevity-tips__filter__item:hover {
          background-color: {{filter.filter_background_color_hover}};
          color: {{filter.filter_text_color_hover}};
        }

        .longevity-tips__filter__item.is_active_filter {
          background-color: {{filter.filter_background_color_hover}};
          color: {{filter.filter_text_color_hover}};
        }
      {% endstyle %}
      {% if filter.first_row_filter_name != blank %}
        <a id="first_row_filter" class="longevity-tips__filter__item" href="{{ page.url }}?{{ first_row_filter }}={{ filter.first_row_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: "," }}">
          {{ filter.first_row_filter_name }}
        </a>
      {% endif %}
      {% if filter.second_row_filter_name != blank %}
        <a id="second_row_filter" class="longevity-tips__filter__item" href="{{ page.url }}?{{ second_row_filter }}={{ filter.second_row_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: "," }}">
          {{ filter.second_row_filter_name }}
        </a>
      {% endif %}
      {% if filter.third_row_filter_name != blank %}
        <a id="third_row_filter" class="longevity-tips__filter__item" href="{{ page.url }}?{{ third_row_filter }}={{ filter.third_row_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: "," }}">
          {{ filter.third_row_filter_name }}
        </a>
      {% endif %}
      {% if filter.fourth_row_filter_name != blank %}
        <a id="fourth_row_filter" class="longevity-tips__filter__item" href="{{ page.url }}?{{ fourth_row_filter }}={{ filter.fourth_row_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: "," }}">
          {{ filter.fourth_row_filter_name }}
        </a>
      {% endif %}
      {% if filter.fifth_row_filter_name != blank %}
        <a id="fifth_row_filter" class="longevity-tips__filter__item" href="{{ page.url }}?{{ fifth_row_filter }}={{ filter.fifth_row_filter_name | remove:" " | remove: ")" | remove: "("  | remove: "'" | remove: "’" | remove: "," }}">
          {{ filter.fifth_row_filter_name }}
        </a>
      {% endif %}
      {% if filter.reset_filter_name != blank %}
        <a id="reset_filter" class="longevity-tips__filter__item is_active_filter" href="{{ page.url }}">
          {{ filter.reset_filter_name }}
        </a>
      {% endif %}
    </div>
  {% endif %}
  {% if tip_card_first_cards.size > 0 %}
        <div id="tip_card_first_card" class="longevity-tips__cards-list-carousel carousel-{{ section.id }}-tip_card_first_cards">
          {% if tip_card_first_cards.first.settings.image != nil and tip_card_first_cards.first.settings.is_cover_card == true %}
            {% style %}
              .card-{{ tip_card_first_cards.first.id }} {
                {% if tip_card_first_cards.first.settings.image != nil %}
                     background: url("{{tip_card_first_cards.first.settings.image | img_url: 'master'}}");
                     background-size:cover;
                     background-position:center;                  
                 {% endif %}
              }
              .card-{{ tip_card_first_cards.first.id }} .longevity-tips__card-opacity {
                background-color: {{ tip_card_first_cards.first.settings.opacity_color | color_modify: 'alpha', 0.6 }};
              }

              .card-{{ tip_card_first_cards.first.id }} .longevity-tips__cover__title {
                color: {{ tip_card_first_cards.first.settings.text_color }};
              }
            {% endstyle %}
          <div class="longevity-tips__card longevity-tips__cover_card card-{{ tip_card_first_cards.first.id }}">
            {% if tip_card_first_cards.first.settings.opacity_color != blank %}
            <div class="longevity-tips__card-opacity"></div>
            <div class="longevity-tips__card-content">
                <div class="longevity-tips__cover__title_block">
                  {% if tip_card_first_cards.first.settings.title != blank %}
                    <h2 class="longevity-tips__cover__title">{{ tip_card_first_cards.first.settings.title }}</h2>
                  {% endif %}
                  <div class="longevity-tips__nav-buttons is-hidden-desktop-only">
                    <button class="longevity-tips__nav-buttons__next tip_card_first_cards__nav-buttons__next-{{ section.id }}-mobile">
                      {% render 'icon', name: 'slider-right-arrow' %}  
                    </button>
                  </div>
                </div>
              
                <div class="longevity-tips__cover__bottom">
                  {% if tip_card_first_cards.first.settings.icon != nil %}
                    {%
                       render 'image-element',
                        image: tip_card_first_cards.first.settings.icon,
                        alt: tip_card_first_cards.first.settings.title,
                        additional_wrapper_classes: 'longevity-tips__cover__icon',
                    %}
                  {% endif %}
                  
                   <div class="longevity-tips__nav-buttons is-hidden-mobile-only">
                    <button class="longevity-tips__nav-buttons__prev tip_card_first_cards__nav-buttons__prev-{{ section.id }}">
                      {% render 'icon', name: 'slider-left-arrow' %}  
                    </button>
                    <button class="longevity-tips__nav-buttons__next tip_card_first_cards__nav-buttons__next-{{ section.id }}">
                      {% render 'icon', name: 'slider-right-arrow' %} 
                    </button>
                    </div>
                </div>
            </div>
            {% endif %}
          </div>
          {% endif %}
          {% for card_first in tip_card_first_cards %}
            {% if forloop.index != 1 %}
              {% style %}
              .card-{{ card_first.id }} {
                background-color: {{ card_first.settings.background_color }};
                color: {{ card_first.settings.text_color }};
              }

              .card-{{ card_first.id }}  .longevity-tips__card-number {
                background-color: {{ card_first.settings.text_color }};
                color: {{ card_first.settings.background_color }};
              }
            {% endstyle %}
              <div class="longevity-tips__card carousel-cell card-{{ card_first.id }}">
                <div class="longevity-tips__card-top">
                  <div class="longevity-tips__cover__title">
                    <span class="longevity-tips__card-tip-text">TIP</span>
                    <span class="longevity-tips__card-number">{{ forloop.index | minus: 1}}</span>
                  </div>
                  {% if tip_card_first_cards.first.settings.title != blank %}
                    <div class="longevity-tips__card-title is-hidden-desktop-only">{{ tip_card_first_cards.first.settings.title }}</div>
                  {% endif %}
                </div>
                <ul class="longevity-tips__list">
                  {% if card_first.settings.tip_1 != blank %}
                    <li class="longevity-tips__item">{{ card_first.settings.tip_1 }}</li>
                  {% endif %}
                  {% if card_first.settings.tip_2 != blank %}
                    <li class="longevity-tips__item">{{ card_first.settings.tip_2 }}</li>
                  {% endif %}
                </ul>
              </div>
            {% endif %}
          {% endfor %}
        </div> 
  {% endif %}

  {% if tip_card_second_cards.size > 0 %}
        <div id="tip_card_second_card" class="longevity-tips__cards-list-carousel carousel-{{ section.id }}-tip_card_second_cards">
          {% if tip_card_second_cards.first.settings.image != nil and tip_card_second_cards.first.settings.is_cover_card == true %}
            {% style %}
              .card-{{ tip_card_second_cards.first.id }} {
                {% if tip_card_second_cards.first.settings.image != nil %}
                     background: url("{{tip_card_second_cards.first.settings.image | img_url: 'master'}}");
                     background-size:cover;
