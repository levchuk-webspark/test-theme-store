              }

              .card-{{ tip_card_second_cards.first.id }} .longevity-tips__cover__title {
                color: {{ tip_card_second_cards.first.settings.text_color }};
              }
            {% endstyle %}
          <div class="longevity-tips__card longevity-tips__cover_card card-{{ tip_card_second_cards.first.id }}">
            {% if tip_card_second_cards.first.settings.opacity_color != blank %}
            <div class="longevity-tips__card-opacity"></div>
            <div class="longevity-tips__card-content">
                <div class="longevity-tips__cover__title_block">
                  {% if tip_card_second_cards.first.settings.title != blank %}
                    <h2 class="longevity-tips__cover__title">{{ tip_card_second_cards.first.settings.title }}</h2>
                  {% endif %}
                  <div class="longevity-tips__nav-buttons is-hidden-desktop-only">
                    <button class="longevity-tips__nav-buttons__next tip_card_second_cards__nav-buttons__next-{{ section.id }}-mobile">
                      {% render 'icon', name: 'slider-right-arrow' %}  
                    </button>
                  </div>
                </div>
              
                <div class="longevity-tips__cover__bottom">
                  {% if tip_card_second_cards.first.settings.icon != nil %}
                    {%
                       render 'image-element',
                        image: tip_card_second_cards.first.settings.icon,
                        alt: tip_card_second_cards.first.settings.title,
                        additional_wrapper_classes: 'longevity-tips__cover__icon',
                    %}
                  {% endif %}
                  
                   <div class="longevity-tips__nav-buttons is-hidden-mobile-only">
                    <button class="longevity-tips__nav-buttons__prev tip_card_second_cards__nav-buttons__prev-{{ section.id }}">
                      {% render 'icon', name: 'slider-left-arrow' %}  
                    </button>
                    <button class="longevity-tips__nav-buttons__next tip_card_second_cards__nav-buttons__next-{{ section.id }}">
                      {% render 'icon', name: 'slider-right-arrow' %} 
                    </button>
                    </div>
                </div>
            </div>
            {% endif %}
          </div>
          {% endif %}
          {% for card_second in tip_card_second_cards %}
            {% if forloop.index != 1 %}
              {% style %}
              .card-{{ card_second.id }} {
                background-color: {{ card_second.settings.background_color }};
                color: {{ card_second.settings.text_color }};
              }

              .card-{{ card_second.id }}  .longevity-tips__card-number {
                background-color: {{ card_second.settings.text_color }};
                color: {{ card_second.settings.background_color }};
              }
            {% endstyle %}
              <div class="longevity-tips__card carousel-cell card-{{ card_second.id }}">
                <div class="longevity-tips__card-top">
                  <div class="longevity-tips__cover__title">
                    <span class="longevity-tips__card-tip-text">TIP</span>
                    <span class="longevity-tips__card-number">{{ forloop.index | minus: 1}}</span>
                  </div>
                  {% if tip_card_second_cards.first.settings.title != blank %}
                    <div class="longevity-tips__card-title is-hidden-desktop-only">{{ tip_card_second_cards.first.settings.title }}</div>
                  {% endif %}
                </div>
                <ul class="longevity-tips__list">
                  {% if card_second.settings.tip_1 != blank %}
                    <li class="longevity-tips__item">{{ card_second.settings.tip_1 }}</li>
                  {% endif %}
                  {% if card_second.settings.tip_2 != blank %}
                    <li class="longevity-tips__item">{{ card_second.settings.tip_2 }}</li>
                  {% endif %}
                </ul>
              </div>
            {% endif %}
          {% endfor %}
        </div>
  {% endif %}

  {% if tip_card_third_cards.size > 0 %}
        <div id="tip_card_third_card" class="longevity-tips__cards-list-carousel carousel-{{ section.id }}-tip_card_third_cards">
          {% if tip_card_third_cards.first.settings.image != nil and tip_card_third_cards.first.settings.is_cover_card == true %}
            {% style %}
              .card-{{ tip_card_third_cards.first.id }} {
                {% if tip_card_third_cards.first.settings.image != nil %}
                     background: url("{{tip_card_third_cards.first.settings.image | img_url: 'master'}}");
                     background-size:cover;
                     background-position:center;                  
                 {% endif %}
              }
              .card-{{ tip_card_third_cards.first.id }} .longevity-tips__card-opacity {
                background-color: {{ tip_card_third_cards.first.settings.opacity_color | color_modify: 'alpha', 0.6 }};
              }

              .card-{{ tip_card_third_cards.first.id }} .longevity-tips__cover__title {
                color: {{ tip_card_third_cards.first.settings.text_color }};
              }
            {% endstyle %}
          <div class="longevity-tips__card longevity-tips__cover_card card-{{ tip_card_third_cards.first.id }}">
            {% if tip_card_third_cards.first.settings.opacity_color != blank %}
            <div class="longevity-tips__card-opacity"></div>
            <div class="longevity-tips__card-content">
                <div class="longevity-tips__cover__title_block">
                  {% if tip_card_third_cards.first.settings.title != blank %}
                    <h2 class="longevity-tips__cover__title">{{ tip_card_third_cards.first.settings.title }}</h2>
                  {% endif %}
                  <div class="longevity-tips__nav-buttons is-hidden-desktop-only">
                    <button class="longevity-tips__nav-buttons__next tip_card_third_cards__nav-buttons__next-{{ section.id }}-mobile">
                      {% render 'icon', name: 'slider-right-arrow' %}  
                    </button>
                  </div>
                </div>
              
                <div class="longevity-tips__cover__bottom">
                  {% if tip_card_third_cards.first.settings.icon != nil %}
                    {%
                       render 'image-element',
                        image: tip_card_third_cards.first.settings.icon,
                        alt: tip_card_third_cards.first.settings.title,
                        additional_wrapper_classes: 'longevity-tips__cover__icon',
                    %}
                  {% endif %}
                  
                   <div class="longevity-tips__nav-buttons is-hidden-mobile-only">
                    <button class="longevity-tips__nav-buttons__prev tip_card_third_cards__nav-buttons__prev-{{ section.id }}">
                      {% render 'icon', name: 'slider-left-arrow' %}  
                    </button>
                    <button class="longevity-tips__nav-buttons__next tip_card_third_cards__nav-buttons__next-{{ section.id }}">
                      {% render 'icon', name: 'slider-right-arrow' %} 
                    </button>
                    </div>
                </div>
            </div>
            {% endif %}
          </div>
          {% endif %}
          {% for card_third in tip_card_third_cards %}
            {% if forloop.index != 1 %}
              {% style %}
