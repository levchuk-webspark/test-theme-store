{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .vitality-buttons-block__buttons-container {
    display: flex;
    align-items: center;
    gap: 20px;
  }

   @media only screen and (max-width: 798px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  
  {%
  render 'css-loop',
  css: section.settings.custom_css,
  id: section.id,
%}
  
{% endstyle %}

<section
  class="
    section
    {{ section.settings.css_class }}
    vitality-buttons-block
  "
>
  <div class="vitality-buttons-block__buttons-container">
        {% for block in section.blocks %}
            {% if block.type == 'button-block' %}
    
                {% if block.settings.button_label != blank %}
                    {% style -%}
                        
                        .block-{{ block.id }}.vitality-buttons-block__button .button--custom {
                          border: 1px solid;
                          overflow-wrap: normal;
                          padding: 19px 42px;
                          font-size: 14px !important;
                        }

                        .block-{{ block.id }}.vitality-buttons-block__button .button--custom,
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--primary.button,
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--secondary.button  {
                          border-radius: {{ block.settings.button_custom_border_radius | append: 'px' }};
                        }
              
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--custom.button,
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--custom.button:link,
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--custom.button:visited {
                          background-color: {{ block.settings.button_custom_bg_color }};
                          color: {{ block.settings.button_custom_text_color }};
                          border-color: {{ block.settings.button_custom_border_color }};
                        }
              
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--custom.button:hover,
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--custom.button.is-hovered {
                          color: {{ block.settings.button_custom_text_color--highlight }};
                          border-color: {{ block.settings.button_custom_border_color--highlight }};
                          background-color: {{ block.settings.button_custom_bg_color--highlight }};
                        }

                      .block-{{ block.id }}.vitality-buttons-block__button a.button--link-style.button {
                        font-size: 13px !important;
                      }

                        .block-{{ block.id }}.vitality-buttons-block__button a.button--link-style.button,
                        .block-{{ block.id }}.vitality-buttons-block__button a.button--link-style.button:visited {
                            color: {{ block.settings.button_custom_text_color }};
                            border-bottom: 1px dashed;
                            border-bottom-color: {{ block.settings.button_custom_border_color }};
                        }

                        .block-{{ block.id }}.vitality-buttons-block__button a.button--link-style.button:hover {
                            color: {{ block.settings.button_custom_text_color--highlight }};
                            border-bottom-color: {{ block.settings.button_custom_border_color--highlight }};
                        }

                        @media only screen and (max-width: 1000px) {
                            .block-{{ block.id }}.vitality-buttons-block__button .button--custom {
                              padding: 19px 10px;
                            }
                        }

                    {%- endstyle -%}
                    
                      <div class="vitality-buttons-block__button block-{{ block.id }}">
                        <a href="{{ block.settings.button_link }}" class="button {{ block.settings.button_style }}">
                          {{ block.settings.button_label }}
                        </a>
                      </div>
                {% endif %}
              
            {% endif %}
      {% endfor %}   
  </div>
</section>

{% schema %}
  {
    "name": "Buttons block",
    "settings": [
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top spacing",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom spacing",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Section background color",
        "default": "rgba(0,0,0,0)"
      },
       {
        "type": "header",
        "content": "Mobile layout"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Mobile top spacing",
        "min": 0,
        "max": 80,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Mobile bottom spacing",
        "min": 0,
        "max": 80,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Advanced",
        "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
      },
      {
        "type": "text",
        "id": "css_class",
        "label": "CSS Class"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS"
      }
    ],
     "blocks": [
       {
        "type": "button-block",
        "name": "Button block",
        "settings": [
          {
            "type": "text",
            "id": "button_label",
            "label": "Button label"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Button style",
            "options": [
              {
                "value": "button--primary",
                "label": "Primary"
              },
              {
                "value": "button--secondary",
                "label": "Secondary"
              },
              {
                "value": "button--link-style",
                "label": "Link style"
              },
              {
                "value": "button--custom",
                "label": "Custom"
              }
            ],
            "default": "button--primary"
          },
          {
            "type": "header",
            "content": "Custom button style"
          },
          {
            "type": "range",
            "id": "button_custom_border_radius",
            "label": "Border radius",
            "min": 0,
            "max": 50,
            "default": 8,
            "unit": "px"
          },
          {
            "type": "color",
            "id": "button_custom_bg_color",
            "label": "Background"
          },      
          {
            "type": "color",
            "id": "button_custom_border_color",
            "label": "Border"
          },
          {
            "type": "color",
            "id": "button_custom_text_color",
            "label": "Text"
          },
          {
            "type": "color",
            "id": "button_custom_bg_color--highlight",
            "label": "Background hover"
          },
          {
            "type": "color",
            "id": "button_custom_border_color--highlight",
            "label": "Border hover"
          },
          {
            "type": "color",
            "id": "button_custom_text_color--highlight",
            "label": "Text hover"
          }
        ]
      }
     ],
    "presets": [
      {
        "name": "Vitality: buttons block"
      }
    ]
  }
{% endschema %}