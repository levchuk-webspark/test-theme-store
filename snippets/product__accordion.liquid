  {% style %}

    .multiple_accordion__wrapper {
        margin-top: -100px;
        padding-top: 100px;
    }

    .multiple_accordion_container-{{ id }}{
        padding: 0px 0px;
        margin:30px auto;
    }
    .multiple_accordion_heading-{{ id }}{
      margin-bottom: 15px;
      font-size:30px;
      font-weight:400;
      color:{{section.settings.heading_color}};
    }
    .multiple_accordion_title-{{ id }}{
      display:grid;
      grid-template-columns:  auto 42px;
      font-size:16px;
      padding: 15px 0px;
      border-bottom:1px solid {{border_color}};
      color:{{section.settings.tab_heading_color}};
    }
    .multiple_accordion_content-{{ id }}{
      text-align:left;
      display:none;
      padding:20px 0;
    }

    .accordian_content_heading-{{ id }}{
        margin-top:30px;
    }

    .multiple_accordion_title-{{ id }}:hover{
      cursor:pointer;
      background-color:{{section.settings.tab_hover_color}};
    }
    .accordion_expand-{{ id }}{
        margin:0px 5px;
        transform:translateY(2px);
    }

    .accordion_collapse-{{ id }}{
        margin:0px 5px;
        transform:translateY(2px);
    }

    .accordion_expand-{{ id }} .icon svg{
     height:60%;
     width:60%;
    }

    .accordion_collapse-{{ id }} .icon svg{
     height:60%;
     width:60%;
    }

    .lab-report-title, .multiple_accordion_item a {
      text-decoration: underline
    }

    .multiple_accordion_title__text {
      text-transform: uppercase;
    }

    @media only screen and (max-width: 600px) {
    .multiple_accordion_content-{{ id }}{
      text-align:left;
      display:none;
      padding: 0;

    }
    }

.awards-container {
