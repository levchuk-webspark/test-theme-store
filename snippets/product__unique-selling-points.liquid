<script>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll('.product__unique-selling-points__item');

    items.forEach((item, index) => {   
      const title = item.querySelector('.product__unique-selling-points__item__text-block__title');
      const description = item.querySelector('.product__unique-selling-points__item__text-block__description');

      if (!title || !description) return;

      // Hide description in the begining
      {% comment %} description.style.display = "none"; {% endcomment %}
      title.classList.add("fade-block");
      description.classList.add("fade-block", "hidden");

      const isMobileMedia = window.matchMedia("(max-width: 798px)");
      if (isMobileMedia.matches) {
        item.addEventListener("click", () => {

          if (description.classList.contains("hidden")) {
          {% comment %} description.style.display = "inline";
          title.style.display = "none"; {% endcomment %}
            title.classList.add("hidden");
            description.classList.remove("hidden");
          } else {
          {% comment %} description.style.display = "none";
          title.style.display = "inline"; {% endcomment %}
            description.classList.add("hidden");
           title.classList.remove("hidden");
          }
        });
      } else {       
        item.addEventListener("mouseenter", () => {
          {% comment %} description.style.display = "inline";
          title.style.display = "none"; {% endcomment %}
          title.classList.add("hidden");
          description.classList.remove("hidden");
        });

        item.addEventListener("mouseleave", () => {
          {% comment %} description.style.display = "none";
          title.style.display = "inline"; {% endcomment %}
          description.classList.add("hidden");
          title.classList.remove("hidden");
        });
      }
    });
  });
</script>