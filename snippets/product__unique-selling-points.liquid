{% style %}

.product__unique-selling-points {
  background-color: {{ block.settings.unique-selling-point-background_color }};
  border-radius: 8px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  /* gap: 24px; */
  column-gap: 24px;
  /* row-gap: 4px; */
  padding: 16px 0;
  {% if template.name == 'product' and product.metafields.custom.product_unique_selling_points.value.background_color %}
    background-color: {{ product.metafields.custom.product_unique_selling_points.value.background_color }};
  {% endif %}
}

  
.product__unique-selling-points__item {
  display: flex;
  /* align-items: start; */
  align-items: center;
  gap: 6px;
  font-size: 10px;

  cursor: pointer;
  min-height: 46px;
  margin-bottom: 4px;
}

.product__unique-selling-points__item__image-container {
  width: 18px;
  min-width: 18px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.product__unique-selling-points__item__image {
  height: 18px;
  width: auto;
}

.product__unique-selling-points__item__text-block {
  display: flex;
  flex-direction: column;
  font-size: {{ block.settings.unique-selling-point-font-size }}px;

  width: 100%;

  line-height: 140%;
}

.product__unique-selling-points__item__text-block__title {  
  font-weight: bold;
  color: {{ block.settings.unique-selling-point-title_color }};
  {% if template.name == 'product' and product.metafields.custom.product_unique_selling_points.value.title_color %}
    color: {{ product.metafields.custom.product_unique_selling_points.value.title_color }};
  {% endif %}
}

.product__unique-selling-points__item__text-block__description {
  color: {{ block.settings.unique-selling-point-description_color }};
  background-color: {{ block.settings.unique-selling-point-description_background_color }};
  {% if template.name == 'product' and product.metafields.custom.product_unique_selling_points.value.description_color %}
    color: {{ product.metafields.custom.product_unique_selling_points.value.description_color }};
  {% endif %}

  border-radius: 5px;
  padding: 6px;
  min-height: 38px;
 
}

.fade-block {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .fade-block.hidden {
    opacity: 0;
  }



@media only screen and (max-width: 1200px) {
  .product__unique-selling-points {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    /* margin-top: 20px; */
  }

}

@media only screen and (max-width: 798px) {
  .product__unique-selling-points__item__image-container {
    width: 15px;
    min-width: 15px;
  }

  .product__unique-selling-points__item__image {
    height: 15px;
    width: auto;
  }

  .product__unique-selling-points__item {
    gap: 3px;
    font-size: 9px;


    min-height: 34px;
    margin-bottom: 3px;
  }

  .product__unique-selling-points__item__text-block {
    font-size: {{ block.settings.unique-selling-point-font-size__mobile }}px;
  }

  .product__unique-selling-points {
    gap: unset;
    column-gap: 9px;
  }

  .product__unique-selling-points__item__text-block__description {
    padding: 3px 4px;

    min-height: 30px;
  }
}

{% endstyle %}

