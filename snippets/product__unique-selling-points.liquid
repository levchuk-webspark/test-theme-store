            <img class="product__unique-selling-points__item__image" 
              {% if template.name == 'product' and product.metafields.custom.product_unique_selling_points.value.image_1 %}
                src="{{ product.metafields.custom.product_unique_selling_points.value.image_1 | image_url }}" 
              {% else %}
                src="{{ block.settings.unique-selling-point-1-image | image_url }}" 
              {% endif %}
              alt="Unique selling point 1 image" 
              >
          </div>
      {% endif %}
      <div class="product__unique-selling-points__item__text-block">
