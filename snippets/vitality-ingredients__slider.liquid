                    {% assign title_with_spaces_4 = file_title_4 | replace: "_", " " %}
                    <span class='vitality-ingredients__modal__cards-list__item__url-icon'>
                      <svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 0.648438C12.5 0.372296 12.2761 0.148439 12 0.148438L7.5 0.148438C7.22386 0.148438 7 0.372296 7 0.648438C7 0.92458 7.22386 1.14844 7.5 1.14844L11.5 1.14844L11.5 5.14844C11.5 5.42458 11.7239 5.64844 12 5.64844C12.2761 5.64844 12.5 5.42458 12.5 5.14844L12.5 0.648438ZM1.35355 12.002L12.3536 1.00199L11.6464 0.294885L0.646447 11.2949L1.35355 12.002Z" fill="#60012C"/>
                      </svg>
                    </span>
                    <a class='vitality-ingredients__modal__cards-list__item__url' href="{{ block.settings.url_link_4 }}" target="_blank">
                      {% if block.settings.label_link_4 != blank %}
                        {{ block.settings.label_link_4 }}
                      {% else %}
                        {{ title_with_spaces_4 }}
                      {% endif %}
                    </a><br>
            {% endif %}
         </div>
        {% endif %}

        {% assign previousIndex = forloop.index | minus: 2 %}
        {% if forloop.index == cards.size %}
          {% assign nextIndex = 0 %}
        {% else %}
          {% assign nextIndex = forloop.index %}
        {% endif %}

        <div class="vitality-ingredients__modal__cards-list__item__footer">
          <div class="vitality-ingredients__modal__cards-list__item__footer-prev">{{ cards[previousIndex].settings.title }}</div>
          <div class="vitality-ingredients__modal__cards-list__item__footer-next">
            {{ cards[nextIndex].settings.title }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="vitality-ingredients__modal__cards-list__item__nav-buttons">
    <div class="vitality-ingredients__modal__cards-list__item__button-prev vitality-ingredients__modal__cards-list__item__button-prev-{{ section.id }}">
      <div class="vitality-ingredients__modal__cards-list__item__arrow-prev"></div>
    </div>
    <div class="vitality-ingredients__modal__cards-list__item__button-next vitality-ingredients__modal__cards-list__item__button-next-{{ section.id }}">
      <div class="vitality-ingredients__modal__cards-list__item__arrow-next"></div>
    </div>
  </div>
</div>
