{% assign hallmark = "hallmark" %}

{% style %}
  .vitality-ingredients__modal-backdrop {
    display: none;
    position: fixed;
    z-index: 1000;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(6, 32, 33, 0.5);
  }

  .vitality-ingredients__modal-backdrop-is-open {
    display: block;
  }

  .vitality-ingredients__modal__content {
    background-color: #ffffff;
    color: #000000;
    top: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    width: 40%;
    padding: 30px 20px;
    position: fixed;
    z-index: 999999;
    transform: translateX(100%);
    transition: transform .3s ease, -webkit-transform .3s ease;
  }

  .vitality-ingredients__modal__content.vitality-ingredients__modal__content__is-open {
    transform: translateX(0);
  }

  .vitality-ingredients__modal__header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 40px;
    line-height: 1.1;
  }

  .vitality-ingredients__modal__title {
    margin-right: 29px;
  }

  .vitality-ingredients__modal__header br {
    display: none;
  }

  .vitality-ingredients__modal__close {
    width: 29px;
    height: 29px;
    cursor: pointer;
    position: absolute;
    right: 20px;
    z-index: 1;
  }

  .vitality-ingredients__modal__cards-list {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .vitality-ingredients__modal__cards-list__item {
    width: 100%;
    display: flex;
    flex-direction: column;

    height: 100vh;
    overflow-y: auto;
    display: flex;
  }

  .vitality-ingredients__modal__cards-list__item__image {
    width: 100%;
    
    height: auto;
    min-height: 50%;
    
    border-radius: 5px;
    overflow: hidden;
    margin-top: 30px;

    max-width: 100%;
  }

  .vitality-ingredients__modal__cards-list__item__image img {
    object-fit: cover;

    max-width: 100%;
  }

  .vitality-ingredients__modal__cards-list__item__description {
    font-size: 16px;
    margin-top: 30px;
    line-height: 1.3;
  }

  .vitality-ingredients__modal__cards-list__item__title_links_block {
    font-size: 16px;
    font-weight: 900;

    margin-top: 40px;
    margin-bottom: 20px;

    width: 60%;
  }

   .vitality-ingredients__modal__cards-list__item__buttons-container {
      display: flex;
      flex-direction: column;
    }
  
  .vitality-ingredients__modal__cards-list__item__information-container {
    margin-top: 30px;
    margin-bottom: 28px;

    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .vitality-ingredients__modal__cards-list__item__information-block {
    display: flex;

    gap: 28px;
  }

  .vitality-ingredients__modal__cards-list__item__information-item {
    display: flex;
    flex-direction: column;

    width: 50%;
  }

  .vitality-ingredients__modal__cards-list__item__information-item-label {
    font-size: 16px;
    font-weight: 900;
    margin-bottom: 10px;
  }

  .vitality-ingredients__modal__cards-list__item__information-item-text {
    font-size: 16px;
  }

  .vitality-ingredients__modal__cards-list__item__links-container {
    margin-bottom: 50px;
  }

  .vitality-ingredients__modal__cards-list__item__url {
    text-decoration: underline;
    font-size: 16px;
    color: {{ block.settings.link_custom_text_color }};
  }

  .vitality-ingredients__modal__cards-list__item__url:hover {
    color: {{ block.settings.link_custom_text_color--highlight }};
  }
  
  .vitality-ingredients__modal__cards-list__item__footer {
    margin-bottom: 40px;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    font-size: 14px;

    gap: 105px;
  }

  .vitality-ingredients__modal__cards-list__item__footer-next {
    text-align: end;
    width: 50%;
  }


  .flickity-prev-next-button {
    display: none;
  }

  .vitality-ingredients__modal__cards-list__item__nav-buttons {
    z-index: 1;

    display: flex;
    align-items: center;
    gap: 15px;

    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 15px;
  }

  .vitality-ingredients__modal__cards-list__item__button-prev,
  .vitality-ingredients__modal__cards-list__item__button-next {
    width: 30px;
    height: 30px;
    border: 1px solid {{ settings.regular_color}};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FFF;

    cursor: pointer;
  }

  .vitality-ingredients__modal__cards-list__item__arrow-prev,
  .vitality-ingredients__modal__cards-list__item__arrow-next {
    width: 6px;
    height: 6px;
    border-top: 1px solid {{ settings.regular_color}};
    border-right: 1px solid {{ settings.regular_color}};
  }

  .vitality-ingredients__modal__cards-list__item__arrow-prev {
    transform: rotate(-135deg);
  }

  .vitality-ingredients__modal__cards-list__item__arrow-next {
    transform: rotate(45deg);
  }

  @media only screen and (max-width: 1000px) {

    .vitality-ingredients__modal__content {
      width: 100%;
      padding: 25px 10px;
    }


    .vitality-ingredients__modal__header {
      font-size: 20px;
    }

    .vitality-ingredients__modal__close {
      width: 20px;
      height: 20px;
      top: 28px;
    }

    .vitality-ingredients__modal__cards-list__item {
      padding: 0 10px;

      height: 100%;
    }

    .vitality-ingredients__modal__cards-list__item__image {
      margin-top: 9px;
      max-height: unset;
      height: 30%;
    }

    .vitality-ingredients__modal__cards-list__item__description {
      font-size: 12px;
      margin-top: 16px;
    }

    .vitality-ingredients__modal__cards-list__item__title_links_block {
      font-size: 12px;
      margin-top: 20px;
      margin-bottom: 10px;
    }

    .vitality-ingredients__modal__cards-list__item__information-container {
      margin-top: 14px;
      margin-bottom: 12px;

      gap: unset;
    }

    .vitality-ingredients__modal__cards-list__item__information-block {
      flex-direction: column;

      gap: unset;
    }

    .vitality-ingredients__modal__cards-list__item__information-item {
      margin-bottom: 12px;

      width: 100%;
    }

    .vitality-ingredients__modal__cards-list__item__information-item-label {
      font-size: 12px;
      margin-bottom: 5px;
    }

  .vitality-ingredients__modal__cards-list__item__information-item-text {
    font-size: 10px;
  }

    .vitality-ingredients__modal__cards-list__item__url {
     font-size: 10px;
    }

    .vitality-ingredients__modal__cards-list__item__footer {
      gap: 85px;
      font-size: 10px;
      margin-bottom: unset;
    }

    .vitality-ingredients__modal__cards-list__item__footer-prev {
      width: 50%;
    }

    .vitality-ingredients__modal__cards-list__item__footer br {
      display: block;
    }

    .vitality-ingredients__modal__cards-list__item__nav-buttons {
      bottom: 20px;
      gap: 12px;
    }

    .vitality-ingredients__modal__cards-list__item__button-prev,
    .vitality-ingredients__modal__cards-list__item__button-next {
      width: 22px;
      height: 22px;
    }

  }

  @media only screen and (max-width: 500px) {
    .vitality-ingredients__modal__close {
      width: 13px;
      height: 13px;
      top: 20px;
    }
  }
{% endstyle %}

<div class="vitality-ingredients__modal-backdrop"></div>
<div class="vitality-ingredients__modal__content">
