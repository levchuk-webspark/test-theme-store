{% style %}
  .bf25-cta {
    display: inline-block;
    padding: 16px 20px;
    background: linear-gradient(90deg, #294031, #71b743);
    color: #ffffff;
    font-size: 30px;
    text-align: center;
    text-decoration: none;
    border-radius: 40px;
    border: none;
    transition: all 0.3s ease;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    letter-spacing: 0;
    line-height: 125%;
    white-space: nowrap;
    margin-bottom: 40px;
    margin-top: 20px;
    position: relative;
    z-index: 10;
    pointer-events: auto;
  }

  .bf25-cta > span {
    font-weight: 500;
  }

  .bf25-cta > strong {
    font-weight: 700;
  }

  .bf25-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    background: linear-gradient(90deg, #294031, #71b743);
    color: #fff;
    filter: brightness(1.1);
  }

  .bf25-cta:active {
    transform: translateY(-1px);
  }

  @media only screen and (max-width: 968px) {
    .bf25-cta {
      padding: 14px 18px;
      font-size: 20px;
      margin-top: 22px;
      margin-bottom: 10px;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
      letter-spacing: 0;
      line-height: 125%;
      white-space: nowrap;
    }
  }

  @media only screen and (max-width: 768px) {
    .bf25-cta {
      padding: 12px 16px;
      font-size: 18px;
      margin-top: 20px;
      margin-bottom: 10px;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
      letter-spacing: 0;
      line-height: 125%;
      white-space: nowrap;
    }
  }

  @media only screen and (max-width: 480px) {
    .bf25-cta {
      padding: 10px 14px;
      font-size: 18px;
      margin-top: 22px;
      /* margin-bottom: 10px; */
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
      letter-spacing: 0;
      line-height: 125%;
      white-space: nowrap;
    }
  }

  @media only screen and (max-width: 389px) {
    .bf25-cta {
      padding: 10px 14px;
      font-size: 16px;
      margin-top: 18px;
      margin-bottom: 0px;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
      letter-spacing: 0;
      line-height: 125%;
      white-space: nowrap;
    }
  }
{% endstyle %}

{% if block.settings.bf25_cta_text %}
  {% assign bf25_link = block.settings.bf25_cta_link | default: routes.collections_url %}
  <a class="bf25-cta" href="{{ block.settings.bf25_cta_link }}">
    {{ block.settings.bf25_cta_text }}
  </a>
{% endif %}
