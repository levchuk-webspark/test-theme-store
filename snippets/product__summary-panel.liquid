{% assign formatArray = product.metafields.jadepuma.format_options | split: ',' %}

{% style %}

  .summary-panel .icons {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .product__summary-panel__format-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product__summary-panel__format-icon svg {
    height: 15px;
    min-height: 15px;
    width: auto;
  }

  .summary-panel .icons:empty {
    display: none;
  }

  .variants-block {
    display: flex;
    gap: 2px;
  }

  .sizeSwatch { 
    color: #F7F5F1;
  }

  .product-product-redesign .summary-panel {
    height: auto;
    margin-bottom: 16px;
  }

  .product-product-redesign .summary-panel.format {
    margin-bottom: 16px;
  }

  .product-product-redesign .panel-cell.size-box,
  .product-product-redesign .panel-cell.format-box {
    border: none;
    padding: 0;
    height: auto;
  }

  .product-product-redesign .panel-cell.size-box .text,
  .product-product-redesign .panel-cell.format-box .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .product-product-redesign .panel-cell.format-box .text .format-icon-container {
    position: static;
    transform: none;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  
  .product-product-redesign .panel-cell.format-box .text .format-icon-container > a {
    background: transparent;
    color: #404544;
    padding: 8px 8px 8px 40px;
    border: 1px solid #D4D8D0;
    transition: all 0.3s ease-in-out;
    font-weight: 400;
    font-size: 14px;
    line-height: 22px;
    border-radius: 8px;
    margin: 0;
    gap: 2px;
    position: relative;
  }

  .product-product-redesign .panel-cell.format-box .text .format-icon-container > a > img {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .product-product-redesign .panel-cell.size-box .text .variants-block {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .product-product-redesign .panel-cell.size-box .text .variants-block > div {
    background: transparent;
    color: #404544;
    padding: 8px;
    border: 1px solid #D4D8D0;
    transition: all 0.3s ease-in-out;
    font-weight: 400;
    font-size: 14px;
    line-height: 22px;
    border-radius: 8px;
    margin: 0;
  }

  .product-product-redesign .panel-cell.size-box .text .variants-block > div > span {
    line-height: inherit;
  }

  .product-product-redesign .panel-cell.format-box .text .format-icon-container > a.selected-icon,
  .product-product-redesign .panel-cell.size-box .text .variants-block > div.size-swatch-selected {
    background: #fff;
    border-color: #284734;
  }
  
{% endstyle %}
{% if product.id != 8845549011157 %}
  <div class="content1">
    {% assign productsArray = product.metafields.jadepuma.format_options.value %}

    <div class="summary-panel format">
      <div class="panel-cell format-box">
        <div class="text">Type:

          {% if template.suffix == 'product-redesign' %}
            {% for p in productsArray %}
              {% if p.id == product.id %}
                {% assign title = p.title | downcase %}
                {% if title contains 'powder' %}
                  Powder
                {% elsif title contains 'ml' %}
                  Liquid
                {% elsif title contains 'capsule' %}
                  Capsules
                {% elsif title contains 'soft' %}
                  Soft gel
                {% elsif title contains 'skincare' %}
                  Skincare
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}

          <div class="format-icon-container">
            {% for p in productsArray %}

              {% if p.id == product.id %}
                {% assign format-icon-class = "selected-icon" %}
              {% else %}
                {% assign format-icon-class = "format-icon" %}
              {% endif %}

              {% assign title = p.title | downcase %}

              {% if title contains 'powder' %}
                <a
                  href="{{ p.url }}"
                  class="{{format-icon-class}} {% if p.available == false %} format_unavailable {% endif %}"
                  title="Powder"
                >
                  {% if template.suffix == 'product-redesign' %}
                    <img src="{{ 'product-type-powder.png' | asset_url }}" alt="Powder type" width="40" height="40" loading="lazy">
                    Powder
                  {% else %}
                    {% render 'format-icons', format: 'powder' %}
                  {% endif %}
                </a>
              {% elsif title contains 'ml' %}
                <a
                  href="{{ p.url }}"
                  class="{{format-icon-class}} {% if p.available == false %} format_unavailable {% endif %}"
                  title="Liquid"
                >
                  {% if template.suffix == 'product-redesign' %}
                    <img src="{{ 'product-type-liquid.png' | asset_url }}" alt="Liquid type" width="40" height="40" loading="lazy">
                    Liquid
                  {% else %}
                    {% render 'format-icons', format: 'liquid' %}
                  {% endif %}
                </a>
              {% elsif title contains 'capsule' %}
                <a
                  href="{{ p.url }}"
                  class="{{format-icon-class}} {% if p.available == false %} format_unavailable {% endif %}"
                  title="Capsules"
                >
                  {% if template.suffix == 'product-redesign' %}
                    <img src="{{ 'product-type-capsules.png' | asset_url }}" alt="Capsules type" width="40" height="40" loading="lazy">
                    Capsules
                  {% else %}
                    {% render 'format-icons', format: 'capsules' %}
                  {% endif %}
                </a>
              {% elsif title contains 'soft' %}
                <a
                  href="{{ p.url }}"
                  class="{{format-icon-class}} {% if p.available == false %} format_unavailable {% endif %}"
                  title="Soft gel"
                >
                  {% if template.suffix == 'product-redesign' %}
                    <img src="{{ 'product-type-softgel.png' | asset_url }}" alt="Soft gel type" width="40" height="40" loading="lazy">
                    Soft gel
                  {% else %}
                    {% render 'format-icons', format: 'softgel' %}
                  {% endif %}
                </a>
                {% elsif title contains 'face mask' %}
                <a
                  href="{{ p.url }}"
                  class="{{format-icon-class}} {% if p.available == false %} format_unavailable {% endif %}"
                  title="Skincare"
                >
                  {% if template.suffix == 'product-redesign' %}
                    Skincare
                  {% else %}
                    {% render 'format-icons', format: 'skincare' %}
                  {% endif %}
                </a>
              {% endif %}

            {% endfor %}
          </div>

        </div>
      </div>
    </div>

    {% assign productFormat = product.metafields.jadepuma.format | downcase %}

    {% assign productFormat = "" %}

    {% assign has_size = false %}

    {%- if product.has_only_default_variant -%}
      {%- if product.metafields.jadepuma.contents_size != blank -%}
        {% assign has_size = true %}
      {%- endif -%}
    {%- else -%}
      {%- for option in product.options_with_values -%}
        {%- if option.name contains "Size" and option.values.size > 0 -%}
          {% assign has_size = true %}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {% if has_size %}
      <div class="summary-panel size">
        <div class="panel-cell size-box">
          {% if product.has_only_default_variant %}
            <div class="text">Size: {{ product.metafields.jadepuma.contents_size }} {{ productFormat }}</div>
          {% else %}

            {% assign option_name = "Size" %}
            {% if product.options.size == 1 %}
              {% for option in product.options %}
                {% assign option_name = option %}
              {%- endfor %}
            {%- endif %}

            <script>

              let variantInfo  = []

              {% assign google_discount_value = 100 | minus: settings.google_discount_percentage | times: 0.01 %}

              {% for variant in product.variants %}
                
                variantInfo.push({
                  "index": {{forloop.index}},
                  "servingSize": "{{variant.metafields.jadepuma.serving_size}}",
                  "nrv" : `{{variant.metafields.jadepuma.nrv}}`,
                  "price" : "{{variant.price | money}}",
                  "comparePrice" : "{{variant.compare_at_price | money}}",
                  "subscriptionPrice" : "{{variant.price | times: 0.75 |  money}}",
                  "googleShoppingDiscountPrice" : "{{variant.price | times: google_discount_value |  money}}",
                  "variantID" : {{variant.id}}
                })

              {% endfor %}

            </script>

            <div class="text">
              {% if template.suffix == 'product-redesign' %}
                {% assign all_sizes = '' %}
                {% for variant in product.variants %}
                  {% if forloop.index == 1 %}
                    {% assign first_size = variant.title %}
                  {% endif %}
                  {% assign all_sizes = all_sizes | append: variant.title %}
                  {% unless forloop.last %}
                    {% assign all_sizes = all_sizes | append: ',' %}
                  {% endunless %}
                {% endfor %}
              <div class="text_name" data-current-size="{{ first_size }}" data-all-sizes="{{ all_sizes }}">
                  Size:
                </div>
              {% else %}
                <div class="text_name">
                  {{ option_name }}:
                </div>
              {% endif %}

              <div class="variants-block">
              {% for variant in product.variants %}

                {% assign variantIndex = forloop.index | minus: 1 %}

                {% if variant.available == false %}

                {% endif %}

                <div
                  class="sizeSwatch {% if forloop.index == 1 %}size-swatch-selected{% endif %} 
                  {% if variant.title.size > 14 and product.variants.size >= 2 %} sizeSwatchSmall {% endif %}
                  "
                  onclick="selectVariantClick({{variantIndex}})"
                  {% if variant.available == false %}
                  style="color:grey !important;"
                  {% endif %}>
                  <span>
                    {{ variant.title }}
                  {% unless productFormat == 'powder' %}
                    {{ productFormat }}{% endunless %}
                  </span>
                </div>
              {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

  </div>
{% endif %}


  {% style %}

