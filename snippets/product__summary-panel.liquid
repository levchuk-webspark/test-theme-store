        width: fit-content;

         background-image: none;
      }

      .sizeSwatchSmall {
        max-width: 95px;
      }
    }

    .sizeSwatch > span {
      /* border-bottom: 1px dashed; */
      line-height: 1;
    }

    .sizeSwatch.size-swatch-selected > span {
      border-bottom: none;
    }

    .sizeSwatch:hover {
      cursor: pointer;
    }


    .option-title{
      visibility:hidden;
    }

    .variant-selection {
      display:none;
    }

    .size-swatch-selected {
      background-color: #44693D;
      color: #F7F5F1;
    {% if template.name == 'product' and product.metafields.custom.action_color.value %}
       background-color: {{  product.metafields.custom.action_color.value }} ;
      color: #F7F5F1;
    {% endif %}
    {% if product.id == 8667575910613 %}
        color: #F7F5F1;
      {% endif %}
    {% if product.id == 8672614645973 %}
      background-color: #45001F;
      color: #F7F5F1;
    {% endif %}
      background-image: none !important;
    }

    .black{
      color:#3F4444 !important;
    }


    .tooltip{
      display:none !important;
    }

    .subscription-compare-at-price{
      color: #fc4301 !important;
    }

  {% endstyle %}


  {% if product.variants.size > 1 %}

    <script>


      var clickEvent = new MouseEvent('click', {
        'view': window,
        'bubbles': true,
        'cancelable': true
      });


    {% comment %} $('.sizeSwatch').addClass('black')  {% endcomment %}

    setTimeout(()=>{


     $('.product-gallery__thumbnail').css("display","none");
      // Get all the radio inputs inside the div with the class 'swatch__options'
      var swatch_radios = document.querySelectorAll('.swatch__options input[type="radio"]');

      // Find the checked radio input and get its index
      var checkedIndex = -1; // Default to -1 if none is checked
      swatch_radios.forEach((radio, index) => {
        if (radio.checked) {
          checkedIndex = index;
        }
      });

      selectVariantClick(checkedIndex)
      {% comment %} $('.sizeSwatch').removeClass('black') {% endcomment %}

      },1500)

     
      function selectVariantClick(index){
        const sizeNode = document.querySelector('[data-current-size]');

        if (sizeNode) {
          const allOptions = sizeNode.dataset.allSizes?.split(',');
          const currentSize = allOptions?.[index];
          
          if (currentSize) {
            sizeNode.textContent = `Size: ${currentSize}`;
          }
        }

        if(document.querySelectorAll('.bsub-widget__group-header')[0]){
          document.querySelectorAll('.bsub-widget__group-header')[0].click()   
        }

        if(variantInfo[index].servingSize != ""){
          $('.serving-size-variant').text(variantInfo[index].servingSize)
        }

        if(variantInfo[index].nrv != ""){
          $('.nrv-variant').text(variantInfo[index].nrv)
        }

        let variantPrice = variantInfo[index].price;
        let variantComparePrice = variantInfo[index].comparePrice;
        let googleShoppingDiscountPrice = variantInfo[index].googleShoppingDiscountPrice;
        //let variantSubscriptionPrice = variantInfo[index].subscriptionPrice;

        document.querySelector('.no-subscription-price').innerHTML = variantPrice;
        document.querySelector('.no-subscription-compare-at-price').innerHTML = variantComparePrice;


        //updating the google shopping discounted prices when changing variant
        document.querySelector('.no-subscription-price_google-shopping-discount-applied').innerHTML = googleShoppingDiscountPrice;
        document.querySelector('.no-subscription-compare-at-price_google-shopping').innerHTML = variantPrice;

        const isMobileMedia = window.matchMedia("(max-width: 798px)");
        if (isMobileMedia.matches && !document.body.classList.contains('product-product-redesign')) {
          const purchaseContainers = document.querySelectorAll(".purchase-details");
          const currentPrices = document.querySelectorAll(".no-subscription-price-display-prices");
          const activeSls = document.querySelectorAll(".sls-active");
          const variants = document.querySelectorAll(".variants-block")[0];
          const selectedVariant = variants.children[index]?.children[0];
          
          if ((!purchaseContainers.length || !currentPrices.length) && activeSls.length) return;
          for (let i = 0; i < purchaseContainers.length; i++) {
            const container = purchaseContainers[i];
            container.classList.add("mobile-purchase-details");
            const selectorsToRemove = [
              ".purchase-details__quantity",
              ".no-subscription-price-display-prices",
              ".purchase-details-info-unsab"
            ];
            selectorsToRemove.forEach(selector => {
              container.querySelectorAll(selector).forEach(element => element.remove());
            });

            const price = currentPrices[0];
            
            if (price) {
              const priceBlock = price.cloneNode(true);
              
              const infoPay = document.createElement("div");
              infoPay.classList.add("purchase-details-info-unsab");
              infoPay.innerText = selectedVariant.innerText;

              const payWithInfo = document.createElement("div");
              payWithInfo.appendChild(priceBlock);
              payWithInfo.appendChild(infoPay);
                  
              container.prepend(payWithInfo);
            }
          }

          if (activeSls.length) {
            const purchaseContainersMobile = document.querySelectorAll(".mobile-purchase-details");
            const noSubMobile = purchaseContainersMobile[0]?.querySelectorAll(".no-subscription-price-display-prices");
            const detailsInfoMobile = purchaseContainersMobile[0]?.querySelectorAll(".purchase-details-info-unsab");
            if (noSubMobile) {
                 noSubMobile.forEach(element => element.remove());
            }  
            if (detailsInfoMobile) {
                 detailsInfoMobile.forEach(element => element.remove());
            } 
            
             for (let i = 0; i < purchaseContainers.length; i++) {
               const noSub = purchaseContainers[index]?.querySelectorAll(".no-subscription-price-display-prices");
               const detailsInfo = purchaseContainers[index]?.querySelectorAll(".purchase-details-info-unsab");
               if (noSub) {
                 noSub.forEach(element => element.remove());
               }  
                if (detailsInfo) {
                 detailsInfo.forEach(element => element.remove());
               } 
             }
          }
        }
        

            if(document.querySelector('.subscription-product-price')){

              let googleShoppingDiscount = false;
            
              if (typeof googleShoppingDiscountApplied === 'undefined') {

                googleShoppingDiscount = false;
              
              } else {

                console.log(googleShoppingDiscountApplied);
              
                googleShoppingDiscount = googleShoppingDiscountApplied;
              
              }

              //changing subscription price with variants in subscription box
          
              setTimeout(()=>{

              if(googleShoppingDiscount){
                document.querySelectorAll('.subscription-product-price')[0].innerHTML = googleShoppingDiscountPrice;
                document.querySelectorAll('.subscription-compare-at-price')[0].innerHTML = variantPrice;
              }else{
                document.querySelectorAll('.subscription-product-price')[1].innerHTML = variantPrice;
                document.querySelectorAll('.subscription-compare-at-price')[1].innerHTML = variantComparePrice;

              }

                document.querySelectorAll('.bsub-widget__group-header')[1].click();
                
                let customSubPrice = document.querySelectorAll('[data-bsub-per-delivery-price]')[0].textContent
                
                document.querySelectorAll('.bsub-widget__group-header')[0].click();

                // Added as per task OD-3837 as default should be subscription option. Delete if default should be one-time purchase.
                if(window.BOLD.BsubWidget.blockSettings.default_subscribe) {
                    document.querySelectorAll('.bsub-widget__group-header')[1].click();
                }
                
                document.querySelector('.custom_display_sub_price').textContent = customSubPrice


              },0)


            }

          let radios = document.querySelectorAll('input[type=radio][name=option-0]');
          const uniqueVariantsImagesQuantity = radios.length * 2;
         var productForPreviewImageId = '{{product.id}}';


          if (index == 0){
            variantThumbnail_1 = 0;
            variantThumbnail_2 = 1;
            // variantThumbnail_3 =  document.querySelectorAll('.product-gallery__thumbnail').length - 1;
          }else{
            variantThumbnail_1 =  (index * 2);
            variantThumbnail_2 =  (index * 2) + 1;
            // variantThumbnail_3 =  document.querySelectorAll('.product-gallery__thumbnail').length - 1;
            
          }

          // var thumbnailsShow = [variantThumbnail_1, variantThumbnail_2,variantThumbnail_3 ]

           const thumbnailsShow = [
             variantThumbnail_1, 
             variantThumbnail_2, 
             uniqueVariantsImagesQuantity,
             uniqueVariantsImagesQuantity + 1,
             uniqueVariantsImagesQuantity + 2,
             uniqueVariantsImagesQuantity + 3,
             uniqueVariantsImagesQuantity + 4,
             uniqueVariantsImagesQuantity + 5,
             uniqueVariantsImagesQuantity + 6,
             uniqueVariantsImagesQuantity + 7
           ]

          setTimeout(()=>{
            const notChangedImageVariants = ["Sachets", "Pack", "Box"];
            const variantText = document.querySelectorAll('.size-swatch-selected')[0].innerText
            const isNotChangedVariant = notChangedImageVariants.some(keyword => variantText.includes(keyword));
            
            if(document.querySelectorAll('.product-gallery__thumbnail')[variantThumbnail_1]){
              if (!isNotChangedVariant) {
                document.querySelectorAll('.product-gallery__thumbnail')[variantThumbnail_1].click()
              }
            } else {
              if (index == (radios.length - 1)) {
                if (!isNotChangedVariant) { 
                  const lastIndex = Number(document.querySelectorAll('.product-gallery__thumbnail').length) - 1;
                  document.querySelectorAll('.product-gallery__thumbnail')[lastIndex].click()
                 }
              }
            }
            
             if (productForPreviewImageId == 8174336213205 || productForPreviewImageId == 8174339653845) {
              $('.product-gallery__thumbnail').css("display","none");
            
            document.querySelectorAll('.product-gallery__thumbnail').forEach((thumbnail,index)=>{
              if(thumbnailsShow.includes(index)){

                thumbnail.style.display = 'block';
              }
            })
            } else {
              $('.product-gallery__thumbnail').css("display","block");
            }

          },0)

            radios[index].click();
            radios[index].checked = true;

            document.querySelectorAll('.sizeSwatch').forEach((item)=>{
              item.classList.remove('size-swatch-selected')
            })

            document.querySelectorAll('.sizeSwatch')[index].classList.add('size-swatch-selected')
  
      }


    </script>

  {% endif %}

