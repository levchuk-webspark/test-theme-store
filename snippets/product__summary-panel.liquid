      border-radius: 5px;
      background-color: #EBE9E5;
      color: #949992;
      font-size: 12px;
      line-height: 110.00000000000001%;
      text-align: center;
      padding: 12px;
      font-weight: 900;

      display: flex;
      align-items: center;
    }

    .sizeSwatchSmall {
      font-size: 10px;
      max-width: 140px;
    }

    .text_name {
      margin-right: 18px;
    }

    @media only screen and (max-width: 798px) {
      .sizeSwatch {
        margin-left: 2px;
        margin: unset;
        /* margin-bottom: 2px; */
        /* display: inline-block; */
        background-size: 5px 1px;
        /* Width and height of the dot */
