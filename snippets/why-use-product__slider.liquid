
{% style %}
  .why-use-product__modal-backdrop{
    display: none;
    position: fixed;
    z-index: 1000;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(6, 32, 33, 0.5);
  }

  .why-use-product__modal-backdrop-is-open {
    display: block;
  }

  .why-use-product__modal__content {
    background-color: #ffffff;
    color: #000000;
    top: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    width: 40%;
    padding: 30px 20px;
    position: fixed;
    z-index: 999999;
    transform: translateX(100%);
    transition: transform .3s ease, -webkit-transform .3s ease;
  }

  .why-use-product__modal__content.why-use-product__modal__content__is-open {
    transform: translateX(0);
  }

  .why-use-product__modal__header {
    width: 96%;
    display: flex;
    justify-content: space-between;
    font-size: 40px;
    line-height: 1.1;
  }

  .why-use-product__modal__title {
    margin-right: 29px;
  }

  .why-use-product__modal__header br {
    display: none;
  }

  .why-use-product__modal__close {
    width: 29px;
    height: 29px;
    cursor: pointer;
    position: absolute;
    right: 20px;
    z-index: 1;
  }

  .why-use-product__modal__cards-list {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .why-use-product__modal__cards-list__item {
    width: 100%;
    display: flex;
    flex-direction: column;

    height: 100vh;
    overflow-y: auto;
    display: flex;
  }

  .why-use-product__modal__cards-list__item__image {
    width: 100%;
    
    height: 380px;
    min-height: 380px;
    
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 30px;
    margin-top: 30px;

    max-width: 100%;
  }

  .why-use-product__modal__cards-list__item__image img {
    object-fit: cover;

    max-width: 100%;
  }

  .why-use-product__modal__cards-list__item__description {
    font-size: 22px;
    margin-top: 15px;
  }

  .why-use-product__modal__cards-list__item__text_under_image {
    font-size: 16px;
    line-height: 1.3;
    margin-bottom: 80px;
  }


  .why-use-product__modal__cards-list__item__footer {
    margin-bottom: 40px;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    font-size: 14px;

    gap: 105px;
  }

  .why-use-product__modal__cards-list__item__footer-next {
    text-align: end;
    width: 50%;
  }


   .why-use-product  .flickity-prev-next-button {
    display: none;
  }

  .why-use-product__modal__cards-list__item__nav-buttons {
    z-index: 1;

    display: flex;
    align-items: center;
    gap: 15px;

    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 15px;
  }

  .why-use-product__modal__cards-list__item__button-prev,
  .why-use-product__modal__cards-list__item__button-next {
    width: 30px;
    height: 30px;
    border: 1px solid {{ settings.regular_color}};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FFF;

    cursor: pointer;
  }

  .why-use-product__modal__cards-list__item__arrow-prev,
  .why-use-product__modal__cards-list__item__arrow-next {
    width: 6px;
    height: 6px;
    border-top: 1px solid {{ settings.regular_color}};
    border-right: 1px solid {{ settings.regular_color}};
  }

  .why-use-product__modal__cards-list__item__arrow-prev {
    transform: rotate(-135deg);
  }

  .why-use-product__modal__cards-list__item__arrow-next {
    transform: rotate(45deg);
  }

  @media only screen and (max-width: 1000px) {

    .why-use-product__modal__content {
      width: 100%;
      padding: 25px 10px;
    }


    .why-use-product__modal__header {
      font-size: 20px;
    }

    .why-use-product__modal__close {
      width: 20px;
      height: 20px;
      top: 28px;
    }

    .why-use-product__modal__cards-list__item {
      padding: 0 10px;

      height: 100%;
    }

    .why-use-product__modal__cards-list__item__image {
      margin-top: 9px;
      margin-bottom: 16px;
      max-height: unset;
      height: 30%;
    }

    .why-use-product__modal__cards-list__item__description {
      font-size: 12px;
      margin-bottom: 9px;
      margint-top: unset;
    }

    .why-use-product__modal__cards-list__item__text_under_image {
      font-size: 12px;
    }

    .why-use-product__modal__cards-list__item__footer {
      gap: 85px;
      font-size: 10px;
      margin-bottom: unset;
    }

    .why-use-product__modal__cards-list__item__footer-prev {
      width: 50%;
    }

    .why-use-product__modal__cards-list__item__footer br {
      display: block;
    }

    .why-use-product__modal__cards-list__item__nav-buttons {
      bottom: 20px;
      gap: 12px;
    }

    .why-use-product__modal__cards-list__item__button-prev,
    .why-use-product__modal__cards-list__item__button-next {
      width: 22px;
      height: 22px;
    }

  }

  @media only screen and (max-width: 500px) {
    .why-use-product__modal__close {
      width: 13px;
      height: 13px;
      top: 20px;
    }
  }
{% endstyle %}

<div class="why-use-product__modal-backdrop"></div>
<div class="why-use-product__modal__content">
