{% assign auto_close = true %}

{% style %}

  .product-FAQ_accordion__links {
    display: flex;
    gap: 20px;
    margin-bottom: 22px;
  }
  .product-FAQ_accordion__title {
     font-size: 1.5em;
    margin-bottom: 0.6666em;
    word-wrap: break-word;
  }

  
{% endstyle %}
  
<div class="multiple_accordion_container-{{ id }} content product-FAQ_accordion">

