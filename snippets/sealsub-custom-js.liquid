<script>
  document.addEventListener('DOMContentLoaded', () => {

    const updateComparePrice = (comparePrice) => {
      
        const compareAtPriceForSealSub = document.getElementsByClassName("compare-at-price-for-seal-sub")[0];
        
        if (compareAtPriceForSealSub) {
          compareAtPriceForSealSub.remove();                  
        } 
      
        const sealSubOneTimePrice = document.getElementsByClassName("sls-one-time-price")[0];
        const sealSubCompareAtPrice = document.createElement("div");

        const priceTextValue = document.getElementsByClassName("sls-one-time-price")[0].innerText;
        
      sealSubCompareAtPrice.classList.add('compare-at-price-for-seal-sub');

        const formattedPrice = Shopify.formatMoney(comparePrice, '{{ shop.money_format }}');

      const formattedPriceTextValue = Shopify.formatMoney(comparePrice, '{{ shop.money_format | strip_html }}');
      
        sealSubCompareAtPrice.innerHTML = `${formattedPrice}`;
      
      if (priceTextValue.trim() != formattedPriceTextValue.trim()) {
        sealSubOneTimePrice.prepend(sealSubCompareAtPrice);
      }

    };

    //Subscription widget was created
    document.addEventListener('sealsubs:subscription_widget_created', function(e) {

      // Keep product form's hidden selling_plan in sync and update compare-at price
      document.addEventListener('sealsubs:price_update', function(e) {
        try {
          // Try to find the widget root and its nearest product form
          var widget = (e && e.detail && e.detail.element) ? e.detail.element : null;
          var form = widget && widget.closest ? widget.closest('form') : document.querySelector('[data-product-form] form, form[action*="/cart/add"]');

          // Resolve selected selling plan id
          var selectedPlan = document.querySelector('input[name="selling_plan_id"]:checked');
          var sellingPlanId = selectedPlan && selectedPlan.value ? selectedPlan.value : null;

          if (form) {
            var spInput = form.querySelector('input[name="selling_plan"]');
            if (!spInput) {
              spInput = document.createElement('input');
              spInput.type = 'hidden';
              spInput.name = 'selling_plan';
              form.appendChild(spInput);
            }
            if (sellingPlanId) {
              spInput.value = sellingPlanId;
            } else {
              // Remove stale selling_plan if switching back to one-time
              try { spInput.parentNode.removeChild(spInput); } catch (_) {}
            }
          }
        } catch (_) {}

        try {
          if (e.detail.compareAtPrice > 0) {
            updateComparePrice(e.detail.compareAtPrice);
          }
        } catch (_) {}
      });

      // Ensure selling_plan hidden input updates on explicit plan change events as well
      document.addEventListener('sealsubs:selling_plan_changed', function(ev) {
        try {
          var widget = (ev && ev.detail && ev.detail.element) ? ev.detail.element : null;
          var form = widget && widget.closest ? widget.closest('form') : document.querySelector('[data-product-form] form, form[action*="/cart/add"]');
          var planId = ev && ev.detail ? (ev.detail.selling_plan_id || ev.detail.sellingPlanId) : null;
          if (!form) return;
          var spInput = form.querySelector('input[name="selling_plan"]');
          if (!spInput) {
            spInput = document.createElement('input');
            spInput.type = 'hidden';
            spInput.name = 'selling_plan';
            form.appendChild(spInput);
          }
          if (planId) { spInput.value = planId; } else { try { spInput.remove(); } catch (_) {} }
        } catch (_) {}
      });
        
	});

    
  });

</script>

  
