{% comment %}
Required values
menu_link: linklist
______________
Optional values
linklist_class: <string>
link_setting: <string>
link_label: <string>
{% endcomment %}

<div class="mega-menu__linklist {{ linklist_class }}">
  {% assign menu = linklists[menu_link] %}
  <p class="menu__heading">
    {% if link_setting != blank %}<a class="menu__heading__wrapper" href="{{ link_setting }}">{% endif %}
      {{ menu.title }}
      {% if link_label != blank %}
        <span class="menu__heading__label">
          {{ link_label }}
        </span>
      {% endif %}
    {% if link_setting != blank %}</a>{% endif %}
  </p>
  <ul>
    {% for link in menu.links %}
      <li>
        <a href="{{ link.url }}" class="mega-menu__linklist-link {% if link.active %}is-active{% endif %}">
          {{ link.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>