{% assign ingredients_list = ingredients.product_ingredient.value %}    
{% style %}
  
  .product__ingredients__slider__modal-backdrop{
    display: none;
    position: fixed;
    z-index: 1000;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(6, 32, 33, 0.5);
  }

  .product__ingredients__slider__modal-backdrop-is-open {
    display: block;
  }

  .product__ingredients__slider__modal__content {
    background-color: #ffffff;
    color: #000000;
    top: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    width: 40%;
    padding: 30px 20px;
    position: fixed;
    z-index: 999999;
    transform: translateX(100%);
    transition: transform .3s ease, -webkit-transform .3s ease;
  }

  .product__ingredients__slider__modal__content.product__ingredients__slider__modal__content__is-open {
    transform: translateX(0);
  }

  .product__ingredients__slider__modal__header {
    width: 96%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 40px;
    margin-bottom: 30px;
  }

  .product__ingredients__slider__modal__header br {
    display: none;
  }

  .product__ingredients__slider__modal__close {
    width: 29px;
    height: 29px;
    cursor: pointer;
    position: absolute;
    right: 20px;
    top: 35px;
    z-index: 1;
  }

  .product__ingredients__slider__modal__cards-list {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .product__ingredients__slider__modal__cards-list__item {
    width: 100%;
    display: flex;
    flex-direction: column;

    height: 90vh;
    overflow-y: auto;
  }

  .product__ingredients__slider__modal__cards-list__item__image {
    width: auto;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 50px;

    width: 100%;
    height: 380px;
    min-height: 380px;
    
    overflow: hidden;
    max-width: 100%;
  }

  .product__ingredients__slider__modal__cards-list__item__image img {
    object-fit: cover;
  }

  .product__ingredients__slider__modal__cards-list__item__description {
    font-size: 16px;
  }

  .product__ingredients__slider__modal__cards-list__item__footer {
    /* margin-bottom: 40px; */
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    font-size: 14px;

    gap: 105px;
  }

  .product__ingredients__slider__modal__cards-list__item__footer-next {
    text-align: end;
    width: 50%;
  }

    .product__ingredients__slider__modal__cards-list__item__footer br {
      display: none;
    }


  .product_ingredients .flickity-prev-next-button {
    display: none;
  }
  
  .product__ingredients__slider__modal__cards-list__item__nav-buttons {
    z-index: 1;

    display: flex;
    align-items: center;
    gap: 15px;

    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 15px;
  }

  .product__ingredients__slider__modal__cards-list__item__button-prev,
  .product__ingredients__slider__modal__cards-list__item__button-next {
    width: 30px;
    height: 30px;
    border: 1px solid {{ settings.regular_color}};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FFF;

    cursor: pointer;
  }

  .product__ingredients__slider__modal__cards-list__item__arrow-prev,
  .product__ingredients__slider__modal__cards-list__item__arrow-next {
    width: 6px;
    height: 6px;
    border-top: 1px solid {{ settings.regular_color}};
    border-right: 1px solid {{ settings.regular_color}};
  }

  .product__ingredients__slider__modal__cards-list__item__arrow-prev {
    transform: rotate(-135deg);
  }

  .product__ingredients__slider__modal__cards-list__item__arrow-next {
    transform: rotate(45deg);
  }

  .product__ingredients__slider__modal__cards-list__item__links-container {
    margin-top: 20px;
  }

  .product__ingredients__slider__modal__cards-list__item__information-item-label {
    font-size: 16px;
    font-weight: 900;
    margin-bottom: 10px;
  }


  .product__ingredients__slider__modal__cards-list__item__url {
    text-decoration: underline;
    font-size: 16px;
    {% if ingredients.link_color != blank %}
      color: {{ ingredients.link_color }};
    {% endif %}
  }

  .product__ingredients__slider__modal__cards-list__item__url:hover, .product__ingredients__slider__modal__cards-list__item__url:visited {
    {% if ingredients.link_hover_color != blank %}
      color: {{ ingredients.link_hover_color }};
    {% endif %}
  }

  .product__ingredients__slider__modal__cards-list__item__url-icon {
    width: 12px;
    height: 12px;
    margin-right: 8px;
  }

  .product__ingredients__slider__modal__cards-list__item__url-icon > svg {
    {% if ingredients.link_color != blank %}
      fill: {{ ingredients.link_color }};
    {% endif %}
    width: 12px;
    height: 12px;
  }

  .product__ingredients__slider__modal__cards-list__item__url:hover .product__ingredients__slider__modal__cards-list__item__url-icon > svg {
    {% if ingredients.link_hover_color != blank %}
      fill: {{ ingredients.link_hover_color}};
    {% endif %}
  }

  .product__ingredients__slider__modal__cards-list__item__link-wrapper {
    display: flex;
    margin-bottom: 8px;
  }

  @media only screen and (max-width: 1000px) {
     .product__ingredients__slider__modal__cards-list__item {
      padding: 0 10px;

      height: 100%;
    }
        
    .product__ingredients__slider__modal__content {
      width: 100%;
      padding: 25px 10px;
    }


    .product__ingredients__slider__modal__header {
      font-size: 22px;
      margin-bottom: 10px;
    }

    .product__ingredients__slider__modal__close {
      width: 20px;
      height: 20px;
      top: 28px;
    }

    
    .product__ingredients__slider__modal__cards-list__item {
      width: 100%;
      height: 100%;
      display: block;
      padding: 0 10px;
    }
  
    .product__ingredients__slider__modal__cards-list__item__image {
      margin-bottom: 20px;
    }

    .product__ingredients__slider__modal__cards-list__item__description {
      font-size: 15px;
      margin-bottom: 20px;
    }

    .product__ingredients__slider__modal__cards-list__item__footer {
      margin-bottom: 0;
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
    }

    .product__ingredients__slider__modal__cards-list__item__footer br {
      display: block;
    }

    .product__ingredients__slider__modal__cards-list__item__nav-buttons {
      bottom: 30px;
      gap: 12px;
    }

    .product__ingredients__slider__modal__cards-list__item__button-prev,
    .product__ingredients__slider__modal__cards-list__item__button-next {
      width: 22px;
      height: 22px;
    }

     .product__ingredients__slider__modal__cards-list__item__information-item-label {
      font-size: 12px;
      margin-bottom: 5px;
    }

    .product__ingredients__slider__modal__cards-list__item__url {
        font-size: 10px;
    }

    .product__ingredients__slider__modal__cards-list__item__url-icon {
        width: 8px;
        height: 8px;
    }
     .product__ingredients__slider__modal__cards-list__item__url-icon > svg {
        width: 8px;
        height: 8px;
       margin-bottom: 8px;
    }

  }
  
{% endstyle %}

<div class="product__ingredients__slider__modal-backdrop"></div> 
<div class="product__ingredients__slider__modal__content">

  <div class="product__ingredients__slider__modal__close">
      <svg viewBox="0 0 30 29" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="29.3536" y1="0.353553" x2="1.35355" y2="28.3536" stroke="black"/>
        <line y1="-0.5" x2="39.598" y2="-0.5" transform="matrix(0.707107 0.707107 0.707107 -0.707107 1 0)" stroke="black"/>
      </svg>
  </div>
  <div class="product__ingredients__slider__modal__cards-list carousel-{{ section.id }}-product__ingredients__slider">
    {% for ingredient in ingredients_list %}
      {% assign alt_image = "Product Ingredient Image" %} 
      <div class="
        product__ingredients__slider__modal__cards-list__item 
        block-{{ forloop.index }} 
        carousel-cell   
        "
        data-carousel-cell-id={{ forloop.index }}
        >
          <div class="product__ingredients__slider__modal__header">
            {% if ingredient.title != blank %}
              <div class="product__ingredients__slider__modal__title">
                {{ ingredient.title }}
              </div>
            {% endif %}
          </div>
          {% if ingredient.image != nil %}
            {%
              render 'image-element',
              image: ingredient.image,
              alt: alt_image,
              additional_wrapper_classes: 'product__ingredients__slider__modal__cards-list__item__image',
            %}
          {% endif %}
        
          {% if ingredient.description != blank %}
            <div class="product__ingredients__slider__modal__cards-list__item__description">{{ ingredient.description }}</div>
          {% endif %}
        
          {% if ingredient.document_label != blank and ingredient.document_link != blank%}
            <div class="product__ingredients__slider__modal__cards-list__item__links-container">
              <div class="product__ingredients__slider__modal__cards-list__item__information-item-label">Relevant stud{% if ingredient.document_label_2 != blank and ingredient.document_link_2 != blank  %}ies:{% else %}y:{% endif %}</div>
            </div>
            
            {% if ingredient.document_label != blank and ingredient.document_link != blank %}
              <div class="product__ingredients__slider__modal__cards-list__item__link-wrapper">
                <div class='product__ingredients__slider__modal__cards-list__item__url-icon'>
                      <svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 0.648438C12.5 0.372296 12.2761 0.148439 12 0.148438L7.5 0.148438C7.22386 0.148438 7 0.372296 7 0.648438C7 0.92458 7.22386 1.14844 7.5 1.14844L11.5 1.14844L11.5 5.14844C11.5 5.42458 11.7239 5.64844 12 5.64844C12.2761 5.64844 12.5 5.42458 12.5 5.14844L12.5 0.648438ZM1.35355 12.002L12.3536 1.00199L11.6464 0.294885L0.646447 11.2949L1.35355 12.002Z" fill="#60012C"/>
                      </svg>
                    </div>
                    <a class='product__ingredients__slider__modal__cards-list__item__url' href="{{ ingredient.document_link }}" target="_blank">
                        {{ ingredient.document_label }}
                    </a>
              </div>   
            {% endif %}
            {% if ingredient.document_label_2 != blank and ingredient.document_link_2 != blank %}
              <div class="product__ingredients__slider__modal__cards-list__item__link-wrapper">
                <div class='product__ingredients__slider__modal__cards-list__item__url-icon'>
                      <svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 0.648438C12.5 0.372296 12.2761 0.148439 12 0.148438L7.5 0.148438C7.22386 0.148438 7 0.372296 7 0.648438C7 0.92458 7.22386 1.14844 7.5 1.14844L11.5 1.14844L11.5 5.14844C11.5 5.42458 11.7239 5.64844 12 5.64844C12.2761 5.64844 12.5 5.42458 12.5 5.14844L12.5 0.648438ZM1.35355 12.002L12.3536 1.00199L11.6464 0.294885L0.646447 11.2949L1.35355 12.002Z" fill="#60012C"/>
                      </svg>
                    </div>
                    <a class='product__ingredients__slider__modal__cards-list__item__url' href="{{ ingredient.document_link_2 }}" target="_blank">
                        {{ ingredient.document_label_2 }}
                    </a>
              </div>   
            {% endif %}
            {% if ingredient.document_label_3 != blank and ingredient.document_link_3 != blank %}
              <div class="product__ingredients__slider__modal__cards-list__item__link-wrapper">
                <div class='product__ingredients__slider__modal__cards-list__item__url-icon'>
                      <svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 0.648438C12.5 0.372296 12.2761 0.148439 12 0.148438L7.5 0.148438C7.22386 0.148438 7 0.372296 7 0.648438C7 0.92458 7.22386 1.14844 7.5 1.14844L11.5 1.14844L11.5 5.14844C11.5 5.42458 11.7239 5.64844 12 5.64844C12.2761 5.64844 12.5 5.42458 12.5 5.14844L12.5 0.648438ZM1.35355 12.002L12.3536 1.00199L11.6464 0.294885L0.646447 11.2949L1.35355 12.002Z" fill="#60012C"/>
                      </svg>
                    </div>
                    <a class='product__ingredients__slider__modal__cards-list__item__url' href="{{ ingredient.document_link_3 }}" target="_blank">
                        {{ ingredient.document_label_3 }}
                    </a>
              </div>   
            {% endif %}
            {% if ingredient.document_label_4 != blank and ingredient.document_link_4 != blank %}
              <div class="product__ingredients__slider__modal__cards-list__item__link-wrapper">
                <div class='product__ingredients__slider__modal__cards-list__item__url-icon'>
                      <svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 0.648438C12.5 0.372296 12.2761 0.148439 12 0.148438L7.5 0.148438C7.22386 0.148438 7 0.372296 7 0.648438C7 0.92458 7.22386 1.14844 7.5 1.14844L11.5 1.14844L11.5 5.14844C11.5 5.42458 11.7239 5.64844 12 5.64844C12.2761 5.64844 12.5 5.42458 12.5 5.14844L12.5 0.648438ZM1.35355 12.002L12.3536 1.00199L11.6464 0.294885L0.646447 11.2949L1.35355 12.002Z" fill="#60012C"/>
                      </svg>
                    </div>
                    <a class='product__ingredients__slider__modal__cards-list__item__url' href="{{ ingredient.document_link_4 }}" target="_blank">
                        {{ ingredient.document_label_4 }}
                    </a>
              </div>   
            {% endif %}
          {% endif %}

      {% assign previousIndex = forloop.index | minus: 2 %}
        {% if forloop.index == ingredients_list.size %}
          {% assign nextIndex = 0 %}
        {% else %}
          {% assign nextIndex = forloop.index %}
        {% endif %}
        <div class="product__ingredients__slider__modal__cards-list__item__footer">
            <div class="product__ingredients__slider__modal__cards-list__item__footer-prev">{{ ingredients_list[previousIndex].title  }}</div>
            <div class="product__ingredients__slider__modal__cards-list__item__footer-next">{{ ingredients_list[nextIndex].title  }}</div>
        </div>
      </div>
    {% endfor %}
  </div>

   <div class="product__ingredients__slider__modal__cards-list__item__nav-buttons">
    <div class="product__ingredients__slider__modal__cards-list__item__button-prev product__ingredients__slider__modal__cards-list__item__button-prev-{{ section.id }}">
        <div class="product__ingredients__slider__modal__cards-list__item__arrow-prev"></div>    
    </div>
    <div class="product__ingredients__slider__modal__cards-list__item__button-next product__ingredients__slider__modal__cards-list__item__button-next-{{ section.id }}">
        <div class="product__ingredients__slider__modal__cards-list__item__arrow-next"></div>  
    </div>
  </div>
</div>            