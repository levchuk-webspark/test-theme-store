        {% elsif product.metafields.jadepuma.format == 'Sachet' %}
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.8451 4.9123C11.8725 3.93548 13.3992 -0.402973 11.5427 1.45944L1.09509 11.9698C0.951095 12.1144 0.973249 12.3747 1.14383 12.5483L5.43052 16.8539C5.60332 17.0274 5.8603 17.0497 6.00651 16.9028L16.5631 6.29924C18.4195 4.4346 13.8198 5.88912 12.8451 4.9123Z" stroke="#3F4444" stroke-miterlimit="10"/>
          </svg>

        {% elsif product.metafields.jadepuma.format == 'Bundle' %}
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 1L7.5 14" stroke="#3F4444" stroke-linecap="round"/>
            <path d="M14 7.5L1 7.5" stroke="#3F4444" stroke-linecap="round"/>
          </svg>
        {% else %}
          <!--
            <img
            src="https://cdn.shopify.com/s/files/1/0469/8905/0019/files/icon-pill.png?v=1695846845"
            alt="icon"
            loading="lazy">
          -->
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11.1625 1.81907C10.0704 0.726977 8.31096 0.726977 7.21886 1.81907L1.81907 7.21886C0.726977 8.31096 0.726977 10.0704 1.81907 11.1625C2.91116 12.2546 4.67065 12.2546 5.76274 11.1625L11.1625 5.76274C12.2546 4.67065 12.2546 2.91116 11.1625 1.81907Z" stroke="#3F4444" stroke-miterlimit="10"/>
            <path d="M4.51953 4.51953L8.4632 8.4632" stroke="#3F4444" stroke-miterlimit="10"/>
          </svg>
        {% endif %}
      </div>
    </div>
    <div
      class="{% if section.settings.hide-price and article %}hide-price {% endif %}panel-cell price {% if product.price_varies %} panel-cell-price_has-variants {% endif %}"
      style="flex-direction: column;"
    >
      <span class="product-thumbnail__price price {% if product.compare_at_price_max > product.price %}sale{% endif %}">
        {% if product.price_varies and product.price_min > 0 %}
          <small>
            <em>{{ 'products.general.from' | t }}</em>
          </small>
        {% endif %}
        {% if product.price_min > 0 %}
          <span class="money product-thumbnail__sale-price">
            {% render 'price-element', price: product.price_min %}
          </span>
        {% else %}
          {{ settings.free_price_text }}
        {% endif %}
        {% if product.compare_at_price > product.price %}
          {% unless product.price_varies and product.price_min > 0 %}
            <span class="product-thumbnail__was-price compare-at-price">
              <span class="money">
                {% render 'price-element', price: product.compare_at_price %}
              </span>
            </span>
          {% endunless %}
        {% endif %}
      </span>

      <span class="product-thumbnail__price_google-discount price {% if product.compare_at_price_max > product.price %}sale{% endif %}">
        {% assign google_discount_value = 100 | minus: settings.google_discount_percentage | times: 0.01 %}

        {% if product.price_varies and product.price_min > 0 %}
          <small>
            <em>{{ 'products.general.from' | t }}</em>
          </small>
        {% endif %}

        {% assign google_discount_price_min = product.price_min | times: google_discount_value %}

        {% if product.price_min > 0 %}
          <span class="money product-thumbnail__sale-price">
            {% render 'price-element', price: google_discount_price_min %}
          </span>
        {% else %}
          {{ settings.free_price_text }}
        {% endif %}

        {% assign google_discount_compare_price = product.price | times: google_discount_value %}

        {% unless product.price_varies and product.price_min > 0 %}
          <span class="product-thumbnail__was-price compare-at-price">
            <span class="money">
              {% render 'price-element', price: product.price %}
            </span>
          </span>
        {% endunless %}
      </span>

      {% if settings.select_first_available_variant %}
        {%- assign variant_for_unit_price = product.variants | sort: 'price' | first -%}
        {% render 'unit-price', item: variant_for_unit_price, class: 'product-thumbnail__unit-price' %}
      {% endif %}
    </div>
    {% if mobile_products_per_row == '2' %}
      </div>
    {% endif %}
    {% comment %} Checking for preorder {% endcomment %}
    {% assign displayPreorderMetafield = false %}
    {% for v in product.variants %}
      {% unless v.inventory_quantity >= 0 or v.inventory_policy == 'deny' %}
        {% if product.metafields.jadepuma.preorder_button_text != blank
          and product.metafields.jadepuma.preorder_message != blank
        %}
          {% assign displayPreorderMetafield = true %}
          {% break %}
        {% endif %}
      {% endunless %}
    {% endfor %}

    {% if mobile_products_per_row == '2' %}</div>{% endif %}

    <div class="{% if product.has_only_default_variant %}{% elsif section.settings.hide-price and article %}hide-price-border {% endif %}panel-cell buy {% if product.available == false %}sold-out_button{% endif %}">
      {% if displayPreorderMetafield %}
        <a href="/cart/add/{{ product.selected_or_first_available_variant.id }}" rel="nofollow">
          ADD TO CART
          {% comment %}{{ 'collections.general.pre_order' | t | upcase}}{% endcomment %}
        </a>
      {% elsif collection_handles contains 'coming-soon' %}
        {% if settings.stickers_enabled == false %}
          {{ 'collections.general.coming_soon' | t }}
        {% endif %}
      {% elsif product.available == false %}
        <span class="">
          {{ 'collections.general.sold_out' | t }}
        </span>
      {% else %}
        {% if product.has_only_default_variant %}
          <a href="/cart/add/{{ product.selected_or_first_available_variant.id }}" rel="nofollow">ADD TO CART</a>
        {% else %}
          <a href="{{ product.url }}">VIEW OPTIONS</a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<div class="summary-panel view_product_thumbnail-button">
  {% if product.available == false %}
    <span class="view_product_thumbnail-button-sold-out">
      {{ 'collections.general.sold_out' | t }}
    </span>
  {% else %}
    {% if product.has_only_default_variant %}
      <a href="/cart/add/{{ product.selected_or_first_available_variant.id }}" rel="nofollow">ADD TO CART</a>
    {% else %}
      <a href="{{ product.url }}">VIEW OPTIONS</a>
    {% endif %}
  {% endif %}
</div>
