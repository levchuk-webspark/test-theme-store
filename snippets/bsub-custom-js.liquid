{% style %}

.bsub-widget__benefits-list {
  background-color: #F7F5F1;
  margin-top: 16px;
  margin-bottom: 16px;
  border-radius: 8px;
  padding: 16px 16px 0;
  display: flex;
  flex-direction: column;
}

.bsub-widget__points-list__item {
  display: flex;
  align-items: center;
  gap: 15px;
}

.bsub-widget__points-list__item__title {
  font-size: 20px;
  margin-bottom: 16px;
}

.bsub-widget__points-list__item__image {
  width: 38px;
  height: 38px;
  margin-bottom: 16px;
}

@media only screen and (max-width: 798px) {
  /* .bsub-widget__points-list__item {
    gap: 8px;
  }
   */
  .bsub-widget__points-list__item__image {
    width: 20px;
    height: 20px;
    margin-bottom: 8px;
  }

  .bsub-widget__points-list__item__title {
    font-size: 16px;
    margin-bottom: 8px;
  }
}

{% endstyle %}

{% if template contains 'product' %}

