<script>
document.addEventListener("sealsubs:subscription_widget_created", function() {
    function bindOneTimeClick() {

        const oneTimeOption = document.querySelector('.sls-option-container');
        if (!oneTimeOption) {
           {% comment %} One-time option not found yet, retrying... {% endcomment %}
            return false;
        }

        // To avoid connecting twice
        if (!oneTimeOption.dataset.bound) {
            oneTimeOption.dataset.bound = "true";

            oneTimeOption.addEventListener("click", function() {
                {% comment %} One-time purchase CLICK {% endcomment %}
                setTimeout(() => {
                    const activeBuyButton = document.querySelector('.product__buy-more_save-more__bottom-block__buy-item.active');
                    if (activeBuyButton) {
                        // Reset buy button
                        activeBuyButton.classList.remove('active');

                        // Reset quantity
                        const input = document.querySelector('input[name="quantity"]');
                        if (input && input.value > 1) {
                            input.value = 1;
                        }

                        // Reset discount
                        const discountElement = document.querySelector(".product__buy-more_save-more__bottom-block__discount.active");
                        if (discountElement) {
                            discountElement.classList.remove('active');
                        }

                        // Remove unselected style class
                        document.querySelectorAll('.custom-after-style').forEach(radio => {
                            radio.classList.remove('custom-after-style');
                        });

                        // Remove active state from main block
                        const buyMoreSaveMoreBlock = document.getElementById("product__buy-more_save-more");
                        if (buyMoreSaveMoreBlock) {
                            buyMoreSaveMoreBlock.classList.remove('active');
                        }

                        const buyButtons = document.querySelectorAll(".product__buy-more_save-more__bottom-block__buy-item");
                        const hasActiveBuyButton = Array.from(buyButtons).every(button => 
                            button.classList.contains("active")
                        );
                       
                        if (!hasActiveBuyButton) {
                            oneTimeOption.classList.add('sls-active')
                        }
                    

                        // Mobile-specific changes
                        const isMobileMedia = window.matchMedia("(max-width: 798px)");
                        if (isMobileMedia.matches) {
                            const purchaseDetailsInfo = document.querySelector(".purchase-details-info");
                            if (purchaseDetailsInfo) {
                                purchaseDetailsInfo.innerText = "One time purchase";
                            }
                            const originalOneTimePrice = document.querySelectorAll(".sls-one-time-price.sls-total-price.sls-price-container");
                            if (originalOneTimePrice[0] && originalOneTimePrice[1]) {
                                const duplicatedElement = originalOneTimePrice[0].cloneNode(true);
                                originalOneTimePrice[1].innerHTML = "";
                                originalOneTimePrice[1].appendChild(duplicatedElement.lastChild);
                            }
                        }
                    }
                }, 100);
            });

            {% comment %} One-time option click bound {% endcomment %}
        }

        return true;
    }

    // Let's try it right away
    if (!bindOneTimeClick()) {
        {% comment %} If you haven’t found it, we wait for it to appear. {% endcomment %}
        const observer = new MutationObserver(() => {
            if (bindOneTimeClick()) {
                observer.disconnect();
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });
    }
});
</script>


