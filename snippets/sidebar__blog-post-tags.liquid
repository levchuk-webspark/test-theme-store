{% comment %}
  Required values
  blog_handle: <string>
{% endcomment %}

{% assign allowed_tags = 'Blog,Audio,Video,Recipes' | split: ',' %}
{% assign current_tag = request.path | split: '/tagged/' | last | handle %}
{% assign current_tag_path = request.path | split: '/tagged/' %}
{% if current_tag_path.size > 1 %}
  {% assign current_tag = current_tag_path[1] | handle %}
{% else %}
  {% assign current_tag = '' %}
{% endif %}

{% style %}
  .block__post-tags .sidebar-block__heading {
    font-size: 22px;
    margin-bottom: 21px;
  }

  .sidebar-block__content.tags {
    flex-direction: column;
    align-items: start;
    gap: 0.3em;
  }

  span.tag.tag--solid.tag--active {
    background-color: {{ settings.button_primary_bg_color }};
    color: {{ settings.button_primary_text_color }};
  }

  span.tag.tag--solid.tag--active > {
    color: {{ settings.button_primary_text_color }};
  }

  .tags .tag.tag--solid.tag--active a {
    color: {{ settings.button_primary_text_color }};
  }

  .filters-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checkbox-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.3rem;
  }

  .checkbox-group input[type="checkbox"] {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border: 1px solid #404544;
    border-radius: 6px;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
  }

  .checkbox-group input[type="checkbox"]:checked {
    box-shadow: inset 0 0 0 2px #F7F5F1;
    background-color: #7FB84C;
    padding: 3px;
  }

  .checkbox-group input[type="checkbox"]:checked::before {
    content: "";
    position: absolute;
    top: 3.5px;
    left: 7.5px;
    width: 5px;
    height: 10.5px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-group label {
    font-size: 16px;
    font-weight: 400;
    color: #404544;
    cursor: pointer;
  }

  .filters-wrapper {
    margin-right: 30px;
  }

  .sidebar-divider {
    height: 1px;
    background-color: #404544;
    margin: 1.5rem 0 0 0;
    width: 100%;
  }

  @media (max-width: 798px) {
    .sidebar-block__content.tags {
      flex-direction: row;
      gap: 20px;
    }

    .checkbox-group label {
      font-size: 13px;
    }

    .filters-wrapper {
      margin-right: 0;
    }

    .block__post-tags .sidebar-block__heading {
      display: none;
    }
  }
{% endstyle %}

{% if title != blank %}
  <div data-has-toggle-option>
    <h3
      class="sidebar-block__heading"
      {% if settings.toggle_sidebar %}
        data-sidebar-block__toggle="closed" aria-label="toggle"
      {% endif %}
    >
      {{ title }}
      {% if settings.toggle_sidebar %}
        <button class="sidebar-block__toggle-icon icon-style--{{ settings.toggle_icon_style }}">
          {% if settings.toggle_icon_style == 'plus_and_minus' %}
            {% render 'icon', name: 'plus', icon_class: 'icon--active' %}
            {% render 'icon', name: 'minus' %}
          {% else %}
            {% render 'icon', name: 'down-caret', icon_class: 'icon--active' %}
          {% endif %}
        </button>
      {% endif %}
    </h3>
  </div>
{% endif %}

<div class="filters-wrapper">
  <form
    id="learning-hub-filter"
    {% if settings.toggle_sidebar %}
      data-sidebar-block__content--collapsible
    {% endif %}
  >
    <!--
      <span class="tag tag--{{ settings.tag_style }} {% if tag_handle == current_tag %} tag--active{% endif %}">
        <a href="{{ shop.url}}/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" title="{{ blog.title }} {{ 'blogs.general.tagged' | t }} {{ tag | escape }}">
          {{ tag }}
        </a>
      </span>
    -->
    <div class="sidebar-block__content tags">
      {% for tag in allowed_tags %}
        {% assign tag_handle = tag | handle %}
        <div class="checkbox-group">
          <input
            type="checkbox"
            id="filter-{{ tag_handle }}"
            name="filters"
            value="{{ tag }}"
            {% if tag_handle == current_tag %}
              checked
            {% endif %}
          >
          <label for="filter-{{ tag_handle }}">{{ tag }}</label>
        </div>
      {% endfor %}
    </div>
  </form>
  <div class="sidebar-divider"></div>
</div>

<script>
  document.querySelectorAll('#learning-hub-filter input[type="checkbox"]').forEach((checkbox) => {
    checkbox.addEventListener('change', function () {
      if (this.checked) {
        const tag = this.value.toLowerCase().replace(/\s+/g, '-');
        window.location.href = `/blogs/{{ blog.handle }}/tagged/${tag}`;
        document.querySelectorAll('#learning-hub-filter input[type="checkbox"]').forEach((cb) => {
          if (cb !== this) cb.checked = false;
        });
      } else {
        window.location.href = `/blogs/{{ blog.handle }}`;
      }
    });
  });
</script>
