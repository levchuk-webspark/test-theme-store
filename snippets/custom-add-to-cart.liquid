
{% style %}

.product-quantity-box.purchase-details__quantity {
    width: calc(25%);
    margin-right: 1px;
}

.quantity-wrapper.quantity-style--box {
    border-radius: 5px 0px 0px 5px !important; 
    overflow:hidden;
}


.quantity-wrapper.quantity-style--box .quantity-minus{
    padding-right:0px;
}


.quantity-minus.button[disabled]{
  background-color:{{ settings.button_cart_bg_color }}; 
   {% if template.name == 'product' and product.metafields.custom.action_color.value %}
        background-color: {{ product.metafields.custom.action_color.value }};
    {% endif %}
}

.quantity-minus.button{
  background-color:{{ settings.button_cart_bg_color }}; 
  {% if template.name == 'product' and product.metafields.custom.action_color.value %}
        background-color: {{ product.metafields.custom.action_color.value }};
    {% endif %}
}

.quantity-minus.button:hover{
  background-color:{{ settings.button_cart_bg_color }}; 
  {% if template.name == 'product' and product.metafields.custom.action_color.value %}
        background-color: {{ product.metafields.custom.action_color.value }};
    {% endif %}
}

.quantity-wrapper.quantity-style--box .quantity-plus{
    padding-left:0px;
}

.quantity-plus.button[disabled]{
  background-color:{{ settings.button_cart_bg_color }}; 
}

.quantity-plus.button{
  background-color:{{ settings.button_cart_bg_color }}; 
 {% if template.name == 'product' and product.metafields.custom.action_color.value %}
        background-color: {{ product.metafields.custom.action_color.value }};
    {% endif %}
}

.quantity-plus.button:hover{
  background-color:{{ settings.button_cart_bg_color }}; 
  {% if template.name == 'product' and product.metafields.custom.action_color.value %}
        background-color: {{ product.metafields.custom.action_color.value }};
    {% endif %}
}

.purchase-details .purchase-details__spb--false {
    height: 55px;
    margin: 0px 0 0;
}

.quantity-wrapper .quantity-element{
    min-height:55px;
    height:55px;
    margin-top:0px;
}

.product-quantity-box.purchase-details__quantity{
    margin-top:0px; 
}

.product-form-container{
    padding-top:0px;
    transform:translateY(-12px);
}

.purchase-details .quantity-input-control input{
    background-color:{{ settings.button_cart_bg_color }}; 
  {% if template.name == 'product' and product.metafields.custom.action_color.value %}
        background-color: {{ product.metafields.custom.action_color.value }};
    {% endif %} 
    border-top:none !important;
    border-bottom:none !important;
    color:{{ settings.button_cart_text_color }};
    padding-left:0px !important;
    padding-right:0px !important;
}

.mobile-purchase-details .quantity-input-control input{
    background-color:{{ settings.button_cart_bg_color }}; 
    border-top:none !important;
    border-bottom:none !important;
    color:{{ settings.button_cart_text_color }};
    padding-left:0px !important;
    padding-right:0px !important;
}

.quantity-wrapper .icon {
    border:1px solid {{ settings.button_cart_text_color }};
    border-radius:50%;
    width:1.3em;
    height:1.3em;
}

.product_form .icon:hover {
  color:{{ settings.button_cart_text_color }} !important;
}

.quantity-plus.button:hover .icon{
    fill:{{ settings.button_cart_text_color }};
}

.quantity-minus.button:hover .icon{
    fill:{{ settings.button_cart_text_color }};
}



@media only screen and (max-width: 798px) {

    .product-quantity-box.purchase-details__quantity {
    min-width: calc(35% - 1px);
    }

    .purchase-details{
        flex-wrap:nowrap;
    }

    .purchase-details .purchase-details__spb--false {
        height: 50px;
    }

    .quantity-wrapper .quantity-element{
        min-height:50px;
        height:50px;
    }

}


{% endstyle %}